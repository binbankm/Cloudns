    "Instances are spun up on-demand at the edge nearest to incoming coordination requests.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instances are spun up on-demand at the edge nearest to incoming coordination requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实例会在最靠近传入协调请求的边缘按需启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實例會在最靠近傳入协調請求的边缘按需啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスタンスは、受信した調整リクエストに最も近いエッジでオンデマンドでスピンアップされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Instanzen werden bei Bedarf an der Edge hochgefahren, die eingehenden Koordinationsanfragen am nächsten liegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instances sont lancées à la demande à la périphérie la plus proche des demandes de coordination entrantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instancias se activan según demanda en el borde más cercano a las solicitudes de coordinación entrantes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인스턴스는 들어오는 조정 요청에 가장 가까운 엣지에서 온디맨드 방식으로 회전됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instâncias são geradas sob demanda na borda mais próxima das solicitações de coordenação recebidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istanze vengono avviate su richiesta all'edge più vicino alle richieste di coordinamento in entrata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экземпляры разворачиваются по требованию на периферии, ближайшей к входящим запросам на координацию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسج المثيلات عند الطلب عند الحافة الأقرب إلى طلبات التنسيق الواردة."
          }
        }
      }
    },
    "Instant one-tap access to DoH Dig, Trace Route, CF Status, and IP Ranges.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant one-tap access to DoH Dig, Trace Route, CF Status, and IP Ranges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键快捷访问 DoH Dig、路由追踪、状态检测与 IP 段查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵快捷访问 DoH Dig、路由追踪、状態檢測与 IP 段查询。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで DoH Dig、トレース ルート、CF ステータス、IP 範囲に瞬時にアクセスできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofortiger Zugriff mit einem Fingertipp auf DoH Dig, Trace Route, CF-Status und IP-Bereiche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès instantané en un seul clic à DoH Dig, Trace Route, CF Status et IP Ranges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso instantáneo con un solo toque a DoH Dig, Trace Route, CF Status y rangos de IP."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DoH Dig, 경로 추적, CF 상태 및 IP 범위에 대한 즉각적인 원탭 액세스가 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso instantâneo com um toque a DoH Dig, Trace Route, CF Status e IP Ranges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso istantaneo con un solo tocco a DoH Dig, Trace Route, CF Status e Intervalli IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенный доступ одним касанием к DoH Dig, Trace Route, статусу CF и диапазонам IP-адресов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول فوري بنقرة واحدة إلى DoH Dig وTrace Route وCF Status وIP Ranges."
          }
        }
      }
    },
    "Instantly toggle Under Attack Mode, orchestrate WAF firewall rules, and fend off DDoS threats.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantly toggle Under Attack Mode, orchestrate WAF firewall rules, and fend off DDoS threats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时开启 5 秒盾攻击防护，编排 WAF 自定义防火墙规则，抵御 DDoS 威胁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時開啟 5 秒盾攻击防護，编排 WAF 自定义防火墙規則，抵御 DDoS 威胁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "攻撃モードに即座に切り替え、WAF ファイアウォール ルールを調整し、DDoS 脅威を防御します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie sofort den Angriffsmodus um, orchestrieren Sie WAF-Firewallregeln und wehren Sie DDoS-Bedrohungen ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculez instantanément en mode sous-attaque, orchestrez les règles de pare-feu WAF et repoussez les menaces DDoS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie instantáneamente al modo de ataque, organice reglas de firewall WAF y defienda las amenazas DDoS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격 모드를 즉시 전환하고, WAF 방화벽 규칙을 조정하고, DDoS 위협을 방어하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne instantaneamente o modo sob ataque, orquestre regras de firewall WAF e evite ameaças DDoS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva istantaneamente la modalità Sotto attacco, orchestra le regole del firewall WAF e respingi le minacce DDoS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно переключайтесь в режим атаки, координируйте правила брандмауэра WAF и защищайтесь от DDoS-угроз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتبديل على الفور ضمن وضع الهجوم، وقم بتنسيق قواعد جدار الحماية WAF، ودرء تهديدات DDoS."
          }
        }
      }
    },
