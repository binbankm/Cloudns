    "Run scheduled Worker tasks automatically using cron syntax (e.g. every 5 minutes, daily).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run scheduled Worker tasks automatically using cron syntax (e.g. every 5 minutes, daily)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Cron 语法自动定期执行 Worker 定时任务（例如每 5 分钟、每天等）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Cron 語法自動定期执行 Worker 定時任务（例如每 5 分钟、每天等）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cron 構文を使用して、スケジュールされた Worker タスクを自動的に実行します (例: 5 分ごと、毎日)。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie geplante Worker-Aufgaben automatisch mithilfe der Cron-Syntax aus (z. B. alle 5 Minuten, täglich)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez automatiquement les tâches de travail planifiées à l'aide de la syntaxe cron (par exemple toutes les 5 minutes, quotidiennement)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecute tareas de trabajador programadas automáticamente usando la sintaxis cron (por ejemplo, cada 5 minutos, diariamente)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cron 구문을 사용하여 예약된 작업자 작업을 자동으로 실행합니다(예: 5분마다, 매일)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute tarefas agendadas do Worker automaticamente usando a sintaxe cron (por exemplo, a cada 5 minutos, diariamente)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui automaticamente le attività di lavoro pianificate utilizzando la sintassi cron (ad esempio ogni 5 minuti, ogni giorno)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматический запуск запланированных задач Worker с использованием синтаксиса cron (например, каждые 5 минут, ежедневно)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل مهام العامل المجدولة تلقائيًا باستخدام بناء جملة cron (على سبيل المثال، كل 5 دقائق، يوميًا)."
          }
        }
      }
    },
    "Run serverless AI inference directly on Cloudflare edge GPUs.": {
