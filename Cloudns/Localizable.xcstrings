    "Zero Trust Access secures self-hosted and SaaS applications with identity-driven policies.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access secures self-hosted and SaaS applications with identity-driven policies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access 通过基于身份的策略保护自建及 SaaS 应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access 通過基于身份的策略保護自建及 SaaS 應用程序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゼロ トラスト アクセスは、アイデンティティ主導のポリシーを使用してセルフホスト型および SaaS アプリケーションを保護します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access sichert selbst gehostete und SaaS-Anwendungen mit identitätsgesteuerten Richtlinien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access sécurise les applications auto-hébergées et SaaS avec des politiques basées sur l'identité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access protege las aplicaciones SaaS y autohospedadas con políticas basadas en identidad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access는 ID 기반 정책을 통해 자체 호스팅 및 SaaS 애플리케이션을 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Zero Trust Access protege aplicativos auto-hospedados e SaaS com políticas orientadas por identidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access protegge le applicazioni self-hosted e SaaS con policy basate sull'identità."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ с нулевым доверием защищает локальные и SaaS-приложения с помощью политик на основе удостоверений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل خدمة Zero Trust Access على تأمين التطبيقات ذاتية الاستضافة وتطبيقات SaaS من خلال سياسات تعتمد على الهوية."
          }
        }
      }
    },
