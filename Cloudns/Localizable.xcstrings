    "Configure build commands and directories executed during automated deployment.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين أوامر البناء والدلائل التي يتم تنفيذها أثناء النشر الآلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie Build-Befehle und Verzeichnisse, die während der automatisierten Bereitstellung ausgeführt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure build commands and directories executed during automated deployment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure los directorios y comandos de compilación ejecutados durante la implementación automatizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les commandes de build et les répertoires exécutés lors du déploiement automatisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura i comandi di build e le directory eseguite durante la distribuzione automatizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動展開中に実行されるビルド コマンドとディレクトリを構成します。"
