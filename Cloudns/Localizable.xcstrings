    "3-63 characters, lowercase letters, numbers, and hyphens only.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3-63 characters, lowercase letters, numbers, and hyphens only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 3-63 个字符，仅支持小写字母、数字和连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 3-63 個字符，仅支持小写字母、數字和连字符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ～ 63 文字、小文字、数字、ハイフンのみ。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3–63 Zeichen, nur Kleinbuchstaben, Zahlen und Bindestriche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 63 caractères, lettres minuscules, chiffres et traits d'union uniquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3 a 63 caracteres, letras minúsculas, números y guiones únicamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3~63자, 소문자, 숫자, 하이픈만 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 63 caracteres, somente letras minúsculas, números e hifens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 3 a 63 caratteri, solo lettere minuscole, numeri e trattini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 3 до 63 символов, только строчные буквы, цифры и дефисы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3-63 حرفًا وأحرفًا صغيرة وأرقامًا وواصلات فقط."
          }
        }
      }
    },
