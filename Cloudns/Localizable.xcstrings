    "Send live HTTP requests directly from your device to test edge routing, response headers, and latency in real time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل طلبات HTTP مباشرة من جهازك لاختبار توجيه الحافة ورؤوس الاستجابة ووقت الاستجابة في الوقت الفعلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie Live-HTTP-Anfragen direkt von Ihrem Gerät, um Edge-Routing, Antwortheader und Latenz in Echtzeit zu testen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send live HTTP requests directly from your device to test edge routing, response headers, and latency in real time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíe solicitudes HTTP en vivo directamente desde su dispositivo para probar el enrutamiento perimetral, los encabezados de respuesta y la latencia en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des requêtes HTTP en direct directement depuis votre appareil pour tester le routage périphérique, les en-têtes de réponse et la latence en temps réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia richieste HTTP in tempo reale direttamente dal tuo dispositivo per testare il routing edge, le intestazioni di risposta e la latenza in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスからライブ HTTP リクエストを直接送信して、エッジ ルーティング、応答ヘッダー、遅延をリアルタイムでテストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장치에서 직접 라이브 HTTP 요청을 보내 에지 라우팅, 응답 헤더 및 대기 시간을 실시간으로 테스트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie solicitações HTTP em tempo real diretamente do seu dispositivo para testar roteamento de borda, cabeçalhos de resposta e latência em tempo real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте живые HTTP-запросы прямо со своего устройства, чтобы проверить пограничную маршрутизацию, заголовки ответов и задержку в режиме реального времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从您的设备直接向边缘节点发送真实 HTTP 请求，实时探测 Worker 路由响应、返回头与毫秒级延迟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
