        }
      }
    },
    "Your domain will show as Pending until Cloudflare detects the nameserver update. This can take a few minutes to 24 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your domain will show as Pending until Cloudflare detects the nameserver update. This can take a few minutes to 24 hours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的域名将显示为待激活状态，直到 Cloudflare 检测到域名服务器更新。此过程可能需要几分钟到 24 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的網域名稱将顯示為待激活状態，直到 Cloudflare 檢測到網域名稱服务器更新。此過程可能需要几分钟到 24 小時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareがネームサーバーの更新を検出するまで、ドメインは保留中と表示されます。これには数分から 24 時間かかる場合があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Domain wird als „Ausstehend“ angezeigt, bis Cloudflare das Nameserver-Update erkennt. Dies kann einige Minuten bis 24 Stunden dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre domaine s'affichera comme En attente jusqu'à ce que Cloudflare détecte la mise à jour du serveur de noms. Cela peut prendre de quelques minutes à 24 heures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su dominio se mostrará como Pendiente hasta que Cloudflare detecte la actualización del servidor de nombres. Esto puede tardar desde unos minutos hasta 24 horas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare가 이름 서버 업데이트를 감지할 때까지 도메인은 보류 중으로 표시됩니다. 이 작업은 몇 분에서 24시간까지 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu domínio aparecerá como Pendente até que a Cloudflare detecte a atualização do servidor de nomes. Isso pode levar de alguns minutos a 24 horas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo dominio verrà visualizzato come In sospeso finché Cloudflare non rileva l'aggiornamento del server dei nomi. L'operazione può richiedere da alcuni minuti a 24 ore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш домен будет отображаться как ожидающий, пока Cloudflare не обнаружит обновление сервера имен. Это может занять от нескольких минут до 24 часов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر نطاقك على أنه \"معلق\" حتى يكتشف Cloudflare تحديث خادم الأسماء. قد يستغرق ذلك بضع دقائق إلى 24 ساعة."
          }
        }
      }
    },
