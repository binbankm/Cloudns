    "Speed up page load times for your visitor's HTTPS traffic by applying Brotli compression.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed up page load times for your visitor's HTTPS traffic by applying Brotli compression."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过应用 Brotli 压缩，加快访客的 HTTPS 流量页面加载时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過應用 Brotli 压缩，加快访客的 HTTPS 流量頁面加載時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli 圧縮を適用することで、訪問者の HTTPS トラフィックのページ読み込み時間を短縮します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschleunigen Sie die Seitenladezeiten für den HTTPS-Verkehr Ihrer Besucher, indem Sie die Brotli-Komprimierung anwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accélérez les temps de chargement des pages pour le trafic HTTPS de vos visiteurs en appliquant la compression Brotli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelere los tiempos de carga de la página para el tráfico HTTPS de sus visitantes aplicando la compresión Brotli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli 압축을 적용하여 방문자의 HTTPS 트래픽에 대한 페이지 로드 시간을 단축하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acelere o tempo de carregamento da página para o tráfego HTTPS do seu visitante aplicando a compactação Brotli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accelera i tempi di caricamento della pagina per il traffico HTTPS dei tuoi visitatori applicando la compressione Brotli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорьте загрузку страницы для HTTPS-трафика вашего посетителя, применив сжатие Brotli."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسريع أوقات تحميل الصفحة لحركة مرور HTTPS الخاصة بزائرك من خلال تطبيق ضغط Brotli."
          }
        }
      }
    },
    "Speed up page load times for your visitor's HTTPS traffic.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed up page load times for your visitor's HTTPS traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为访问者的 HTTPS 流量提升页面加载速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為访问者的 HTTPS 流量提升頁面加載速度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問者の HTTPS トラフィックのページ読み込み時間を短縮します。"
