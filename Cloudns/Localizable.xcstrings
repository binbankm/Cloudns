    "Choose the encryption mode for your website. Full or Strict is recommended if your origin server has an SSL certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر وضع التشفير لموقعك على الويب. يوصى باستخدام الخيار \"كامل\" أو \"متشدد\" إذا كان خادمك الأصلي يحتوي على شهادة SSL."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den Verschlüsselungsmodus für Ihre Website. „Vollständig“ oder „Streng“ wird empfohlen, wenn Ihr Ursprungsserver über ein SSL-Zertifikat verfügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the encryption mode for your website. Full or Strict is recommended if your origin server has an SSL certificate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija el modo de cifrado para su sitio web. Se recomienda Completo o Estricto si su servidor de origen tiene un certificado SSL."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le mode de cryptage de votre site Web. Complet ou Strict est recommandé si votre serveur d'origine dispose d'un certificat SSL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la modalità di crittografia per il tuo sito web. Si consiglia Full o Strict se il server di origine ha un certificato SSL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web サイトの暗号化モードを選択します。オリジンサーバーに SSL 証明書がある場合は、完全または厳密をお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트의 암호화 모드를 선택하세요. 원본 서버에 SSL 인증서가 있는 경우 전체 또는 엄격을 권장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o modo de criptografia do seu site. Completo ou Estrito é recomendado se o seu servidor de origem tiver um certificado SSL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите режим шифрования для вашего сайта. Рекомендуется использовать «Полный» или «Строгий», если ваш исходный сервер имеет сертификат SSL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择您的网站加密模式。如果源服务器有 SSL 证书，推荐使用“完全”或“严格”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選择您的網站加密模式。如果源服务器有 SSL 證书，推荐使用“完全”或“严格”。"
          }
        }
      }
    },
