    "Predictive prefetching via W3C Speculation Rules for instantaneous zero-latency page navigations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلب مسبق تنبؤي عبر قواعد W3C لتنقل فوري بين الصفحات دون أي تأخير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prädiktives Prefetching via W3C Speculation Rules für verzögerungsfreie Seitennavigation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictive prefetching via W3C Speculation Rules for instantaneous zero-latency page navigations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precarga predictiva mediante reglas de especulación W3C para navegaciones sin latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préchargement prédictif via les règles de spéculation W3C pour des navigations sans latence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefetch predittivo tramite W3C Speculation Rules per navigazioni a latenza zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "W3C Speculation Rules による予測プリフェッチで、遅延のないページ遷移を実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "W3C Speculation Rules를 통한 예측 프리페치로 지연 없는 즉각적인 페이지 이동을 구현합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-carregamento preditivo via W3C Speculation Rules para navegação sem latência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упреждающая предварительная загрузка по правилам W3C для мгновенных переходов между страницами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遵循 W3C 规范的预测性推测预取规则，实现零延迟顺畅页面跳转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遵循 W3C 規範的預測性推測預取規則，實現零延遲順暢頁面跳轉。"
          }
        }
      }
    },
