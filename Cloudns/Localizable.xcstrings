    "Traffic arriving at these public hostnames will be routed to your local private services.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic arriving at these public hostnames will be routed to your local private services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达这些公共主机名的流量将被路由到您的本地私有服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到达这些公共主机名的流量将被路由到您的本地私有服务。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのパブリック ホスト名に到着するトラフィックは、ローカルのプライベート サービスにルーティングされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bei diesen öffentlichen Hostnamen ankommende Datenverkehr wird an Ihre lokalen privaten Dienste weitergeleitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic arrivant sur ces noms d’hôtes publics sera acheminé vers vos services privés locaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico que llegue a estos nombres de host públicos se enrutará a sus servicios privados locales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 공개 호스트 이름에 도착하는 트래픽은 로컬 개인 서비스로 라우팅됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego que chega a esses nomes de host públicos será roteado para seus serviços privados locais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traffico che arriva a questi nomi host pubblici verrà instradato ai tuoi servizi privati ​​locali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трафик, поступающий на эти общедоступные имена хостов, будет перенаправляться на ваши локальные частные службы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم توجيه حركة المرور التي تصل إلى أسماء المضيفين العامة هذه إلى الخدمات الخاصة المحلية لديك."
          }
        }
      }
    },
