    "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明文变量可直接查看。机密变量已被加密并脱敏以确保安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明文變量可直接查看。机密變量已被加密并脱敏以確保安全性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキスト変数を直接表示できます。シークレット変数は、セキュリティのために暗号化され、マスクされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klartextvariablen können direkt angezeigt werden. Geheime Variablen werden aus Sicherheitsgründen verschlüsselt und maskiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables en texte brut peuvent être visualisées directement. Les variables secrètes sont cryptées et masquées pour des raisons de sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de texto sin formato se pueden ver directamente. Las variables secretas están cifradas y enmascaradas por seguridad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 텍스트 변수를 직접 볼 수 있습니다. 비밀 변수는 보안을 위해 암호화되고 마스크됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variáveis ​​de texto simples podem ser visualizadas diretamente. Variáveis ​​secretas são criptografadas e mascaradas por segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili di testo in chiaro possono essere visualizzate direttamente. Le variabili segrete sono crittografate e mascherate per motivi di sicurezza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные открытого текста можно просматривать напрямую. Секретные переменные зашифрованы и замаскированы в целях безопасности."
          }
        },
        "ar": {
