    "Instantly toggle Under Attack Mode, orchestrate WAF firewall rules, and fend off DDoS threats." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بالتبديل على الفور ضمن وضع الهجوم، وقم بتنسيق قواعد جدار الحماية WAF، ودرء تهديدات DDoS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie sofort den Angriffsmodus um, orchestrieren Sie WAF-Firewallregeln und wehren Sie DDoS-Bedrohungen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantly toggle Under Attack Mode, orchestrate WAF firewall rules, and fend off DDoS threats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambie instantáneamente al modo de ataque, organice reglas de firewall WAF y defienda las amenazas DDoS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basculez instantanément en mode sous-attaque, orchestrez les règles de pare-feu WAF et repoussez les menaces DDoS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva istantaneamente la modalità Sotto attacco, orchestra le regole del firewall WAF e respingi le minacce DDoS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "攻撃モードに即座に切り替え、WAF ファイアウォール ルールを調整し、DDoS 脅威を防御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공격 모드를 즉시 전환하고, WAF 방화벽 규칙을 조정하고, DDoS 위협을 방어하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne instantaneamente o modo sob ataque, orquestre regras de firewall WAF e evite ameaças DDoS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мгновенно переключайтесь в режим атаки, координируйте правила брандмауэра WAF и защищайтесь от DDoS-угроз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即时开启 5 秒盾攻击防护，编排 WAF 自定义防火墙规则，抵御 DDoS 威胁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時開啟 5 秒盾攻击防護，编排 WAF 自定义防火墙規則，抵御 DDoS 威胁。"
          }
        }
      }
    },
