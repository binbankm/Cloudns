    "Changes the icon displayed on your home screen and in notifications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the icon displayed on your home screen and in notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换显示在您手机主屏幕和系统通知中的 App 图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更换顯示在您手机主屏幕和系統通知中的 App 圖標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面と通知に表示されるアイコンを変更します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert das auf Ihrem Startbildschirm und in Benachrichtigungen angezeigte Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l'icône affichée sur votre écran d'accueil et dans les notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el ícono que se muestra en su pantalla de inicio y en las notificaciones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면과 알림에 표시되는 아이콘을 변경합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o ícone exibido na tela inicial e nas notificações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia l'icona visualizzata nella schermata iniziale e nelle notifiche."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет значок, отображаемый на главном экране и в уведомлениях."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغير الرمز المعروض على شاشتك الرئيسية وفي الإشعارات."
          }
        }
      }
    },
