    "Configure URL forwarding and dynamic 301/302 redirects at the Cloudflare edge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين إعادة توجيه عنوان URL وعمليات إعادة التوجيه الديناميكية 301/302 على حافة Cloudflare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie URL-Weiterleitung und dynamische 301/302-Weiterleitungen am Cloudflare-Edge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure URL forwarding and dynamic 301/302 redirects at the Cloudflare edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure el reenvío de URL y los redireccionamientos dinámicos 301/302 en el borde de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le transfert d'URL et les redirections dynamiques 301/302 à la périphérie de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura l'inoltro URL e i reindirizzamenti dinamici 301/302 sul perimetro Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudflareエッジでURL転送と動的301/302リダイレクトを構成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 에지에서 URL 전달 및 동적 301/302 리디렉션을 구성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o encaminhamento de URL e os redirecionamentos 301/302 dinâmicos na borda da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте переадресацию URL-адресов и динамические перенаправления 301/302 на границе Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cloudflare 边缘节点配置 URL 转发与动态 301/302 重定向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cloudflare 边缘节點設定 URL 轉發与動態 301/302 重定向。"
          }
        }
      }
    },
