    "Modern edge protocols and AI-powered speculation for sub-second page loads.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بروتوكولات حديثة وتنبؤ بالذكاء الاصطناعي لتحميل الصفحات في أجزاء من الثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderne Edge-Protokolle und KI-basierte Spekulation für blitzschnelle Ladezeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern edge protocols and AI-powered speculation for sub-second page loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolos modernos de edge y especulación basada en IA para cargas en submilisegundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocoles edge modernes et spéculation par IA pour des chargements ultra-rapides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolli edge moderni e speculazione basata su IA per caricamenti istantanei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のエッジプロトコルとAI予測により、1秒未満のページ読み込みを実現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 엣지 프로토콜과 AI 기반 예측 프리페치로 초고속 페이지 로딩을 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protocolos modernos de edge e pré-carregamento com IA para carregamentos instantâneos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Современные пограничные протоколы и алгоритмы ИИ для мгновенной загрузки страниц."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于现代边缘网络协议与 AI 智能推测预取技术，打造亚秒级闪电网页加载体验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於現代邊緣網路通訊協定與 AI 智慧推測預取技術，打造亞秒級極速網頁載入體驗。"
          }
        }
      }
    },
