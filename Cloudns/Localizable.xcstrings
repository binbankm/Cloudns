        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화된 배포 중에 실행되는 빌드 명령 및 디렉터리를 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure comandos de build e diretórios executados durante a implantação automatizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте команды сборки и каталоги, выполняемые во время автоматического развертывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置在自动部署期间执行的构建命令与输出目录。"
