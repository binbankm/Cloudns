        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer %1$@ '%2$@' ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea eliminar %1$@ '%2$@'?"
          }
