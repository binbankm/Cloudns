    "Effortlessly manage your Cloudflare zones, DNS records, and settings from anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effortlessly manage your Cloudflare zones, DNS records, and settings from anywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时随地轻松管理您的 Cloudflare 域名、DNS 记录和设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "随時随地轻松管理您的 Cloudflare 網域名稱、DNS 记录和設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare ゾーン、DNS レコード、設定をどこからでも簡単に管理できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie Ihre Cloudflare-Zonen, DNS-Einträge und Einstellungen mühelos von überall aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez sans effort vos zones Cloudflare, vos enregistrements DNS et vos paramètres depuis n'importe où."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Administre sin esfuerzo sus zonas, registros DNS y configuraciones de Cloudflare desde cualquier lugar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 영역, DNS 레코드, 설정을 어디서나 손쉽게 관리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie facilmente suas zonas, registros DNS e configurações da Cloudflare de qualquer lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci facilmente le tue zone Cloudflare, i record DNS e le impostazioni da qualsiasi luogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко управляйте своими зонами Cloudflare, записями DNS и настройками из любого места."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإدارة مناطق Cloudflare وسجلات DNS والإعدادات بسهولة من أي مكان."
          }
        }
      }
    },
