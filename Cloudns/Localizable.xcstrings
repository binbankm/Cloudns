    "Diagnostics info helps developers identify and resolve technical issues faster.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد معلومات التشخيص المطورين على تحديد المشكلات الفنية وحلها بشكل أسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseinformationen helfen Entwicklern, technische Probleme schneller zu erkennen und zu lösen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics info helps developers identify and resolve technical issues faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de diagnóstico ayuda a los desarrolladores a identificar y resolver problemas técnicos más rápidamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de diagnostic aident les développeurs à identifier et à résoudre les problèmes techniques plus rapidement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni di diagnostica aiutano gli sviluppatori a identificare e risolvere i problemi tecnici più rapidamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報は、開発者が技術的な問題をより迅速に特定して解決するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 정보는 개발자가 기술 문제를 더 빠르게 식별하고 해결하는 데 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de diagnóstico ajudam os desenvolvedores a identificar e resolver problemas técnicos com mais rapidez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация диагностики помогает разработчикам быстрее выявлять и устранять технические проблемы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息有助于开发者更快定位并排查技术故障与异常问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息有助于開發者更快定位并排查技术故障与异常问题。"
          }
        }
      }
    },
