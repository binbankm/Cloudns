        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish ottimizza le immagini al volo, riducendo il payload per i dispositivi mobili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish は画像をリアルタイムで最適化し、モバイル端末のデータ量を削減します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish는 이미지를 실시간으로 최적화하여 모바일 사용자의 데이터 부담을 줄여줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cloudflare Polish otimiza imagens dinamicamente, reduzindo o tráfego para dispositivos móveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish мгновенно оптимизирует изображения, уменьшая вес страниц для мобильных пользователей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish 实时无缝优化图片，显著降低移动端流量负载与加速加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Polish 即時無縫最佳化圖片，顯著降低行動端流量負載並加速載入。"
          }
        }
      }
    },
