    "Cloudflare sends a verification link to newly added destination inboxes before emails can be routed to them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل Cloudflare رابط التحقق إلى صناديق البريد الوارد للوجهة المضافة حديثًا قبل أن يتم توجيه رسائل البريد الإلكتروني إليهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare sendet einen Bestätigungslink an neu hinzugefügte Zielposteingänge, bevor E-Mails an diese weitergeleitet werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare sends a verification link to newly added destination inboxes before emails can be routed to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare envía un enlace de verificación a las bandejas de entrada de destino recién agregadas antes de que se puedan enrutar los correos electrónicos a ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare envoie un lien de vérification aux boîtes de réception de destination nouvellement ajoutées avant que les e-mails puissent y être acheminés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare invia un collegamento di verifica alle caselle di posta di destinazione appena aggiunte prima che le e-mail possano essere indirizzate ad esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflareは、電子メールがルーティングされる前に、新しく追加された宛先の受信箱に検証リンクを送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare는 이메일이 라우팅되기 전에 새로 추가된 대상 받은 편지함에 확인 링크를 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cloudflare envia um link de verificação para caixas de entrada de destino recém-adicionadas antes que os e-mails possam ser roteados para elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare отправляет ссылку для подтверждения во вновь добавленные целевые почтовые ящики, прежде чем в них можно будет перенаправить электронные письма."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare 会向新添加的目标邮箱发送验证链接，需确认激活后方可路由邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare 會向新新增的目標邮箱發送驗證链接，需確認激活後方可路由邮件。"
          }
        }
      }
    },
