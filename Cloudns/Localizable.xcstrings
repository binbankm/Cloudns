    "Update the nameservers at your domain registrar to the ones assigned above." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتحديث خوادم الأسماء لدى مسجل النطاق الخاص بك إلى تلك المخصصة أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisieren Sie die Nameserver bei Ihrem Domain-Registrar auf die oben zugewiesenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update the nameservers at your domain registrar to the ones assigned above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualice los servidores de nombres en su registrador de dominio a los asignados anteriormente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour les serveurs de noms de votre registraire de domaine avec ceux attribués ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna i nameserver del tuo registrar di domini con quelli assegnati sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドメイン レジストラのネームサーバーを上記で割り当てられたネームサーバーに更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도메인 등록 기관의 이름 서버를 위에 할당된 이름 서버로 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize os servidores de nomes no seu registrador de domínio para os atribuídos acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите серверы имен у вашего регистратора доменов до назначенных выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在您的域名注册商处将名称服务器更新为上方分配的地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在您的網域名稱注册商處将名称服务器更新為上方分配的地址。"
          }
        }
      }
    },
    "Update your nameservers at your domain registrar to activate Cloudflare protection." : {
      "extractionState" : "manual",
