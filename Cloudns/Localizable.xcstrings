    "Queries global IANA RDAP directory over encrypted HTTPS (no account needed).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries global IANA RDAP directory over encrypted HTTPS (no account needed)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过加密 HTTPS 查询全球 IANA RDAP 注册机构目录（无需登录账号）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過加密 HTTPS 查询全球 IANA RDAP 注册机构目录（無需登入账號）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された HTTPS 経由でグローバル IANA RDAP ディレクトリをクエリします (アカウントは必要ありません)。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt das globale IANA-RDAP-Verzeichnis über verschlüsseltes HTTPS ab (kein Konto erforderlich)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge le répertoire IANA RDAP global via HTTPS crypté (aucun compte requis)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el directorio global IANA RDAP a través de HTTPS cifrado (no se necesita cuenta)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 HTTPS를 통해 글로벌 IANA RDAP 디렉터리를 쿼리합니다(계정이 필요하지 않음)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta o diretório RDAP global da IANA por meio de HTTPS criptografado (não é necessária uma conta)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
