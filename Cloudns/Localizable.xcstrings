    "Monitor Workers, Pages builds, and KV/D1 databases with live execution metrics and latency tracing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor Workers, Pages builds, and KV/D1 databases with live execution metrics and latency tracing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全方位监控 Workers 与 Pages 部署，透视 KV / D1 数据库执行耗时与时序指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全方位监控 Workers 与 Pages 部署，透视 KV / D1 數据库执行耗時与時序指標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ実行メトリクスとレイテンシ トレースを使用して、ワーカー、ページ ビルド、KV/D1 データベースを監視します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwachen Sie Worker, Pages-Builds und KV/D1-Datenbanken mit Live-Ausführungsmetriken und Latenzverfolgung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez les Workers, les builds Pages et les bases de données KV/D1 avec des mesures d'exécution en direct et un suivi de latence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervise trabajadores, compilaciones de páginas y bases de datos KV/D1 con métricas de ejecución en vivo y seguimiento de latencia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 실행 지표 및 대기 시간 추적을 통해 작업자, 페이지 빌드 및 KV/D1 데이터베이스를 모니터링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore Workers, compilações de páginas e bancos de dados KV/D1 com métricas de execução em tempo real e rastreamento de latência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora i Worker, le build di Pages e i database KV/D1 con metriche di esecuzione in tempo reale e tracciamento della latenza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте рабочие процессы, сборки страниц и базы данных KV/D1 с помощью показателей выполнения в реальном времени и отслеживания задержек."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقبة العمال وتصميمات الصفحات وقواعد بيانات KV/D1 باستخدام مقاييس التنفيذ المباشر وتتبع زمن الاستجابة."
          }
        }
      }
    },
    "Monitor your Cloudflare zone traffic, requests, and security status in real-time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor your Cloudflare zone traffic, requests, and security status in real-time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时掌握 Cloudflare 域名流量、请求量及安全防御态势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實時掌握 Cloudflare 網域名稱流量、請求量及安全性防御態势。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareゾーンのトラフィック、リクエスト、セキュリティステータスをリアルタイムで監視します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwachen Sie den Datenverkehr, die Anfragen und den Sicherheitsstatus Ihrer Cloudflare-Zone in Echtzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez le trafic, les requêtes et l'état de sécurité de votre zone Cloudflare en temps réel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervise el tráfico, las solicitudes y el estado de seguridad de su zona de Cloudflare en tiempo real."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 영역 트래픽, 요청, 보안 상태를 실시간으로 모니터링하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore o tráfego, as solicitações e o status de segurança da sua zona Cloudflare em tempo real."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora il traffico, le richieste e lo stato della sicurezza della tua zona Cloudflare in tempo reale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролируйте трафик, запросы и статус безопасности зоны Cloudflare в режиме реального времени."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راقب حركة المرور والطلبات وحالة الأمان في منطقة Cloudflare في الوقت الفعلي."
          }
        }
      }
    },
