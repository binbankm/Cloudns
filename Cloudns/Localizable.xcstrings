    "All traffic matching this rule will have its URI path rewritten to the specified static path before reaching your origin server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إعادة كتابة مسار URI لكل حركة المرور المطابقة لهذه القاعدة إلى المسار الثابت المحدد قبل الوصول إلى الخادم الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der URI-Pfad des gesamten Datenverkehrs, der dieser Regel entspricht, wird in den angegebenen statischen Pfad umgeschrieben, bevor er Ihren Ursprungsserver erreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All traffic matching this rule will have its URI path rewritten to the specified static path before reaching your origin server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el tráfico que coincida con esta regla tendrá su ruta URI reescrita en la ruta estática especificada antes de llegar a su servidor de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le trafic correspondant à cette règle verra son chemin URI réécrit vers le chemin statique spécifié avant d'atteindre votre serveur d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il traffico che corrisponde a questa regola avrà il percorso URI riscritto nel percorso statico specificato prima di raggiungere il server di origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールに一致するすべてのトラフィックは、オリジン サーバーに到達する前に、その URI パスが指定された静的パスに書き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙과 일치하는 모든 트래픽은 원본 서버에 도달하기 전에 지정된 정적 경로로 URI 경로를 다시 작성합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o tráfego que corresponda a esta regra terá seu caminho URI reescrito no caminho estático especificado antes de chegar ao servidor de origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь URI всего трафика, соответствующего этому правилу, будет перезаписан на указанный статический путь, прежде чем он достигнет исходного сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有匹配此规则的流量，其 URI 路径将在到达源服务器之前被重写为指定的静态路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有匹配此規則的流量，其 URI 路径将在到达源服务器之前被重写為指定的静態路径。"
