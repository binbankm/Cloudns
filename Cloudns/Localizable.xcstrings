          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segreti vengono crittografati quando sono inattivi e mascherati nelle risposte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットは保存時に暗号化され、応答ではマスクされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 비밀은 저장 시 암호화되고 응답 시에는 마스킹됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os segredos são criptografados em repouso e mascarados nas respostas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секреты шифруются в состоянии покоя и маскируются в ответах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密在静态存储时加密，并在响应中自动脱敏掩码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密在静態儲存時加密，并在响應中自動脱敏掩碼。"
          }
        }
      }
    },
    "Secrets are encrypted at rest and never exposed in cleartext." : {
      "localizations" : {
