    "Evaluate HTTP headers from your visitors browser for threats.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate HTTP headers from your visitors browser for threats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评估访客浏览器的 HTTP 标头是否存在威胁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "评估访客浏覽器的 HTTP 標頭是否存在威胁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問者のブラウザからの HTTP ヘッダーの脅威を評価します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die HTTP-Header des Browsers Ihrer Besucher auf Bedrohungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluez les en-têtes HTTP du navigateur de vos visiteurs pour détecter les menaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evalúe los encabezados HTTP del navegador de sus visitantes en busca de amenazas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문자 브라우저의 HTTP 헤더에 위협이 있는지 평가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalie os cabeçalhos HTTP do navegador do visitante em busca de ameaças."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta le intestazioni HTTP dal browser dei tuoi visitatori per individuare eventuali minacce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцените HTTP-заголовки браузера посетителей на наличие угроз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتقييم رؤوس HTTP من متصفح الزوار الخاص بك بحثًا عن التهديدات."
          }
        }
      }
    },
