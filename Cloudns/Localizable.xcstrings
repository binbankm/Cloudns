          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите свой сайт от DDoS и брутфорс-атак."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护您的站点免受 DDoS 和暴力破解攻击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護您的站點免受 DDoS 和暴力破解攻击。"
          }
        }
      }
    },
