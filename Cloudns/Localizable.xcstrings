        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "访客成功完成驗證後允许访问的時間长度。"
          }
        }
      }
    },
    "How long resources are cached in visitor browsers.": {
      "extractionState": "manual",
      "localizations": {
