    "Secrets are encrypted and exposed as environment variables to your Worker script at runtime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets are encrypted and exposed as environment variables to your Worker script at runtime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥在保存后将被高强度加密，仅在脚本运行时作为环境变量注入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥在儲存後将被高强度加密，仅在脚本运行時作為环境變量注入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットは暗号化され、実行時に環境変数としてワーカー スクリプトに公開されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse werden verschlüsselt und zur Laufzeit als Umgebungsvariablen für Ihr Worker-Skript verfügbar gemacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets sont chiffrés et exposés en tant que variables d'environnement à votre script Worker au moment de l'exécution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos se cifran y se exponen como variables de entorno en su script de trabajo en tiempo de ejecución."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀은 암호화되어 런타임 시 작업자 스크립트에 환경 변수로 노출됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segredos são criptografados e expostos como variáveis ​​de ambiente ao seu script Worker em tempo de execução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti vengono crittografati ed esposti come variabili di ambiente nello script Worker in fase di runtime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секреты шифруются и предоставляются как переменные среды вашему рабочему сценарию во время выполнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير الأسرار وعرضها كمتغيرات بيئة للبرنامج النصي العامل الخاص بك في وقت التشغيل."
          }
        }
      }
    },
    "Secrets are encrypted at rest and masked in responses.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets are encrypted at rest and masked in responses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在静态存储时加密，并在响应中自动脱敏掩码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在静態儲存時加密，并在响應中自動脱敏掩碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットは保存時に暗号化され、応答ではマスクされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse werden im Ruhezustand verschlüsselt und in Antworten maskiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets sont chiffrés au repos et masqués dans les réponses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos se cifran en reposo y se enmascaran en las respuestas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 비밀은 저장 시 암호화되고 응답 시에는 마스킹됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segredos são criptografados em repouso e mascarados nas respostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti vengono crittografati quando sono inattivi e mascherati nelle risposte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секреты шифруются в состоянии покоя и маскируются в ответах."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير الأسرار أثناء الراحة وإخفائها في الردود."
          }
        }
      }
    },
    "Secrets are encrypted upon saving and cannot be retrieved or read back by the API.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets are encrypted upon saving and cannot be retrieved or read back by the API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在保存后即被加密，无法通过 API 检索或回读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在儲存後即被加密，無法通過 API 檢索或回讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットは保存時に暗号化され、API によって取得または読み戻すことはできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse werden beim Speichern verschlüsselt und können von der API nicht abgerufen oder zurückgelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets sont cryptés lors de l'enregistrement et ne peuvent pas être récupérés ou relus par l'API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos se cifran al guardarlos y la API no los puede recuperar ni leer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀은 저장 시 암호화되며 API로 검색하거나 다시 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segredos são criptografados ao serem salvos e não podem ser recuperados ou lidos pela API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti vengono crittografati al momento del salvataggio e non possono essere recuperati o riletti dall'API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секреты шифруются при сохранении и не могут быть получены или прочитаны API."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير الأسرار عند الحفظ ولا يمكن استرجاعها أو قراءتها مرة أخرى بواسطة واجهة برمجة التطبيقات."
          }
        }
      }
    },
    "Secrets cannot be viewed after saving. Use for API keys, tokens and passwords.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets cannot be viewed after saving. Use for API keys, tokens and passwords."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在保存后不可查看。适用于 API 密钥、令牌和密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "机密在儲存後不可查看。适用于 API 密钥、令牌和密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットは保存後は表示できません。 API キー、トークン、パスワードに使用します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse können nach dem Speichern nicht mehr angezeigt werden. Verwendung für API-Schlüssel, Token und Passwörter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets ne peuvent pas être consultés après l'enregistrement. À utiliser pour les clés API, les jetons et les mots de passe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos no se pueden ver después de guardarlos. Úselo para claves API, tokens y contraseñas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 후에는 비밀을 볼 수 없습니다. API 키, 토큰 및 비밀번호에 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segredos não podem ser visualizados após serem salvos. Use para chaves de API, tokens e senhas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti non possono essere visualizzati dopo il salvataggio. Utilizzare per chiavi API, token e password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секреты нельзя просмотреть после сохранения. Используйте для ключей API, токенов и паролей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الاطلاع على الأسرار بعد الحفظ. يُستخدم لمفاتيح API والرموز المميزة وكلمات المرور."
          }
        }
      }
    },
