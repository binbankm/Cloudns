    "Connect your Cloudflare API to manage edge fleets.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوصيل Cloudflare API الخاص بك لإدارة أساطيل الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihre Cloudflare-API, um Edge-Flotten zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Cloudflare API to manage edge fleets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte su API de Cloudflare para administrar flotas de borde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre API Cloudflare pour gérer les flottes périphériques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti la tua API Cloudflare per gestire flotte edge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare APIを接続してエッジフリートを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare API를 연결하여 에지 플릿을 관리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte sua API Cloudflare para gerenciar frotas de borda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите API Cloudflare для управления периферийными парками устройств."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接您的 Cloudflare API，全面掌控边缘网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "连接您的 Cloudflare API，全面掌控边缘網路。"
          }
        }
      }
    },
    "Connect your own apex domain or subdomain to serve this Pages project.": {
      "extractionState": "manual",
