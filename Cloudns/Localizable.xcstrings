    "Your API credentials stay isolated on your device with Apple Keychain hardware-level protection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API credentials stay isolated on your device with Apple Keychain hardware-level protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 API 凭证安全隔离在您的设备本地，由 Apple Keychain 硬件级加密保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
