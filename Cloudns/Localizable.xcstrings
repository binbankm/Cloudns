          }
        }
      }
    },
    "Protect your content from scrapers, hotlinkers, and email harvesters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your content from scrapers, hotlinkers, and email harvesters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护您的内容免受网络抓取、盗链和电子邮件采集器的侵害。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護您的内容免受網路抓取、盗链和电子邮件采集器的侵害。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクレイパー、ホットリンカー、電子メールハーベスターからコンテンツを保護します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie Ihre Inhalte vor Scrapern, Hotlinkern und E-Mail-Harvestern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez votre contenu contre les scrapers, les hotlinkers et les collecteurs d'e-mails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja su contenido de scrapers, hotlinkers y recolectores de correo electrónico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크레이퍼, 핫링커, 이메일 수집기로부터 콘텐츠를 보호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja seu conteúdo contra scrapers, hotlinkers e coletores de e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi i tuoi contenuti da scraper, hotlinker e raccoglitori di email."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите свой контент от скраперов, хотлинкеров и сборщиков электронной почты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بحماية المحتوى الخاص بك من أدوات استخراج البيانات والروابط الساخنة وجامعي البريد الإلكتروني."
          }
        }
      }
    },
    "Protect your domain from DNS spoofing and cache poisoning by enabling DNSSEC and adding the DS record to your domain registrar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your domain from DNS spoofing and cache poisoning by enabling DNSSEC and adding the DS record to your domain registrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 DNSSEC 并将 DS 记录添加到域名注册商，以保护您的域名免受 DNS 欺骗和缓存污染攻击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用 DNSSEC 并将 DS 记录新增到網域名稱注册商，以保護您的網域名稱免受 DNS 欺骗和快取污染攻击。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSSEC を有効にし、DS レコードをドメイン レジストラーに追加することで、DNS スプーフィングやキャッシュ ポイズニングからドメインを保護します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie Ihre Domain vor DNS-Spoofing und Cache-Poisoning, indem Sie DNSSEC aktivieren und den DS-Eintrag zu Ihrem Domain-Registrar hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez votre domaine contre l'usurpation d'identité DNS et l'empoisonnement du cache en activant DNSSEC et en ajoutant l'enregistrement DS à votre registraire de domaine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja su dominio contra la suplantación de DNS y el envenenamiento de la caché habilitando DNSSEC y agregando el registro DS a su registrador de dominio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNSSEC를 활성화하고 도메인 등록 기관에 DS 레코드를 추가하여 DNS 스푸핑 및 캐시 중독으로부터 도메인을 보호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja seu domínio contra falsificação de DNS e envenenamento de cache ativando o DNSSEC e adicionando o registro DS ao seu registrador de domínio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi il tuo dominio dallo spoofing DNS e dall'avvelenamento della cache abilitando DNSSEC e aggiungendo il record DS al registrar del tuo dominio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите свой домен от подмены DNS и отравления кэша, включив DNSSEC и добавив запись DS в регистратор домена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بحماية المجال الخاص بك من انتحال DNS وتسميم ذاكرة التخزين المؤقت عن طريق تمكين DNSSEC وإضافة سجل DS إلى مسجل النطاق الخاص بك."
          }
        }
      }
    },
    "Protect your domain from DNS spoofing and cache poisoning.": {
      "extractionState": "manual",
      "localizations": {
