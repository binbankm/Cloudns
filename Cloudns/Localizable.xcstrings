          }
        }
      }
    },
    "Secrets cannot be viewed after saving. Use for API keys, tokens and passwords." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الاطلاع على الأسرار بعد الحفظ. يُستخدم لمفاتيح API والرموز المميزة وكلمات المرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse können nach dem Speichern nicht mehr angezeigt werden. Verwendung für API-Schlüssel, Token und Passwörter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets cannot be viewed after saving. Use for API keys, tokens and passwords."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los secretos no se pueden ver después de guardarlos. Úselo para claves API, tokens y contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les secrets ne peuvent pas être consultés après l'enregistrement. À utiliser pour les clés API, les jetons et les mots de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segreti non possono essere visualizzati dopo il salvataggio. Utilizzare per chiavi API, token e password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットは保存後は表示できません。 API キー、トークン、パスワードに使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 후에는 비밀을 볼 수 없습니다. API 키, 토큰 및 비밀번호에 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os segredos não podem ser visualizados após serem salvos. Use para chaves de API, tokens e senhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
