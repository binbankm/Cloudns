    "Distribute incoming traffic across server pools for high availability.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribute incoming traffic across server pools for high availability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨服务器池分发传入流量以实现高可用性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨服务器池分發傳入流量以實現高可用性。"
          }
