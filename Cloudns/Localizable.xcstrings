    "Requests matching this wirefilter expression will execute the selected snippet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلبات المطابقة لتعبير Wirefilter هذا ستنفذ المقتطف المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen, die diesem Wirefilter-Ausdruck entsprechen, führen das ausgewählte Snippet aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests matching this wirefilter expression will execute the selected snippet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes que coincidan con esta expresión de filtro de alambre ejecutarán el fragmento seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes correspondant à cette expression wirefilter exécuteront l’extrait sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste che corrispondono a questa espressione wirefilter eseguiranno lo snippet selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワイヤーフィルター式に一致するリクエストは、選択されたスニペットを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 wirefilter 표현식과 일치하는 요청은 선택한 조각을 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações que correspondem a esta expressão wirefilter executarão o snippet selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы, соответствующие этому выражению Wirefilter, будут выполнять выбранный фрагмент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配此过滤表达式的请求将执行所选 Snippet。"
