            "value": "Proteja su sitio de ataques DDoS y de fuerza bruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez votre site contre les attaques DDoS et par force brute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi il tuo sito da DDoS e attacchi di forza bruta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DDoS 攻撃やブルート フォース攻撃からサイトを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DDoS 및 무차별 대입 공격으로부터 사이트를 보호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
