    "Your API credentials stay isolated on your device with Apple Keychain hardware-level protection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظل بيانات اعتماد API الخاصة بك معزولة على جهازك بفضل الحماية على مستوى الأجهزة من Apple Keychain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre API-Anmeldeinformationen bleiben durch den Schutz auf Hardwareebene des Apple-Schlüsselbunds auf Ihrem Gerät isoliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your API credentials stay isolated on your device with Apple Keychain hardware-level protection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus credenciales de API permanecen aisladas en su dispositivo con la protección a nivel de hardware de Apple Keychain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos informations d'identification API restent isolées sur votre appareil grâce à la protection matérielle du trousseau Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue credenziali API rimangono isolate sul tuo dispositivo grazie alla protezione a livello hardware del portachiavi Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 認証情報は、Apple Keychain のハードウェア レベルの保護によりデバイス上で隔離された状態に保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 API 자격 증명은 Apple Keychain 하드웨어 수준 보호를 통해 기기에서 격리된 상태로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas credenciais de API permanecem isoladas em seu dispositivo com a proteção em nível de hardware do Apple Keychain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши учетные данные API остаются изолированными на вашем устройстве благодаря аппаратной защите Apple Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 API 凭证安全隔离在您的设备本地，由 Apple Keychain 硬件级加密保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
