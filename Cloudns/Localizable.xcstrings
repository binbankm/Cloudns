        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵清除快取，啟用開發模式，并优化您的網站性能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップするだけでキャッシュを即座に削除し、開発モードを有効にし、サイトのパフォーマンスを最適化します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie den Cache sofort, aktivieren Sie den Entwicklungsmodus und optimieren Sie die Leistung Ihrer Website mit einem Fingertipp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgez le cache instantanément, activez le mode développement et optimisez les performances de votre site d'un simple toucher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgue el caché al instante, habilite el modo de desarrollo y optimice el rendimiento de su sitio con un toque."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시를 즉시 제거하고, 개발 모드를 활성화하고, 탭 한 번으로 사이트 성능을 최적화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe o cache instantaneamente, ative o modo de desenvolvimento e otimize o desempenho do seu site com um toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota istantaneamente la cache, abilita la modalità sviluppatore e ottimizza le prestazioni del tuo sito con un tocco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно очистите кеш, включите режим разработки и оптимизируйте производительность вашего сайта одним касанием."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإزالة ذاكرة التخزين المؤقت على الفور، وقم بتمكين وضع التطوير، وقم بتحسين أداء موقعك بنقرة واحدة."
          }
        }
      }
    },
    "Purge everything from Cloudflare's cache. This will force Cloudflare to fetch a fresh version of your site from your origin server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purge everything from Cloudflare's cache. This will force Cloudflare to fetch a fresh version of your site from your origin server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 Cloudflare 缓存中的所有内容。这将强制 Cloudflare 从源服务器获取您网站的最新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 Cloudflare 快取中的所有内容。这将强制 Cloudflare 從源服务器获取您網站的最新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareのキャッシュからすべてを削除します。これにより、Cloudflareはオリジンサーバーからサイトの新しいバージョンを強制的に取得します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie alles aus dem Cloudflare-Cache. Dadurch wird Cloudflare gezwungen, eine neue Version Ihrer Website von Ihrem Ursprungsserver abzurufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videz tout du cache de Cloudflare. Cela forcera Cloudflare à récupérer une nouvelle version de votre site à partir de votre serveur d'origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purga todo del caché de Cloudflare. Esto obligará a Cloudflare a buscar una versión nueva de su sitio desde su servidor de origen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 캐시에서 모든 것을 제거하세요. 이렇게 하면 Cloudflare가 원본 서버에서 사이트의 새로운 버전을 가져오게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe tudo do cache do Cloudflare. Isso forçará a Cloudflare a buscar uma nova versão do seu site no servidor de origem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutto dalla cache di Cloudflare. Ciò costringerà Cloudflare a recuperare una nuova versione del tuo sito dal tuo server di origine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите все из кеша Cloudflare. Это заставит Cloudflare получить свежую версию вашего сайта с исходного сервера."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمسح كل شيء من ذاكرة التخزين المؤقت لـ Cloudflare. سيؤدي هذا إلى إجبار Cloudflare على جلب نسخة جديدة من موقعك من خادمك الأصلي."
          }
        }
      }
    },
