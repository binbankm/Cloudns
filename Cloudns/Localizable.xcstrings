    "Route Tor users through the Cloudflare Onion service to improve privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route Tor users through the Cloudflare Onion service to improve privacy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Cloudflare Onion 服务路由 Tor 用户以提高隐私性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過 Cloudflare Onion 服务路由 Tor 用户以提高隱私性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーを向上させるために、Tor ユーザーを Cloudflare Onion サービス経由でルーティングします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiten Sie Tor-Benutzer über den Cloudflare Onion-Dienst weiter, um den Datenschutz zu verbessern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheminez les utilisateurs de Tor via le service Cloudflare Onion pour améliorer la confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirija a los usuarios de Tor a través del servicio Cloudflare Onion para mejorar la privacidad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 정보 보호를 강화하려면 Cloudflare Onion 서비스를 통해 Tor 사용자를 라우팅하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhe os usuários do Tor por meio do serviço Cloudflare Onion para melhorar a privacidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrada gli utenti Tor attraverso il servizio Cloudflare Onion per migliorare la privacy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направьте пользователей Tor через сервис Cloudflare Onion, чтобы повысить конфиденциальность."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوجيه مستخدمي Tor من خلال خدمة Cloudflare Onion لتحسين الخصوصية."
          }
        }
      }
    },
    "Route requests through this endpoint to get caching, rate limiting, and analytics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Route requests through this endpoint to get caching, rate limiting, and analytics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过此端点路由请求以获取缓存、速率限制和分析功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過此端點路由請求以获取快取、速率限制和分析功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンドポイント経由でリクエストをルーティングして、キャッシュ、レート制限、および分析を取得します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiten Sie Anfragen über diesen Endpunkt weiter, um Caching, Ratenbegrenzung und Analysen zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheminez les requêtes via ce point de terminaison pour obtenir la mise en cache, la limitation du débit et les analyses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrute solicitudes a través de este punto final para obtener almacenamiento en caché, limitación de velocidad y análisis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔드포인트를 통해 요청을 라우팅하여 캐싱, 속도 제한 및 분석을 수행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhe solicitações por meio desse endpoint para obter armazenamento em cache, limitação de taxa e análises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrada le richieste attraverso questo endpoint per ottenere memorizzazione nella cache, limitazione della velocità e analisi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направляйте запросы через эту конечную точку, чтобы получить кэширование, ограничение скорости и аналитику."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوجيه الطلبات عبر نقطة النهاية هذه للحصول على التخزين المؤقت وتحديد المعدل والتحليلات."
          }
        }
      }
    },
