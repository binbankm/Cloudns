    "Values are encrypted upon saving and cannot be retrieved or read back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are encrypted upon saving and cannot be retrieved or read back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥内容保存后即被加密保护，无法在控制台回显查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥内容儲存後即被加密保護，無法在控制台回顯查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値は保存時に暗号化され、取得したり読み戻したりすることはできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte werden beim Speichern verschlüsselt und können nicht abgerufen oder zurückgelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont cryptées lors de l'enregistrement et ne peuvent pas être récupérées ou relues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores se cifran al guardarlos y no se pueden recuperar ni volver a leer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 저장 시 암호화되며 검색하거나 다시 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores são criptografados ao serem salvos e não podem ser recuperados ou lidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori vengono crittografati al momento del salvataggio e non possono essere recuperati o riletti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения шифруются при сохранении и не могут быть извлечены или прочитаны обратно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير القيم عند الحفظ ولا يمكن استرجاعها أو قراءتها مرة أخرى."
          }
        }
      }
    },
    "Values are sanitized and escaped before database update.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are sanitized and escaped before database update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在更新数据库前，值会经过清理与转义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在更新數据库前，值會经過清理与轉义。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はデータベースが更新される前にサニタイズされ、エスケープされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte werden vor der Datenbankaktualisierung bereinigt und maskiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont nettoyées et échappées avant la mise à jour de la base de données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores se desinfectan y se escapan antes de la actualización de la base de datos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 업데이트 전에 값이 삭제되고 이스케이프됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores são limpos e escapados antes da atualização do banco de dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori vengono ripuliti e sottoposti a escape prima dell'aggiornamento del database."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения очищаются и экранируются перед обновлением базы данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تطهير القيم وإفلاتها قبل تحديث قاعدة البيانات."
          }
        }
      }
    },
