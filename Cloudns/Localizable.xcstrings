    "If your server goes down, Cloudflare will serve your website's static pages from our cache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your server goes down, Cloudflare will serve your website's static pages from our cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的服务器宕机，Cloudflare 将从我们的缓存中提供您网站的静态页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的服务器宕机，Cloudflare 将從我们的快取中提供您網站的静態頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがダウンした場合、CloudflareはキャッシュからWebサイトの静的ページを提供します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Ihr Server ausfällt, stellt Cloudflare die statischen Seiten Ihrer Website aus unserem Cache bereit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre serveur tombe en panne, Cloudflare servira les pages statiques de votre site Web à partir de notre cache."
          }
        },
