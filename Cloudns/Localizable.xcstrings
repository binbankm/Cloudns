    "Protect your content from scrapers, hotlinkers, and email harvesters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بحماية المحتوى الخاص بك من أدوات استخراج البيانات والروابط الساخنة وجامعي البريد الإلكتروني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie Ihre Inhalte vor Scrapern, Hotlinkern und E-Mail-Harvestern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your content from scrapers, hotlinkers, and email harvesters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja su contenido de scrapers, hotlinkers y recolectores de correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez votre contenu contre les scrapers, les hotlinkers et les collecteurs d'e-mails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi i tuoi contenuti da scraper, hotlinker e raccoglitori di email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクレイパー、ホットリンカー、電子メールハーベスターからコンテンツを保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크레이퍼, 핫링커, 이메일 수집기로부터 콘텐츠를 보호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja seu conteúdo contra scrapers, hotlinkers e coletores de e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите свой контент от скраперов, хотлинкеров и сборщиков электронной почты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护您的内容免受网络抓取、盗链和电子邮件采集器的侵害。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護您的内容免受網路抓取、盗链和电子邮件采集器的侵害。"
          }
        }
      }
    },
    "Protect your site from DDoS and brute force attacks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بحماية موقعك من هجمات DDoS وهجمات القوة الغاشمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie Ihre Website vor DDoS- und Brute-Force-Angriffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your site from DDoS and brute force attacks."
          }
        },
