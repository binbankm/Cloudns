        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 %1$@ '%2$@'을(를) 삭제하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir %1$@ '%2$@'?"
