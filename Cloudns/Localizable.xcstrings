    "Allows browsers to access HTTP URIs over an encrypted TLS channel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows browsers to access HTTP URIs over an encrypted TLS channel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许浏览器通过加密的 TLS 通道访问 HTTP URI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允许浏覽器通過加密的 TLS 通道访问 HTTP URI。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザが暗号化された TLS チャネル経由で HTTP URI にアクセスできるようにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Browsern den Zugriff auf HTTP-URIs über einen verschlüsselten TLS-Kanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux navigateurs d'accéder aux URI HTTP via un canal TLS crypté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los navegadores acceder a URI HTTP a través de un canal TLS cifrado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저가 암호화된 TLS 채널을 통해 HTTP URI에 액세스할 수 있도록 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que os navegadores acessem URIs HTTP por meio de um canal TLS criptografado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente ai browser di accedere agli URI HTTP su un canale TLS crittografato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет браузерам получать доступ к URI HTTP по зашифрованному каналу TLS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للمتصفحات بالوصول إلى عناوين URL لـ HTTP عبر قناة TLS مشفرة."
          }
        }
      }
    },
    "Allows public read access to objects in this bucket using a Cloudflare-managed r2.dev subdomain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows public read access to objects in this bucket using a Cloudflare-managed r2.dev subdomain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通过 Cloudflare 托管的 r2.dev 子域名公开读取此存储桶中的对象。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通過 Cloudflare 托管的 r2.dev 子網域名稱公開讀取此儲存桶中的对象。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareが管理するr2.devサブドメインを使用して、このバケット内のオブジェクトへのパブリック読み取りアクセスを許可します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht öffentlichen Lesezugriff auf Objekte in diesem Bucket über eine von Cloudflare verwaltete r2.dev-Subdomäne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'accès public en lecture aux objets de ce compartiment à l'aide d'un sous-domaine r2.dev géré par Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso público de lectura a los objetos de este depósito mediante un subdominio r2.dev administrado por Cloudflare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare가 관리하는 r2.dev 하위 도메인을 사용하여 이 버킷의 개체에 대한 공개 읽기 액세스를 허용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite acesso público de leitura a objetos neste bucket usando um subdomínio r2.dev gerenciado pela Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente l'accesso pubblico in lettura agli oggetti in questo bucket utilizzando un sottodominio r2.dev gestito da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешает публичный доступ для чтения к объектам в этом сегменте с использованием поддомена r2.dev, управляемого Cloudflare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للعامة بالوصول للقراءة إلى الكائنات الموجودة في هذه المجموعة باستخدام نطاق فرعي r2.dev مُدار بواسطة Cloudflare."
          }
        }
      }
    },
