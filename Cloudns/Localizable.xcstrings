    "Detects and challenges known bots and crawlers. Recommended for most sites." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتشف ويتحدى الروبوتات والزواحف المعروفة. يوصى به لمعظم المواقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt und fordert bekannte Bots und Crawler heraus. Empfohlen für die meisten Websites."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detects and challenges known bots and crawlers. Recommended for most sites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta y desafía robots y rastreadores conocidos. Recomendado para la mayoría de los sitios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte et défie les robots et robots d'exploration connus. Recommandé pour la plupart des sites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rileva e sfida bot e crawler conosciuti. Consigliato per la maggior parte dei siti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既知のボットやクローラーを検出し、挑戦します。ほとんどのサイトで推奨されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알려진 봇과 크롤러를 탐지하고 문제를 제기합니다. 대부분의 사이트에 권장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta e desafia bots e rastreadores conhecidos. Recomendado para a maioria dos sites."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаруживает и бросает вызов известным ботам и сканерам. Рекомендуется для большинства сайтов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测并质询已知的机器人和爬虫。推荐大多数网站使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢測并质询已知的机器人和爬虫。推荐大多數網站使用。"
          }
        }
      }
    },
    "Determine how much of your website's static content you want Cloudflare to cache." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد مقدار المحتوى الثابت لموقع الويب الخاص بك الذي تريد من Cloudflare تخزينه مؤقتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmen Sie, wie viel statischen Inhalt Ihrer Website Cloudflare zwischenspeichern soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine how much of your website's static content you want Cloudflare to cache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine qué parte del contenido estático de su sitio web desea que Cloudflare almacene en caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déterminez la quantité de contenu statique de votre site Web que vous souhaitez que Cloudflare mette en cache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determina la quantità di contenuti statici del tuo sito web che desideri che Cloudflare memorizzi nella cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CloudflareがキャッシュするWebサイトの静的コンテンツの量を決定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare가 캐시할 웹사이트의 정적 콘텐츠의 양을 결정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine quanto do conteúdo estático do seu site você deseja que a Cloudflare armazene em cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определите, какую часть статического контента вашего веб-сайта вы хотите кэшировать Cloudflare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定您希望 Cloudflare 缓存多少网站的静态内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認您希望 Cloudflare 快取多少網站的静態内容。"
          }
        }
      }
    },
    "Determine the length of time Cloudflare instructs a visitor's browser to cache files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد طول الفترة الزمنية التي يوجه فيها Cloudflare متصفح الزائر إلى ذاكرة التخزين المؤقت للملفات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmen Sie, wie lange Cloudflare den Browser eines Besuchers anweist, Dateien zwischenzuspeichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine the length of time Cloudflare instructs a visitor's browser to cache files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determine el período de tiempo que Cloudflare le indica al navegador de un visitante que almacene en caché los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déterminez la durée pendant laquelle Cloudflare demande au navigateur d'un visiteur de mettre les fichiers en cache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
