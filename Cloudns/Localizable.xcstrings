    "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم Cloudflare بتوقيع وإصدار شهادات حافة SSL/TLS مجانية لنطاقك ونطاقاتك الفرعية تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signiert und stellt automatisch kostenlose SSL/TLS-Edge-Zertifikate für Ihre Domain und Subdomains aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma y emite certificados perimetrales SSL/TLS gratuitos para su dominio y subdominios automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signe et émet automatiquement des certificats Edge SSL/TLS gratuits pour votre domaine et vos sous-domaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma ed emette automaticamente certificati edge SSL/TLS gratuiti per il tuo dominio e sottodomini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、ドメインとサブドメインの無料のSSL/TLSエッジ証明書に自動的に署名し、発行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 도메인과 하위 도메인에 대한 무료 SSL/TLS 에지 인증서를 자동으로 서명하고 발급합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare assina e emite certificados de borda SSL/TLS gratuitos para seu domínio e subdomínios automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare автоматически подписывает и выдает бесплатные пограничные сертификаты SSL/TLS для вашего домена и поддоменов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自动为您的域名及子域名签署并颁发免费的 SSL/TLS 边缘证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自動為您的網域名稱及子網域名稱签署并颁發免费的 SSL/TLS 边缘證书。"
          }
        }
      }
    },
