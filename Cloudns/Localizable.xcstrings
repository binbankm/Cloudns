          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i nameserver del tuo registrar di domini con quelli assegnati sopra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите серверы имен у вашего регистратора доменов до назначенных выше."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث خوادم الأسماء لدى مسجل النطاق الخاص بك إلى تلك المخصصة أعلاه."
          }
        }
      }
    },
    "Update your nameservers at your domain registrar to activate Cloudflare protection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your nameservers at your domain registrar to activate Cloudflare protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的域名注册商处更新域名服务器，以激活 Cloudflare 防护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的網域名稱注册商處更新網域名稱服务器，以激活 Cloudflare 防護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインレジストラのネームサーバーを更新して、Cloudflare 保護を有効にします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie Ihre Nameserver bei Ihrem Domain-Registrar, um den Cloudflare-Schutz zu aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour vos serveurs de noms auprès de votre registraire de domaine pour activer la protection Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice sus servidores de nombres en el registrador de su dominio para activar la protección de Cloudflare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 보호를 활성화하려면 도메인 등록 기관의 이름 서버를 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize seus servidores de nomes em seu registrador de domínio para ativar a proteção Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i tuoi server dei nomi presso il registrar del tuo dominio per attivare la protezione Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите серверы имен у регистратора домена, чтобы активировать защиту Cloudflare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث خوادم الأسماء الخاصة بك لدى مسجل النطاق الخاص بك لتنشيط حماية Cloudflare."
          }
        }
      }
    },
