    "Protect your Cloudflare account data with Face ID / Touch ID app lock.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your Cloudflare account data with Face ID / Touch ID app lock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID / Touch ID 应用锁保护您的 Cloudflare 账户数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID / Touch ID 應用鎖保護您的 Cloudflare 帳號數据。"
          }
        },
        "ja": {
          "stringUnit": {
