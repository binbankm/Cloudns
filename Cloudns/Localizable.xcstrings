    "Queue names must contain only lowercase alphanumeric characters and hyphens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue names must contain only lowercase alphanumeric characters and hyphens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列名称只能包含小写字母、数字和连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "队列名称只能包含小写字母、數字和连字符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー名には、小文字の英数字とハイフンのみを含める必要があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warteschlangennamen dürfen nur alphanumerische Kleinbuchstaben und Bindestriche enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de file d'attente doivent contenir uniquement des caractères alphanumériques minuscules et des traits d'union."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de las colas deben contener únicamente caracteres alfanuméricos en minúscula y guiones."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열 이름에는 소문자 영숫자와 하이픈만 포함해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes das filas devem conter apenas caracteres alfanuméricos minúsculos e hifens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle code devono contenere solo caratteri alfanumerici minuscoli e trattini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена очередей должны содержать только строчные буквы, цифры и дефисы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تحتوي أسماء قوائم الانتظار على أحرف أبجدية رقمية صغيرة وواصلات فقط."
          }
        }
      }
    },
