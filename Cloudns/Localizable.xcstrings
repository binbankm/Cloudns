    "Protects your domain against DNS cache poisoning and man-in-the-middle spoofing by verifying cryptographic signatures with your registrar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمي نطاقك من تسميم ذاكرة التخزين المؤقت لـ DNS والهجمات الوسيطة من خلال التحقق من التوقيعات المشفرة لدى المسجل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt Ihre Domain vor DNS-Cache-Poisoning und Man-in-the-Middle-Angriffen durch Signaturprüfung beim Registrar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege su dominio contra envenenamiento de caché DNS y suplantación de identidad verificando firmas criptográficas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
