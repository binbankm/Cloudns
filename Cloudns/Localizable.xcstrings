          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques de trafic pour la période sélectionnée ne sont actuellement pas disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las métricas de tráfico para el intervalo de tiempo seleccionado no están disponibles actualmente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간의 트래픽 측정항목은 현재 사용할 수 없습니다."
          }
        },
        "pt-BR": {
