            "state": "translated",
            "value": "Masque le contenu spécifique d’une page aux visiteurs suspects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el contenido específico de la página a visitantes sospechosos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의심스러운 방문자로부터 특정 페이지 콘텐츠를 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta o conteúdo específico da página de visitantes suspeitos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde il contenuto specifico della pagina ai visitatori sospetti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает определенное содержимое страницы от подозрительных посетителей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء محتوى صفحة معينة من الزوار المشبوهين."
          }
        }
      }
    },
    "Hides your email addresses from scrapers. Visitors can still see them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides your email addresses from scrapers. Visitors can still see them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向抓取工具隐藏您的电子邮箱地址。访问者依然可以看到它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向抓取工具隱藏您的电子邮箱地址。访问者依然可以看到它们。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスをスクレーパーから隠します。訪問者は今でもそれらを見ることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckt Ihre E-Mail-Adressen vor Scrapern. Besucher können sie immer noch sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache vos adresses e-mail des scrapers. Les visiteurs peuvent toujours les voir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta sus direcciones de correo electrónico de los raspadores. Los visitantes todavía pueden verlos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크레이퍼로부터 이메일 주소를 숨깁니다. 방문자는 계속해서 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta seus endereços de e-mail dos scrapers. Os visitantes ainda podem vê-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde i tuoi indirizzi email dagli scraper. I visitatori possono ancora vederli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает ваши адреса электронной почты от парсеров. Посетители все еще могут их увидеть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي عناوين البريد الإلكتروني الخاصة بك من كاشطات. لا يزال بإمكان الزوار رؤيتهم."
          }
        }
      }
    },
