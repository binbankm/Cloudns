    "Snippets run micro JavaScript functions on HTTP requests with sub-millisecond execution time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل المقتطفات على تشغيل وظائف JavaScript صغيرة على طلبات HTTP مع وقت تنفيذ أقل من مللي ثانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets führen Mikro-JavaScript-Funktionen auf HTTP-Anfragen mit einer Ausführungszeit von weniger als einer Millisekunde aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets run micro JavaScript functions on HTTP requests with sub-millisecond execution time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fragmentos ejecutan funciones micro JavaScript en solicitudes HTTP con un tiempo de ejecución inferior a un milisegundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extraits exécutent des fonctions micro JavaScript sur les requêtes HTTP avec un temps d'exécution inférieur à la milliseconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli snippet eseguono funzioni micro JavaScript su richieste HTTP con tempi di esecuzione inferiori al millisecondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットは、ミリ秒未満の実行時間で HTTP リクエストに対してマイクロ JavaScript 関数を実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스니펫은 밀리초 미만의 실행 시간으로 HTTP 요청에 대해 마이크로 JavaScript 기능을 실행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os snippets executam funções micro JavaScript em solicitações HTTP com tempo de execução inferior a um milissegundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фрагменты запускают микрофункции JavaScript по HTTP-запросам со временем выполнения менее миллисекунды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets 提供了亚毫秒级的微型 JavaScript 代码执行能力，比完整 Workers 更轻量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets 提供了亚毫秒級的微型 JavaScript 代碼执行能力，比完整 Workers 更轻量。"
          }
        }
      }
    },
