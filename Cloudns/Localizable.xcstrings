        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レジストラとの暗号化署名を検証し、DNSキャッシュポイズニングやなりすまし攻撃から保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
