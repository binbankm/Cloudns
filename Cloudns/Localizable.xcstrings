    "Secrets are encrypted at rest and never exposed in cleartext.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير الأسرار أثناء التخزين ولا يتم كشفها أبداً كنص صريح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets werden im Ruhezustand verschlüsselt und niemals im Klartext offengelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets are encrypted at rest and never exposed in cleartext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos se cifran en reposo y nunca se exponen en texto sin formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets sont chiffrés au repos et ne sont jamais exposés en texte clair."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segreti sono crittografati a riposo e non vengono mai esposti in chiaro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットは保存時に暗号化され、平文で公開されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 값은 저장 시 암호화되며 일반 텍스트로 절대 노출되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os segredos são criptografados em repouso e nunca expostos em texto simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секреты шифруются при хранении и никогда не отображаются в открытом виде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机密密钥在静态存储时全程加密，保存后绝不暴露明文内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機密金鑰在靜態儲存時全程加密，儲存後絕不暴露明文內容。"
          }
        }
      }
    },
