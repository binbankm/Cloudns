    "Namespaces are globally distributed Key-Value stores.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Namespaces are globally distributed Key-Value stores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命名空间是全球分布的键值存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命名空間是全球分布的鍵值儲存。"
