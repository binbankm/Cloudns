        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열 이름에는 소문자 영숫자와 하이픈만 포함해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes das filas devem conter apenas caracteres alfanuméricos minúsculos e hifens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
