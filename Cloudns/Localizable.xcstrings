    "Protect your Cloudflare account data with Face ID / Touch ID app lock." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بحماية بيانات حساب Cloudflare الخاص بك باستخدام قفل تطبيق Face ID / Touch ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützen Sie Ihre Cloudflare-Kontodaten mit der Face ID/Touch ID-App-Sperre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect your Cloudflare account data with Face ID / Touch ID app lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteja los datos de su cuenta de Cloudflare con el bloqueo de aplicaciones Face ID/Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez les données de votre compte Cloudflare avec le verrouillage de l'application Face ID / Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi i dati del tuo account Cloudflare con il blocco dell'app Face ID/Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID / Touch ID アプリロックで Cloudflare アカウントデータを保護します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID/Touch ID 앱 잠금으로 Cloudflare 계정 데이터를 보호하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
