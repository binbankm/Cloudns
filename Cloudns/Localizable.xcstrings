            "state": "translated",
            "value": "Rewrites incoming URI path and query string before reaching origin server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在到达源服务器前重写传入 URI 路径和查询字符串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在到达源服务器前重写傳入 URI 路径和查询字符串。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジンサーバーに到達する前に、受信 URI パスとクエリ文字列を書き換えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
