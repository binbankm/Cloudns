          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID/Touch ID 앱 잠금으로 Cloudflare 계정 데이터를 보호하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
