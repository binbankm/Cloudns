    "Cloudflare evaluates Cron triggers based on UTC timezone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare evaluates Cron triggers based on UTC timezone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 基于 UTC 时区评估 Cron 触发器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 基于 UTC 時区评估 Cron 触發器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、UTCタイムゾーンに基づいてCronトリガーを評価します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare wertet Cron-Trigger basierend auf der UTC-Zeitzone aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare évalue les déclencheurs Cron en fonction du fuseau horaire UTC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare evalúa los activadores de Cron según la zona horaria UTC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 UTC 시간대를 기준으로 Cron 트리거를 평가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare avalia os gatilhos Cron com base no fuso horário UTC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare valuta i trigger Cron in base al fuso orario UTC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare оценивает триггеры Cron на основе часового пояса UTC."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Cloudflare بتقييم مشغلات Cron بناءً على المنطقة الزمنية UTC."
          }
        }
      }
    },
    "Cloudflare sends a verification link to newly added destination inboxes before emails can be routed to them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 会向新添加的目标邮箱发送验证链接，需确认激活后方可路由邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 會向新新增的目標邮箱發送驗證链接，需確認激活後方可路由邮件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、電子メールがルーティングされる前に、新しく追加された宛先の受信箱に検証リンクを送信します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare sendet einen Bestätigungslink an neu hinzugefügte Zielposteingänge, bevor E-Mails an diese weitergeleitet werden können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare envoie un lien de vérification aux boîtes de réception de destination nouvellement ajoutées avant que les e-mails puissent y être acheminés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare envía un enlace de verificación a las bandejas de entrada de destino recién agregadas antes de que se puedan enrutar los correos electrónicos a ellas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 이메일이 라우팅되기 전에 새로 추가된 대상 받은 편지함에 확인 링크를 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare envia um link de verificação para caixas de entrada de destino recém-adicionadas antes que os e-mails possam ser roteados para elas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare invia un collegamento di verifica alle caselle di posta di destinazione appena aggiunte prima che le e-mail possano essere indirizzate ad esse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare отправляет ссылку для подтверждения во вновь добавленные целевые почтовые ящики, прежде чем в них можно будет перенаправить электронные письма."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل Cloudflare رابط التحقق إلى صناديق البريد الوارد للوجهة المضافة حديثًا قبل أن يتم توجيه رسائل البريد الإلكتروني إليهم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare sends a verification link to newly added destination inboxes before emails can be routed to them."
          }
        }
      }
    },
    "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自动为您的域名及子域名签署并颁发免费的 SSL/TLS 边缘证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自動為您的網域名稱及子網域名稱签署并颁發免费的 SSL/TLS 边缘證书。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、ドメインとサブドメインの無料のSSL/TLSエッジ証明書に自動的に署名し、発行します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signiert und stellt automatisch kostenlose SSL/TLS-Edge-Zertifikate für Ihre Domain und Subdomains aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signe et émet automatiquement des certificats Edge SSL/TLS gratuits pour votre domaine et vos sous-domaines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma y emite certificados perimetrales SSL/TLS gratuitos para su dominio y subdominios automáticamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 도메인과 하위 도메인에 대한 무료 SSL/TLS 에지 인증서를 자동으로 서명하고 발급합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare assina e emite certificados de borda SSL/TLS gratuitos para seu domínio e subdomínios automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma ed emette automaticamente certificati edge SSL/TLS gratuiti per il tuo dominio e sottodomini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare автоматически подписывает и выдает бесплатные пограничные сертификаты SSL/TLS для вашего домена и поддоменов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم Cloudflare بتوقيع وإصدار شهادات حافة SSL/TLS مجانية لنطاقك ونطاقاتك الفرعية تلقائيًا."
          }
        }
      }
    },
    "Cloudflare storage, queues, and services bound to this Worker environment.": {
      "localizations": {
