    "Smart regional cache tiering to reduce origin server load and drastically improve global cache hit ratios." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخزين مؤقت هرمي ذكي لتقليل العبء على الخادم الأصلي وتحسين معدلات إصابة الذاكرة المؤقتة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligentes Tiered Caching zur Entlastung des Ursprungsservers und Steigerung der Cache-Trefferquote."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart regional cache tiering to reduce origin server load and drastically improve global cache hit ratios."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caché en niveles inteligente para reducir la carga de origen y mejorar la tasa de aciertos de caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise en cache hiérarchisée intelligente pour réduire la charge du serveur et améliorer le taux de succès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caching a livelli intelligente per ridurre il carico di origine e migliorare il cache hit ratio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートな階層型キャッシュにより、オリジンの負荷を軽減し、キャッシュヒット率を向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 지역 계층 캐싱으로 원본 서버 부하를 줄이고 글로벌 캐시 적중률을 대폭 향상합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache em camadas inteligente para reduzir a carga da origem e melhorar as taxas de acerto de cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Многоуровневое кэширование для снижения нагрузки на сервер источника и повышения кэш-хитов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能区域分层缓存技术，大幅降低源站负载并显著提升全球边缘缓存命中率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧區域分層快取技術，大幅降低源站負載並顯著提升全球邊緣快取命中率。"
          }
        }
      }
    },
