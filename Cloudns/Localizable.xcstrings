          "stringUnit": {
            "state": "translated",
            "value": "特定のページのコンテンツを不審な訪問者から隠します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의심스러운 방문자로부터 특정 페이지 콘텐츠를 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
