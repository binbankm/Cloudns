    "Help browsers start loading assets sooner by responding with 103 Early Hints before the full response is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help browsers start loading assets sooner by responding with 103 Early Hints before the full response is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过在响应准备就绪前返回 103 Early Hints，帮助浏览器更快地加载资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過在响應准備就绪前返回 103 Early Hints，帮助浏覽器更快地加載资源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な応答が準備できる前に 103 の早期ヒントで応答することで、ブラウザーがより早くアセットの読み込みを開始できるようにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helfen Sie Browsern, Assets früher zu laden, indem Sie mit 103 Early Hints antworten, bevor die vollständige Antwort bereit ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez les navigateurs à commencer à charger les ressources plus tôt en répondant avec 103 premiers indices avant que la réponse complète ne soit prête."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayude a los navegadores a comenzar a cargar recursos antes respondiendo con 103 sugerencias tempranas antes de que la respuesta completa esté lista."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 응답이 준비되기 전에 103개의 초기 힌트로 응답하여 브라우저가 자산 로드를 더 빨리 시작할 수 있도록 도와주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude os navegadores a começarem a carregar ativos mais cedo, respondendo com 103 dicas iniciais antes que a resposta completa esteja pronta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta i browser a iniziare a caricare le risorse prima rispondendo con 103 suggerimenti iniziali prima che sia pronta la risposta completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите браузерам начать загрузку ресурсов раньше, ответив 103 Early Hints до того, как будет готов полный ответ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد المتصفحات على بدء تحميل الأصول عاجلاً من خلال الاستجابة بـ 103 تلميحات مبكرة قبل أن تصبح الاستجابة الكاملة جاهزة."
          }
        }
      }
    },
