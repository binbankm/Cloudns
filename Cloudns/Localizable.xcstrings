    "Privacy-preserving edge proxy for Google Fonts to eliminate third-party tracking and layout shift." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بروكسي حافة يحافظ على الخصوصية لخطوط Google Fonts لمنع التتبع وانزياح التخطيط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutzfreundlicher Edge-Proxy für Google Fonts zur Vermeidung von Tracking und Layout-Verschiebungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy-preserving edge proxy for Google Fonts to eliminate third-party tracking and layout shift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy perimetral privado para Google Fonts que elimina el rastreo de terceros y los saltos de diseño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy edge respectueux de la vie privée pour Google Fonts afin d'éliminer le traçage et les décalages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy edge sicuro per Google Fonts per eliminare il tracciamento di terze parti e i salti di layout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Fontsをエッジでプロキシ配信し、追跡の排除とレイアウトシフトの防止を実現します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Fonts를 엣지에서 프록시하여 타사 추적을 방지하고 레이아웃 변경을 제거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proxy no edge para Google Fonts que elimina rastreamento de terceiros e deslocamento de layout."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфиденциальный прокси для Google Fonts, устраняющий слежку и сдвиги верстки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过边缘代理加速 Google Fonts 字体分发，彻底消除第三方追踪与布局抖动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過邊緣代理加速 Google Fonts 字型分發，徹底消除第三方追蹤與版面跳動。"
          }
        }
      }
    },
