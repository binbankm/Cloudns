    "Add your first domain to start managing DNS records and Cloudflare edge services.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first domain to start managing DNS records and Cloudflare edge services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的第一个域名，开始管理 DNS 记录及 Cloudflare 边缘服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增您的第一個網域名稱，開始管理 DNS 记录及 Cloudflare 边缘服务。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のドメインを追加して、DNS レコードと Cloudflare エッジ サービスの管理を開始します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre erste Domäne hinzu, um mit der Verwaltung von DNS-Einträgen und Cloudflare-Edge-Diensten zu beginnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre premier domaine pour commencer à gérer les enregistrements DNS et les services Edge Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue su primer dominio para comenzar a administrar registros DNS y servicios perimetrales de Cloudflare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 레코드와 Cloudflare 에지 서비스 관리를 시작하려면 첫 번째 도메인을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seu primeiro domínio para começar a gerenciar registros DNS e serviços de borda da Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo primo dominio per iniziare a gestire i record DNS e i servizi edge Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте свой первый домен, чтобы начать управлять записями DNS и пограничными службами Cloudflare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف نطاقك الأول لبدء إدارة سجلات DNS وخدمات Cloudflare edge."
          }
        }
      }
    },
