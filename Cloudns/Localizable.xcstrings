    "Example: 'api' for api.yourdomain.com, or leave empty / '@' for apex domain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：输入 'api' 代表 api.yourdomain.com，留空或 '@' 代表根域名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：輸入 'api' 代表 api.yourdomain.com，留空或 '@' 代表根網域名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: api.yourdomain.com の場合は「api」、apex ドメインの場合は空 / 「@」のままにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: „api“ für api.yourdomain.com, oder leer lassen / „@“ für Apex-Domain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : 'api' pour api.votredomaine.com, ou laissez vide / '@' pour le domaine apex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: 'api' para api.tudominio.com, o deja vacío / '@' para el dominio apex."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: api.yourdomain.com의 경우 'api', apex 도메인의 경우 '@'를 비워 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo: 'api' para api.seudominio.com ou deixe vazio / '@' para domínio apex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: \"api\" per api.tuodominio.com oppure lascia vuoto / \"@\" per il dominio apex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: «api» для api.yourdomain.com или оставьте пустым / «@» для домена apex."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على سبيل المثال: \"api\" لـ api.yourdomain.com، أو اتركه فارغًا / \"@\" للمجال الرئيسي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 'api' for api.yourdomain.com, or leave empty / '@' for apex domain."
          }
        }
      }
    },
