    "Gateway rules enforce security and DNS filtering policies on zero-trust traffic." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفرض قواعد البوابة سياسات الأمان وتصفية DNS على حركة المرور ذات الثقة المعدومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gateway-Regeln erzwingen Sicherheits- und DNS-Filterrichtlinien für Zero-Trust-Datenverkehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gateway rules enforce security and DNS filtering policies on zero-trust traffic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de puerta de enlace imponen políticas de seguridad y filtrado de DNS en el tráfico de confianza cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles de passerelle appliquent des politiques de sécurité et de filtrage DNS sur le trafic zéro confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole del gateway applicano policy di sicurezza e di filtraggio DNS sul traffico Zero Trust."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲートウェイ ルールは、ゼロトラスト トラフィックに対してセキュリティと DNS フィルタリング ポリシーを適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게이트웨이 규칙은 제로 트러스트 트래픽에 보안 및 DNS 필터링 정책을 적용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras de gateway impõem políticas de segurança e filtragem de DNS no tráfego de confiança zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила шлюза обеспечивают соблюдение политик безопасности и DNS-фильтрации для трафика с нулевым доверием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网关规则针对 Zero Trust 流量执行安全与 DNS 过滤策略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網關規則针对 Zero Trust 流量执行安全性与 DNS 過滤策略。"
          }
        }
      }
