    "Cloudflare Load Balancing is a paid add-on service. Make sure it is active on your Cloudflare account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing هي خدمة إضافية مدفوعة الأجر. تأكد من أنه نشط على حساب Cloudflare الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing ist ein kostenpflichtiger Zusatzdienst. Stellen Sie sicher, dass es in Ihrem Cloudflare-Konto aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing is a paid add-on service. Make sure it is active on your Cloudflare account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing es un servicio complementario pago. Asegúrese de que esté activo en su cuenta de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing est un service complémentaire payant. Assurez-vous qu'il est actif sur votre compte Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing è un servizio aggiuntivo a pagamento. Assicurati che sia attivo sul tuo account Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing は有料のアドオン サービスです。 Cloudflare アカウントでアクティブになっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing은 유료 추가 서비스입니다. Cloudflare 계정에서 활성화되어 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing é um serviço complementar pago. Certifique-se de que esteja ativo em sua conta Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Load Balancing — это платная дополнительная услуга. Убедитесь, что он активен в вашей учетной записи Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
