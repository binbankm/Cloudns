          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выражение проводного фильтра Cloudflare, определяющее, какие входящие запросы вызывают перенаправление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
