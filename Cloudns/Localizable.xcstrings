    "Verify your identity to disable App Lock.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من هويتك لتعطيل قفل التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie Ihre Identität, um die App-Sperre zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to disable App Lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique su identidad para desactivar el bloqueo de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité pour désactiver App Lock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la tua identità per disattivare Blocco app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックを無効にするには、本人確認を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금을 비활성화하려면 신원을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade para desativar o App Lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите свою личность, чтобы отключить блокировку приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份以关闭应用锁。"
          }
