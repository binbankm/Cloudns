          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiamata o distribuzione di funzioni registrata per %@ nell'intervallo di tempo selezionato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ в выбранном диапазоне времени не зарегистрировано вызовов или развертываний функций."
