    "Purge cache instantly, enable dev mode, and optimize your site's performance with a tap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purge cache instantly, enable dev mode, and optimize your site's performance with a tap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键清除缓存，启用开发模式，并优化您的网站性能。"
