          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго посетителю разрешен доступ после успешного выполнения задания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
