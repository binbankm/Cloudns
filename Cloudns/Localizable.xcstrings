    "To create forwarding rules, you must first add and verify at least one destination address below." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإنشاء قواعد إعادة التوجيه، يجب عليك أولاً إضافة عنوان وجهة واحد على الأقل أدناه والتحقق منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Weiterleitungsregeln zu erstellen, müssen Sie unten zunächst mindestens eine Zieladresse hinzufügen und bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To create forwarding rules, you must first add and verify at least one destination address below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para crear reglas de reenvío, primero debe agregar y verificar al menos una dirección de destino a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour créer des règles de transfert, vous devez d'abord ajouter et vérifier au moins une adresse de destination ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per creare regole di inoltro, devi prima aggiungere e verificare almeno un indirizzo di destinazione di seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "転送ルールを作成するには、まず以下に少なくとも 1 つの宛先アドレスを追加して確認する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전달 규칙을 만들려면 먼저 아래에 하나 이상의 대상 주소를 추가하고 확인해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para criar regras de encaminhamento, primeiro você deve adicionar e verificar pelo menos um endereço de destino abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы создать правила переадресации, необходимо сначала добавить и подтвердить хотя бы один адрес назначения ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建转发规则前，请先在下方添加并验证至少一个目标邮箱地址。"
