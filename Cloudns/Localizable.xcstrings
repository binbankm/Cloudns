    "Creates a remotely managed Cloudflare Zero Trust tunnel. Once created, install cloudflared using the generated connector token." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء نفق Cloudflare Zero Trust مُدار عن بعد. بمجرد الإنشاء، قم بتثبيت cloudflared باستخدام الرمز المميز للموصل الذي تم إنشاؤه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt einen remote verwalteten Cloudflare Zero Trust-Tunnel. Nach der Erstellung installieren Sie Cloudflared mit dem generierten Connector-Token."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a remotely managed Cloudflare Zero Trust tunnel. Once created, install cloudflared using the generated connector token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un túnel Cloudflare Zero Trust administrado de forma remota. Una vez creado, instale cloudflared utilizando el token del conector generado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un tunnel Cloudflare Zero Trust géré à distance. Une fois créé, installez cloudflared à l'aide du jeton de connecteur généré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un tunnel Cloudflare Zero Trust gestito in remoto. Una volta creato, installa cloudflared utilizzando il token del connettore generato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモート管理されるCloudflareゼロトラストトンネルを作成します。作成したら、生成されたコネクタ トークンを使用して Cloudflared をインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격으로 관리되는 Cloudflare Zero Trust 터널을 생성합니다. 생성되면 생성된 커넥터 토큰을 사용하여 cloudflared를 설치하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um túnel Cloudflare Zero Trust gerenciado remotamente. Depois de criado, instale o cloudflared usando o token do conector gerado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создает удаленно управляемый туннель Cloudflare Zero Trust. После создания установите Cloudflared, используя сгенерированный токен соединителя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建远程管理的 Cloudflare Zero Trust 隧道。创建完成后，使用生成的连接器令牌安装 cloudflared。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建远程管理的 Cloudflare Zero Trust 通道。创建完成後，使用生成的连接器令牌安装 cloudflared。"
          }
        }
      }
    },
