          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のデプロイメントにロールバックすると、ワーカーのコードと構成が即座に復元されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie ein Rollback zu einer vorherigen Bereitstellung durch, um den Worker-Code und die Worker-Konfiguration sofort wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
