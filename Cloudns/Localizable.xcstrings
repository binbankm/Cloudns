    "Create a Cloudflare Queue to send and receive messages with guaranteed delivery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Cloudflare Queue to send and receive messages with guaranteed delivery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建 Cloudflare 消息队列以保证消息的可靠发送与接收。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "创建 Cloudflare 消息队列以保證消息的可靠發送与接收。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareキューを作成して、配信を保証したメッセージを送受信します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine Cloudflare-Warteschlange zum Senden und Empfangen von Nachrichten mit garantierter Zustellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une file d'attente Cloudflare pour envoyer et recevoir des messages avec une livraison garantie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree una cola de Cloudflare para enviar y recibir mensajes con entrega garantizada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 대기열을 생성하여 배달이 보장된 메시지를 보내고 받으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma fila Cloudflare para enviar e receber mensagens com entrega garantida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una coda Cloudflare per inviare e ricevere messaggi con consegna garantita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте очередь Cloudflare для отправки и получения сообщений с гарантированной доставкой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء قائمة انتظار Cloudflare لإرسال واستقبال الرسائل مع ضمان التسليم."
          }
        }
      }
    },
    "Create an AI Gateway to observe, cache, and manage your AI API traffic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an AI Gateway to observe, cache, and manage your AI API traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建 AI 网关以统一观测、缓存和管理您的 AI API 流量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "创建 AI 網關以統一观測、快取和管理您的 AI API 流量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ゲートウェイを作成して、AI API トラフィックを観察、キャッシュ、管理します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie ein KI-Gateway, um Ihren KI-API-Verkehr zu beobachten, zwischenzuspeichern und zu verwalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une passerelle AI pour observer, mettre en cache et gérer le trafic de votre API AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree una puerta de enlace AI para observar, almacenar en caché y administrar su tráfico API AI."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI API 트래픽을 관찰, 캐시, 관리하기 위해 AI 게이트웨이를 생성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um AI Gateway para observar, armazenar em cache e gerenciar o tráfego da API AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un gateway AI per osservare, memorizzare nella cache e gestire il traffico API AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте шлюз AI для наблюдения, кэширования и управления трафиком AI API."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء بوابة AI لمراقبة حركة مرور AI API الخاصة بك وتخزينها مؤقتًا وإدارتها."
          }
        }
      }
    },
    "Create custom routing rules to forward incoming emails to external addresses.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create custom routing rules to forward incoming emails to external addresses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建自定义路由规则将接收的邮件转发至外部地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "创建自定义路由規則将接收的邮件轉發至外部地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信メールを外部アドレスに転送するためのカスタム ルーティング ルールを作成します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie benutzerdefinierte Routing-Regeln, um eingehende E-Mails an externe Adressen weiterzuleiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des règles de routage personnalisées pour transférer les e-mails entrants vers des adresses externes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree reglas de enrutamiento personalizadas para reenviar correos electrónicos entrantes a direcciones externas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 이메일을 외부 주소로 전달하는 사용자 정의 라우팅 규칙을 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie regras de roteamento personalizadas para encaminhar e-mails recebidos para endereços externos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea regole di routing personalizzate per inoltrare le email in arrivo a indirizzi esterni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте собственные правила маршрутизации для пересылки входящих писем на внешние адреса."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء قواعد توجيه مخصصة لإعادة توجيه رسائل البريد الإلكتروني الواردة إلى عناوين خارجية."
          }
        }
      }
    },
