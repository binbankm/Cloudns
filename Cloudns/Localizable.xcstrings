    "This will immediately switch your production Pages traffic to this historical deployment build.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا على الفور إلى تحويل حركة مرور صفحات الإنتاج الخاصة بك إلى إصدار النشر التاريخي هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Datenverkehr Ihrer Produktionsseiten sofort auf diesen historischen Bereitstellungs-Build umgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will immediately switch your production Pages traffic to this historical deployment build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cambiará inmediatamente el tráfico de sus páginas de producción a esta compilación de implementación histórica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fera immédiatement basculer le trafic de vos pages de production vers cette version de déploiement historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò trasferirà immediatamente il traffico delle tue pagine di produzione a questa build di distribuzione storica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、運用ページのトラフィックがこの履歴展開ビルドに即座に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 프로덕션 페이지 트래픽이 이 기록 배포 빌드로 즉시 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso mudará imediatamente o tráfego de suas páginas de produção para esta construção de implantação histórica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это немедленно переключит трафик ваших рабочих страниц на эту историческую сборку развертывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即将您的 Pages 生产环境流量切换到此历史部署版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即将您的 Pages 生产环境流量切换到此历史部署版本。"
