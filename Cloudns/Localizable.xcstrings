    "The email address on your domain that will receive messages.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان البريد الإلكتروني الموجود على نطاقك والذي سيتلقى الرسائل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse Ihrer Domain, an die Nachrichten gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email address on your domain that will receive messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de correo electrónico de su dominio que recibirá mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adresse e-mail de votre domaine qui recevra les messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indirizzo email del tuo dominio che riceverà i messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを受信するドメインの電子メール アドレス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 수신할 도메인의 이메일 주소입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço de e-mail no seu domínio que receberá mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес электронной почты в вашем домене, на который будут получать сообщения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您域名下将接收消息的电子邮件地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您網域名稱下将接收消息的电子邮件地址。"
          }
        }
      }
    },
    "The verified destination address where messages will be forwarded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان الوجهة الذي تم التحقق منه حيث سيتم إعادة توجيه الرسائل."
          }
        },
