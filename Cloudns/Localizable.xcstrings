          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间范围内未记录到 %@ 的函数调用或部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選時間范围内未记录到 %@ 的函數調用或部署。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した時間範囲内で %@ に対して記録された関数の呼び出しまたはデプロイメントはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ wurden im ausgewählten Zeitraum keine Funktionsaufrufe oder Bereitstellungen aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appel ou déploiement de fonctions enregistré pour %@ dans la plage de temps sélectionnée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se registraron invocaciones ni implementaciones de funciones durante %@ en el rango de tiempo seleccionado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간 동안 %@에 대해 기록된 함수 호출 또는 배포가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
