    "All diagnostics queries run directly from your device or Cloudflare's 1.1.1.1 edge network.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل جميع استعلامات التشخيص مباشرة من جهازك أو من شبكة Cloudflare 1.1.1.1 المتطورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Diagnoseabfragen werden direkt von Ihrem Gerät oder dem Edge-Netzwerk 1.1.1.1 von Cloudflare ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All diagnostics queries run directly from your device or Cloudflare's 1.1.1.1 edge network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las consultas de diagnóstico se ejecutan directamente desde su dispositivo o la red perimetral 1.1.1.1 de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les requêtes de diagnostic s'exécutent directement à partir de votre appareil ou du réseau périphérique 1.1.1.1 de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le query diagnostiche vengono eseguite direttamente dal tuo dispositivo o dalla rete edge 1.1.1.1 di Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての診断クエリは、デバイスまたはCloudflareの1.1.1.1エッジネットワークから直接実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 진단 쿼리는 장치 또는 Cloudflare의 1.1.1.1 에지 네트워크에서 직접 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as consultas de diagnóstico são executadas diretamente do seu dispositivo ou da rede de borda 1.1.1.1 da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все диагностические запросы выполняются непосредственно с вашего устройства или из пограничной сети Cloudflare 1.1.1.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有诊断查询均直接从您的设备或 Cloudflare 1.1.1.1 边缘网络运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有诊断查询均直接從您的设備或 Cloudflare 1.1.1.1 边缘網路运行。"
          }
        }
      }
    },
