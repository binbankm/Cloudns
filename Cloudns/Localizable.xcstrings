    "Are you sure you want to enable I'm Under Attack Mode? All visitors will be challenged. This may negatively impact legitimate traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要启用“I'm Under Attack”模式吗？所有访客都将面临验证。这可能会对合法流量产生负面影响。"
          }
        }
      }
    },
    "Are you sure you want to log out of your Cloudflare account?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to log out of your Cloudflare account?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要退出所有 Cloudflare 账号吗？"
          }
        }
      }
    },
    "Are you sure you want to purge all cached resources? This may temporarily degrade your website's performance and increase load on your origin server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要清除所有缓存资源吗？这可能会暂时降低网站性能并增加源服务器的负载。"
          }
        }
      }
    },
    "Are you sure you want to remove %@ from Cloudflare? This action cannot be undone and will permanently delete all DNS records and settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要从 Cloudflare 中移除 %@ 吗？此操作无法撤销，将永久删除所有 DNS 记录和设置。"
          }
        }
      }
    },
