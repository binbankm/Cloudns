    "Adjust your website's security level to determine who will receive a challenge page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your website's security level to determine who will receive a challenge page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整网站的安全级别以决定谁会看到验证页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整網站的安全性級別以决定谁會看到驗證頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web サイトのセキュリティ レベルを調整して、誰がチャレンジ ページを受け取るかを決定します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Sicherheitsstufe Ihrer Website an, um zu bestimmen, wer eine Challenge-Seite erhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le niveau de sécurité de votre site Web pour déterminer qui recevra une page de défi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste el nivel de seguridad de su sitio web para determinar quién recibirá una página de desafío."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트의 보안 수준을 조정하여 챌린지 페이지를 받을 사람을 결정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o nível de segurança do seu site para determinar quem receberá uma página de desafio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica il livello di sicurezza del tuo sito web per determinare chi riceverà una pagina di sfida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте уровень безопасности вашего веб-сайта, чтобы определить, кто получит страницу с вызовом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مستوى أمان موقع الويب الخاص بك لتحديد من سيتلقى صفحة التحدي."
          }
        }
      }
    },
