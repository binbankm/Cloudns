    "If your server goes down, Cloudflare will serve your website's static pages from our cache." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تعطل الخادم الخاص بك، فسوف يقوم Cloudflare بخدمة الصفحات الثابتة لموقع الويب الخاص بك من ذاكرة التخزين المؤقت لدينا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Ihr Server ausfällt, stellt Cloudflare die statischen Seiten Ihrer Website aus unserem Cache bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your server goes down, Cloudflare will serve your website's static pages from our cache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si su servidor falla, Cloudflare servirá las páginas estáticas de su sitio web desde nuestro caché."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre serveur tombe en panne, Cloudflare servira les pages statiques de votre site Web à partir de notre cache."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il tuo server non funziona, Cloudflare servirà le pagine statiche del tuo sito web dalla nostra cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがダウンした場合、CloudflareはキャッシュからWebサイトの静的ページを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 다운되면 Cloudflare는 캐시에서 웹사이트의 정적 페이지를 제공합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o seu servidor cair, a Cloudflare servirá as páginas estáticas do seu site a partir do nosso cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ваш сервер выйдет из строя, Cloudflare будет обслуживать статические страницы вашего сайта из нашего кеша."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您的服务器宕机，Cloudflare 将从我们的缓存中提供您网站的静态页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您的服务器宕机，Cloudflare 将從我们的快取中提供您網站的静態頁面。"
          }
        }
      }
    },
