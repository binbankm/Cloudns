          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le metriche sul traffico per l'intervallo di tempo selezionato non sono al momento disponibili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатели трафика для выбранного диапазона времени в настоящее время недоступны."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقاييس حركة المرور للنطاق الزمني المحدد غير متاحة حاليًا."
          }
        }
      }
    },
    "Traffic will be routed here if all default pools fail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic will be routed here if all default pools fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若所有默认源池均失败，流量将路由至此。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若所有默認源池均失败，流量将路由至此。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデフォルト プールに障害が発生した場合、トラフィックはここにルーティングされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenverkehr wird hierher weitergeleitet, wenn alle Standardpools ausfallen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic sera acheminé ici si tous les pools par défaut échouent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico se enrutará aquí si todos los grupos predeterminados fallan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기본 풀이 실패하면 트래픽이 여기로 라우팅됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego será roteado aqui se todos os pools padrão falharem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traffico verrà instradato qui se tutti i pool predefiniti falliscono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюда будет направляться трафик в случае сбоя всех пулов по умолчанию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم توجيه حركة المرور هنا في حالة فشل جميع المجمعات الافتراضية."
          }
        }
      }
    },
