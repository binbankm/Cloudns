    "Control geographic headers and edge-to-origin protocol versions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحكم في ترويسات الموقع الجغرافي وإصدارات البروتوكول بين الحافة والمصدر."
          }
        },
