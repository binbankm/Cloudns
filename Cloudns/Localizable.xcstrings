    "Bulk Redirects allow you to define thousands of URL redirects at the account level.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulk Redirects allow you to define thousands of URL redirects at the account level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量重定向允许您在账户级别定义成千上万个 URL 重定向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批量重定向允许您在帳號級別定义成千上万個 URL 重定向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括リダイレクトを使用すると、アカウント レベルで数千の URL リダイレクトを定義できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Massenweiterleitungen können Sie Tausende von URL-Weiterleitungen auf Kontoebene definieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les redirections groupées vous permettent de définir des milliers de redirections d'URL au niveau du compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los redireccionamientos masivos le permiten definir miles de redirecciones de URL a nivel de cuenta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대량 리디렉션을 사용하면 계정 수준에서 수천 개의 URL 리디렉션을 정의할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os redirecionamentos em massa permitem definir milhares de redirecionamentos de URL no nível da conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I reindirizzamenti collettivi ti consentono di definire migliaia di reindirizzamenti URL a livello di account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Массовые перенаправления позволяют вам определять тысячи перенаправлений URL-адресов на уровне учетной записи."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح لك عمليات إعادة التوجيه المجمعة بتحديد الآلاف من عمليات إعادة توجيه عناوين URL على مستوى الحساب."
          }
        }
      }
    },
