    "This will immediately deploy the modified code to '%@' while safely preserving all resource bindings and secrets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا على الفور إلى نشر التعليمات البرمجية المعدلة إلى '%@' مع الحفاظ بأمان على جميع روابط الموارد وأسرارها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird der geänderte Code sofort in „%@“ bereitgestellt, während alle Ressourcenbindungen und Geheimnisse sicher erhalten bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will immediately deploy the modified code to '%@' while safely preserving all resource bindings and secrets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto implementará inmediatamente el código modificado en '%@' y al mismo tiempo preservará de forma segura todos los enlaces y secretos de recursos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela déploiera immédiatement le code modifié sur '%@' tout en préservant en toute sécurité toutes les liaisons de ressources et tous les secrets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò distribuirà immediatamente il codice modificato in \"%@\" preservando in modo sicuro tutti i collegamenti e i segreti delle risorse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべてのリソース バインディングとシークレットを安全に保持しながら、変更されたコードがすぐに '%@' にデプロイされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 모든 리소스 바인딩과 비밀을 안전하게 유지하면서 수정된 코드가 '%@'에 즉시 배포됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso implantará imediatamente o código modificado em '%@', preservando com segurança todas as ligações e segredos de recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При этом измененный код будет немедленно развернут в «%@», при этом все привязки и секреты ресурсов будут безопасно сохранены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将立即将修改后的代码部署到“%@”，同时安全保留所有资源绑定与环境变量密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将立即将修改後的代碼部署到“%@”，同時安全性保留所有资源绑定与环境變量密钥。"
          }
        }
      }
    },
    "This will immediately expire and clear all cached static files globally across Cloudflare edge data centers for %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستنتهي صلاحية هذا على الفور ويتم مسح جميع الملفات الثابتة المخزنة مؤقتًا عالميًا عبر مراكز بيانات Cloudflare edge لـ %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies läuft sofort ab und löscht alle zwischengespeicherten statischen Dateien weltweit in den Edge-Rechenzentren von Cloudflare für %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will immediately expire and clear all cached static files globally across Cloudflare edge data centers for %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto caducará inmediatamente y borrará todos los archivos estáticos almacenados en caché a nivel mundial en los centros de datos perimetrales de Cloudflare para %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela expirera immédiatement et effacera tous les fichiers statiques mis en cache dans le monde entier dans les centres de données périphériques Cloudflare pour %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo scadrà immediatamente e cancellerà tutti i file statici memorizzati nella cache a livello globale nei data center edge Cloudflare per %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、%@ の Cloudflare エッジ データセンター全体でキャッシュされたすべての静的ファイルが直ちに期限切れになり、グローバルにクリアされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이는 %@에 대한 Cloudflare 에지 데이터 센터 전반에 걸쳐 전 세계적으로 캐시된 모든 정적 파일을 즉시 만료하고 지웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso expirará imediatamente e limpará todos os arquivos estáticos armazenados em cache globalmente nos data centers de borda da Cloudflare para %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия этого срока немедленно истечет, и все кэшированные статические файлы будут удалены по всему миру в периферийных центрах обработки данных Cloudflare для %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将在全球所有 Cloudflare 边缘节点上立即清除并废弃 %@ 的全部静态缓存文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将在全球所有 Cloudflare 边缘节點上立即清除并废弃 %@ 的全部静態快取文件。"
          }
        }
      }
    },
