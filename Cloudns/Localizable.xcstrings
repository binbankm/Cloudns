    "Help browsers start loading linked CSS/JS assets before the HTML response finishes rendering.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعد المتصفح في بدء تحميل ملفات CSS و JS قبل اكتمال معالجة HTML."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt Browser beim Laden von CSS/JS-Assets, bevor die HTML-Antwort gerendert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help browsers start loading linked CSS/JS assets before the HTML response finishes rendering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a los navegadores a cargar recursos CSS/JS antes de que finalice el procesamiento HTML."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux navigateurs de charger les fichiers CSS/JS avant la fin du rendu HTML."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta i browser a caricare le risorse CSS/JS prima che la risposta HTML finisca il rendering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTMLのレンダリングが完了する前に、ブラウザがCSS/JSの読み込みを開始できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTML 응답이 완료되기 전에 브라우저가 연결된 CSS/JS 리소스를 미리 로드하도록 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuda os navegadores a carregar recursos CSS/JS antes que a resposta HTML termine a renderização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогает браузеру загружать связанные стили и скрипты до завершения рендеринга HTML."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HTML 响应渲染完成前，协助浏览器提前预载入关联的 CSS/JS 等静态资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HTML 回應渲染完成前，協助瀏覽器提前預載入關聯的 CSS/JS 等靜態資源。"
          }
        }
      }
    },
