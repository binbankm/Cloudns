    "Leave blank to use column defaults. Values are escaped before saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتركه فارغًا لاستخدام الإعدادات الافتراضية للأعمدة. يتم هروب القيم قبل الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie das Feld leer, um die Spaltenstandards zu verwenden. Werte werden vor dem Speichern maskiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave blank to use column defaults. Values are escaped before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjelo en blanco para utilizar los valores predeterminados de las columnas. Los valores se escapan antes de guardarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser les valeurs par défaut des colonnes. Les valeurs sont échappées avant d'être enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per utilizzare le impostazioni predefinite della colonna. I valori vengono sottoposti a escape prima del salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列のデフォルトを使用するには、空白のままにします。値は保存する前にエスケープされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 기본값을 사용하려면 비워 두세요. 저장하기 전에 값이 이스케이프됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para usar os padrões de coluna. Os valores são escapados antes de serem salvos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать значения столбца по умолчанию. Значения экранируются перед сохранением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空以使用字段默认值。值在保存前会自动转义。"
