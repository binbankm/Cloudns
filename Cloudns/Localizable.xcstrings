          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитите данные своей учетной записи Cloudflare с помощью блокировки приложения Face ID / Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
