    "Enter a subdomain prefix (e.g. 'api' for api.%@) or leave blank / enter '@' for apex domain." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل بادئة النطاق الفرعي (على سبيل المثال، \"api\" لـ api.%@) أو اترك الحقل فارغًا / أدخل \"@\" للمجال الرئيسي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie ein Subdomain-Präfix ein (z. B. „api“ für api.%@) oder lassen Sie das Feld leer bzw. geben Sie „@“ für die Apex-Domain ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a subdomain prefix (e.g. 'api' for api.%@) or leave blank / enter '@' for apex domain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrese un prefijo de subdominio (por ejemplo, 'api' para api.%@) o déjelo en blanco/ingrese '@' para el dominio apex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez un préfixe de sous-domaine (par exemple « api » pour api.%@) ou laissez vide/entrez « @ » pour le domaine apex."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un prefisso del sottodominio (ad esempio \"api\" per api.%@) o lascia vuoto / inserisci \"@\" per il dominio apex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブドメインのプレフィックス (例: api.%@ の場合は「api」) を入力するか、空白のままにするか、apex ドメインの場合は「@」を入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하위 도메인 접두사(예: api.%@의 경우 'api')를 입력하거나 공백으로 두거나 apex 도메인의 경우 '@'을 입력합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira um prefixo de subdomínio (por exemplo, 'api' para api.%@) ou deixe em branco/insira '@' para domínio apex."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите префикс субдомена (например, «api» для api.%@) или оставьте поле пустым или введите «@» для домена вершины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入子域名前缀（例如输入 'api' 对应 api.%@），留空或输入 '@' 则为主域名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入子網域名稱前缀（例如輸入 'api' 对應 api.%@），留空或輸入 '@' 则為主網域名稱。"
          }
        }
      }
    },
