    "Secret values are encrypted at rest and cannot be viewed once saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير القيم السرية عند التخزين ولا يمكن عرضها كنص صريح بعد الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret-Werte werden verschlüsselt gespeichert und können nach dem Speichern nicht mehr eingesehen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret values are encrypted at rest and cannot be viewed once saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores secretos se cifran en reposo y no se pueden volver a ver una vez guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs secrètes sont chiffrées et ne peuvent plus être consultées une fois enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori dei segreti sono crittografati e non possono essere visualizzati dopo il salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットは保存時に暗号化され、保存後に平文で確認することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 값은 저장 시 암호화되며 저장 후에는 다시 평문으로 확인할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores secretos são criptografados e não podem ser visualizados após o salvamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретные значения шифруются при хранении и не могут быть просмотрены после сохранения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密密钥在静态存储时自动加密，保存后不可再次反向查看明文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機密金鑰在靜態儲存時自動加密，儲存後不可再次反向檢視明文。"
          }
        }
      }
    },
    "Secret values are strictly write-only and encrypted. To change a value, simply save a new value under the same secret name." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم السرية تكون مكتوبة فقط ومشفرة. لتغيير قيمة، ما عليك سوى حفظ قيمة جديدة تحت نفس الاسم السري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheime Werte sind ausschließlich schreibgeschützt und verschlüsselt. Um einen Wert zu ändern, speichern Sie einfach einen neuen Wert unter demselben geheimen Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret values are strictly write-only and encrypted. To change a value, simply save a new value under the same secret name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores secretos son estrictamente de solo escritura y están cifrados. Para cambiar un valor, simplemente guarde un valor nuevo con el mismo nombre secreto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs secrètes sont strictement en écriture seule et cryptées. Pour modifier une valeur, enregistrez simplement une nouvelle valeur sous le même nom secret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori segreti sono rigorosamente di sola scrittura e crittografati. Per modificare un valore, salva semplicemente un nuovo valore con lo stesso nome segreto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレット値は厳密に書き込み専用であり、暗号化されます。値を変更するには、同じシークレット名で新しい値を保存するだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 값은 엄격하게 쓰기 전용이며 암호화됩니다. 값을 변경하려면 동일한 비밀 이름으로 새 값을 저장하면 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores secretos são estritamente somente para gravação e criptografados. Para alterar um valor, basta salvar um novo valor com o mesmo nome secreto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретные значения доступны только для записи и зашифрованы. Чтобы изменить значение, просто сохраните новое значение под тем же секретным именем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密值严格为只写且已加密。如需更改，只需在相同机密名称下保存新值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机密值严格為只写且已加密。如需更改，只需在相同机密名称下儲存新值。"
          }
        }
      }
    },
