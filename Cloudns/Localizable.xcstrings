          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действие для писем, отправленных на адреса в этом домене, которые не соответствуют ни одному явному правилу маршрутизации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
