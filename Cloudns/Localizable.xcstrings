    "Require Face ID or Touch ID to unlock the app when returning from the background.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require Face ID or Touch ID to unlock the app when returning from the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从后台返回时需要通过面容 ID 或触控 ID 解锁应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
