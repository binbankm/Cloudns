    "Cloudflare Snippets allow executing lightweight JavaScript logic on HTTP requests without full Workers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets allow executing lightweight JavaScript logic on HTTP requests without full Workers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets 允许在边缘 HTTP 请求处理链中执行亚毫秒级的极速微 JavaScript 逻辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets 允许在边缘 HTTP 請求處理链中执行亚毫秒級的極速微 JavaScript 逻辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare スニペットを使用すると、完全なワーカーを使用せずに HTTP リクエストで軽量の JavaScript ロジックを実行できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Snippets ermöglichen die Ausführung einfacher JavaScript-Logik auf HTTP-Anfragen ohne vollständige Worker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits Cloudflare permettent d'exécuter une logique JavaScript légère sur les requêtes HTTP sans Workers complets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos de Cloudflare permiten ejecutar lógica JavaScript liviana en solicitudes HTTP sin trabajadores completos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 코드 조각을 사용하면 전체 작업자 없이 HTTP 요청에서 경량 JavaScript 논리를 실행할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os snippets da Cloudflare permitem executar lógica JavaScript leve em solicitações HTTP sem trabalhadores completos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli snippet di Cloudflare consentono di eseguire una logica JavaScript leggera su richieste HTTP senza worker completi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сниппеты Cloudflare позволяют выполнять упрощенную логику JavaScript по HTTP-запросам без полных рабочих процессов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح Cloudflare Snippets بتنفيذ منطق JavaScript خفيف الوزن على طلبات HTTP بدون عمال كاملين."
          }
        }
      }
    },
