    "Traffic metrics for the selected time range are currently unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic metrics for the selected time range are currently unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间范围内的流量指标当前不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選時間范围内的流量指標當前不可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した時間範囲のトラフィック メトリックは現在利用できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
