    "Automatically rewrite HTTP resources to HTTPS to avoid mixed content warnings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically rewrite HTTP resources to HTTPS to avoid mixed content warnings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动将 HTTP 资源重写为 HTTPS，以避免混合内容警告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動将 HTTP 资源重写為 HTTPS，以避免混合内容警告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "混合コンテンツの警告を回避するために、HTTP リソースを HTTPS に自動的に書き換えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie HTTP-Ressourcen automatisch in HTTPS um, um Warnungen zu gemischten Inhalten zu vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrivez automatiquement les ressources HTTP en HTTPS pour éviter les avertissements de contenu mixte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescriba automáticamente los recursos HTTP a HTTPS para evitar advertencias de contenido mixto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼합 콘텐츠 경고를 방지하려면 HTTP 리소스를 HTTPS로 자동으로 다시 작성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescreva automaticamente os recursos HTTP para HTTPS para evitar avisos de conteúdo misto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrivi automaticamente le risorse HTTP in HTTPS per evitare avvisi di contenuti misti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически перезаписывайте ресурсы HTTP на HTTPS, чтобы избежать предупреждений о смешанном содержимом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة كتابة موارد HTTP تلقائيًا إلى HTTPS لتجنب تحذيرات المحتوى المختلط."
          }
        }
      }
    },
