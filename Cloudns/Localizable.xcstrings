    "Tap any deployment to view build logs, stage status, and environment variables.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点任意部署记录可查看构建日志、阶段状态及环境变量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轻點任意部署记录可查看构建記錄、阶段状態及环境變量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デプロイメントをタップすると、ビルド ログ、ステージ ステータス、環境変数が表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine beliebige Bereitstellung, um Build-Protokolle, den Phasenstatus und Umgebungsvariablen anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur n'importe quel déploiement pour afficher les journaux de build, l'état de l'étape et les variables d'environnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque cualquier implementación para ver los registros de compilación, el estado de la etapa y las variables de entorno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 로그, 단계 상태 및 환경 변수를 보려면 배포를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer implantação para visualizar logs de build, status de estágio e variáveis ​​de ambiente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca qualsiasi distribuzione per visualizzare i registri di build, lo stato della fase e le variabili di ambiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь любого развертывания, чтобы просмотреть журналы сборки, состояние этапа и переменные среды."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق أي عملية نشر لعرض سجلات البناء وحالة المرحلة ومتغيرات البيئة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any deployment to view build logs, stage status, and environment variables."
          }
        }
      }
    },
