            "value" : "Valor secreto (criptografado)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секретное значение (зашифрованное)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
