    "Secrets are encrypted and exposed as environment variables to your Worker script at runtime." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير الأسرار وعرضها كمتغيرات بيئة للبرنامج النصي العامل الخاص بك في وقت التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse werden verschlüsselt und zur Laufzeit als Umgebungsvariablen für Ihr Worker-Skript verfügbar gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets are encrypted and exposed as environment variables to your Worker script at runtime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los secretos se cifran y se exponen como variables de entorno en su script de trabajo en tiempo de ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les secrets sont chiffrés et exposés en tant que variables d'environnement à votre script Worker au moment de l'exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I segreti vengono crittografati ed esposti come variabili di ambiente nello script Worker in fase di runtime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットは暗号化され、実行時に環境変数としてワーカー スクリプトに公開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀은 암호화되어 런타임 시 작업자 스크립트에 환경 변수로 노출됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os segredos são criptografados e expostos como variáveis ​​de ambiente ao seu script Worker em tempo de execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секреты шифруются и предоставляются как переменные среды вашему рабочему сценарию во время выполнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥在保存后将被高强度加密，仅在脚本运行时作为环境变量注入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥在儲存後将被高强度加密，仅在脚本运行時作為环境變量注入。"
          }
        }
      }
    },
    "Secrets are encrypted at rest and masked in responses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير الأسرار أثناء الراحة وإخفائها في الردود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse werden im Ruhezustand verschlüsselt und in Antworten maskiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets are encrypted at rest and masked in responses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los secretos se cifran en reposo y se enmascaran en las respuestas."
          }
        },
        "fr" : {
