          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您的网站当前正在遭受 DDoS 攻击时才使用此选项。访客将短暂看到一个插页，同时我们会分析他们的流量和行为，确保他们是合法的人类访客。"
          }
        }
      }
