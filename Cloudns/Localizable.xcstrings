    "Manage all Cloudflare DNS records, edge routing, and instant cache purging with zero latency.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة جميع سجلات Cloudflare DNS، وتوجيه الحافة، والتطهير الفوري لذاكرة التخزين المؤقت بدون زمن انتقال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie alle Cloudflare-DNS-Einträge, Edge-Routing und sofortiges Cache-Löschen ohne Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage all Cloudflare DNS records, edge routing, and instant cache purging with zero latency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Administre todos los registros DNS de Cloudflare, el enrutamiento perimetral y la purga instantánea de caché con latencia cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez tous les enregistrements DNS Cloudflare, le routage périphérique et la purge instantanée du cache sans latence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci tutti i record DNS di Cloudflare, l'edge routing e l'eliminazione istantanea della cache con zero latenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのCloudflare DNSレコード、エッジルーティング、インスタントキャッシュパージを遅延ゼロで管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 Cloudflare DNS 레코드, 에지 라우팅, 즉시 캐시 제거를 대기 시간 없이 관리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie todos os registros DNS da Cloudflare, roteamento de borda e limpeza instantânea de cache com latência zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте всеми DNS-записями Cloudflare, пограничной маршрутизацией и мгновенной очисткой кэша с нулевой задержкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零延迟管理 Cloudflare DNS 记录、边缘路由与即时缓存清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "零延迟管理 Cloudflare DNS 记录、边缘路由与即時快取清理。"
          }
        }
      }
    },
