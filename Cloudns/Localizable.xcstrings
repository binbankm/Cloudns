        }
      }
    },
    "Secrets are encrypted upon saving and cannot be retrieved or read back by the API." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تشفير الأسرار عند الحفظ ولا يمكن استرجاعها أو قراءتها مرة أخرى بواسطة واجهة برمجة التطبيقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheimnisse werden beim Speichern verschlüsselt und können von der API nicht abgerufen oder zurückgelesen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secrets are encrypted upon saving and cannot be retrieved or read back by the API."
          }
        },
        "es" : {
          "stringUnit" : {
