    "Send an HTTP request or wait for a cron trigger to see logs appear in real time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل طلب HTTP أو انتظر مشغل cron لرؤية السجلات تظهر في الوقت الفعلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie eine HTTP-Anfrage oder warten Sie auf einen Cron-Trigger, um die Protokolle in Echtzeit anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an HTTP request or wait for a cron trigger to see logs appear in real time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe una solicitud HTTP o espere a que se active un cron para ver los registros aparecer en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez une requête HTTP ou attendez un déclencheur cron pour voir les journaux apparaître en temps réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia una richiesta HTTP o attendi un trigger cron per visualizzare i log in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエストを送信するか、cron トリガーを待って、ログがリアルタイムで表示されることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청을 보내거나 cron 트리거가 실시간으로 표시되는 로그를 볼 때까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie uma solicitação HTTP ou aguarde um gatilho cron para ver os logs aparecerem em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте HTTP-запрос или дождитесь триггера cron, чтобы увидеть журналы в режиме реального времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 HTTP 请求或等待 Cron 触发器执行以实时查看日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發送 HTTP 請求或等待 Cron 触發器执行以實時查看記錄。"
          }
        }
      }
    },
    "Send automated HTTP/HTTPS health checks to your origin servers.": {
