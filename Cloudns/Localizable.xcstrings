    "Purge everything from Cloudflare's cache. This will force Cloudflare to fetch a fresh version of your site from your origin server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمسح كل شيء من ذاكرة التخزين المؤقت لـ Cloudflare. سيؤدي هذا إلى إجبار Cloudflare على جلب نسخة جديدة من موقعك من خادمك الأصلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen Sie alles aus dem Cloudflare-Cache. Dadurch wird Cloudflare gezwungen, eine neue Version Ihrer Website von Ihrem Ursprungsserver abzurufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purge everything from Cloudflare's cache. This will force Cloudflare to fetch a fresh version of your site from your origin server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purga todo del caché de Cloudflare. Esto obligará a Cloudflare a buscar una versión nueva de su sitio desde su servidor de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videz tout du cache de Cloudflare. Cela forcera Cloudflare à récupérer une nouvelle version de votre site à partir de votre serveur d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutto dalla cache di Cloudflare. Ciò costringerà Cloudflare a recuperare una nuova versione del tuo sito dal tuo server di origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflareのキャッシュからすべてを削除します。これにより、Cloudflareはオリジンサーバーからサイトの新しいバージョンを強制的に取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare 캐시에서 모든 것을 제거하세요. 이렇게 하면 Cloudflare가 원본 서버에서 사이트의 새로운 버전을 가져오게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpe tudo do cache do Cloudflare. Isso forçará a Cloudflare a buscar uma nova versão do seu site no servidor de origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистите все из кеша Cloudflare. Это заставит Cloudflare получить свежую версию вашего сайта с исходного сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Cloudflare 缓存中的所有内容。这将强制 Cloudflare 从源服务器获取您网站的最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Cloudflare 快取中的所有内容。这将强制 Cloudflare 從源服务器获取您網站的最新版本。"
          }
        }
      }
    },
