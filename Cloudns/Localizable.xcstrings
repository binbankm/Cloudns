    "Cloudflare wirefilter expression defining which incoming requests trigger redirection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare wirefilter expression defining which incoming requests trigger redirection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于指定触发重定向跳转的请求匹配规则表达式（例如 URI 路径匹配）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
