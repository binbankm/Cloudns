    "Zero Trust Access secures self-hosted and SaaS applications with identity-driven policies.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل خدمة Zero Trust Access على تأمين التطبيقات ذاتية الاستضافة وتطبيقات SaaS من خلال سياسات تعتمد على الهوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access sichert selbst gehostete und SaaS-Anwendungen mit identitätsgesteuerten Richtlinien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access secures self-hosted and SaaS applications with identity-driven policies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Trust Access protege las aplicaciones SaaS y autohospedadas con políticas basadas en identidad."
          }
        },
        "fr": {
