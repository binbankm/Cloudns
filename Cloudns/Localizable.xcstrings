    "All diagnostics queries run directly from your device or Cloudflare's 1.1.1.1 edge network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All diagnostics queries run directly from your device or Cloudflare's 1.1.1.1 edge network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有诊断查询均直接从您的设备或 Cloudflare 1.1.1.1 边缘网络运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有诊断查询均直接從您的设備或 Cloudflare 1.1.1.1 边缘網路运行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての診断クエリは、デバイスまたはCloudflareの1.1.1.1エッジネットワークから直接実行されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Diagnoseabfragen werden direkt von Ihrem Gerät oder dem Edge-Netzwerk 1.1.1.1 von Cloudflare ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les requêtes de diagnostic s'exécutent directement à partir de votre appareil ou du réseau périphérique 1.1.1.1 de Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las consultas de diagnóstico se ejecutan directamente desde su dispositivo o la red perimetral 1.1.1.1 de Cloudflare."
          }
