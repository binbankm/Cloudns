    "Removing this site will immediately delete all its configuration and data from Cloudflare. This action cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستؤدي إزالة هذا الموقع إلى حذف جميع التكوينات والبيانات الخاصة به على الفور من Cloudflare. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Entfernen dieser Site werden sofort alle ihre Konfigurationen und Daten aus Cloudflare gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing this site will immediately delete all its configuration and data from Cloudflare. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
