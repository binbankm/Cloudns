    "Are you sure you want to clear cached network responses and temporary storage?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to clear cached network responses and temporary storage?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要清除本地已缓存的 API 请求响应与临时文件吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認要清除本地已快取的 API 請求响應与临時文件吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたネットワーク応答と一時ストレージをクリアしてもよろしいですか?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie zwischengespeicherte Netzwerkantworten und temporären Speicher löschen möchten?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir effacer les réponses réseau mises en cache et le stockage temporaire ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea borrar las respuestas de red almacenadas en caché y el almacenamiento temporal?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 네트워크 응답과 임시 저장소를 지우시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja limpar as respostas de rede em cache e o armazenamento temporário?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi cancellare le risposte di rete memorizzate nella cache e l'archivio temporaneo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите очистить кэшированные сетевые ответы и временное хранилище?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد مسح استجابات الشبكة المخزنة مؤقتًا والتخزين المؤقت؟"
          }
        }
      }
    },
    "Are you sure you want to delete %@ '%@'?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
