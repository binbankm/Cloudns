    "Roll back to any previous deployment to instantly restore Worker code and configuration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارجع إلى أي عملية نشر سابقة لاستعادة رمز العامل وتكوينه على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie ein Rollback zu einer vorherigen Bereitstellung durch, um den Worker-Code und die Worker-Konfiguration sofort wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll back to any previous deployment to instantly restore Worker code and configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrese a cualquier implementación anterior para restaurar instantáneamente el código y la configuración del trabajador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à tout déploiement précédent pour restaurer instantanément le code et la configuration de Worker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a qualsiasi distribuzione precedente per ripristinare immediatamente il codice e la configurazione del lavoratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のデプロイメントにロールバックすると、ワーカーのコードと構成が即座に復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 배포로 롤백하여 작업자 코드 및 구성을 즉시 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverta para qualquer implantação anterior para restaurar instantaneamente o código e a configuração do Worker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откатитесь к любому предыдущему развертыванию, чтобы мгновенно восстановить код и конфигурацию Worker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回滚到任意历史部署版本，即时恢复 Worker 的代码和配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回滚到任意历史部署版本，即時恢復 Worker 的代碼和設定。"
          }
        }
      }
    },
