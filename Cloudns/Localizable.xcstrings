          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドから戻るときにアプリのロックを解除するには、Face ID または Touch ID が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID oder Touch ID erfordern, um die App zu entsperren, wenn Sie aus dem Hintergrund zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Face ID ou Touch ID pour déverrouiller l'application lorsque vous revenez de l'arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Face ID o Touch ID para desbloquear la aplicación cuando regresas del fondo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 돌아올 때 앱을 잠금 해제하려면 Face ID 또는 Touch ID가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
