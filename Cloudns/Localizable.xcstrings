    "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن عرض متغيرات النص العادي مباشرة. يتم تشفير المتغيرات السرية وإخفائها للأمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klartextvariablen können direkt angezeigt werden. Geheime Variablen werden aus Sicherheitsgründen verschlüsselt und maskiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security."
          }
