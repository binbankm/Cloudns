    "Hides specific page content from suspicious visitors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides specific page content from suspicious visitors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向可疑访问者隐藏特定的页面内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向可疑访问者隱藏特定的頁面内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定のページのコンテンツを不審な訪問者から隠します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versteckt bestimmte Seiteninhalte vor verdächtigen Besuchern."
          }
        },
        "fr": {
