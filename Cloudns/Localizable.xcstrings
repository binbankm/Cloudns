    "How long a visitor is allowed access after successfully completing a challenge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة المسموح بها للزائر بالوصول بعد إكمال التحدي بنجاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ein Besucher nach erfolgreichem Abschluss einer Herausforderung Zutritt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a visitor is allowed access after successfully completing a challenge."
          }
        },
        "es": {
