    "Instances are spun up on-demand at the edge nearest to incoming coordination requests." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم نسج المثيلات عند الطلب عند الحافة الأقرب إلى طلبات التنسيق الواردة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instanzen werden bei Bedarf an der Edge hochgefahren, die eingehenden Koordinationsanfragen am nächsten liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instances are spun up on-demand at the edge nearest to incoming coordination requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instancias se activan según demanda en el borde más cercano a las solicitudes de coordinación entrantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les instances sont lancées à la demande à la périphérie la plus proche des demandes de coordination entrantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le istanze vengono avviate su richiesta all'edge più vicino alle richieste di coordinamento in entrata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスタンスは、受信した調整リクエストに最も近いエッジでオンデマンドでスピンアップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인스턴스는 들어오는 조정 요청에 가장 가까운 엣지에서 온디맨드 방식으로 회전됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As instâncias são geradas sob demanda na borda mais próxima das solicitações de coordenação recebidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экземпляры разворачиваются по требованию на периферии, ближайшей к входящим запросам на координацию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实例会在最靠近传入协调请求的边缘按需启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "實例會在最靠近傳入协調請求的边缘按需啟動。"
          }
        }
      }
    },
    "Instant one-tap access to DoH Dig, Trace Route, CF Status, and IP Ranges." : {
