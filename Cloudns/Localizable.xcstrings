    "Hyperdrive accelerates database queries from Workers to existing regional databases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive accelerates database queries from Workers to existing regional databases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive 加速从 Workers 到现有区域数据库的查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive 加速從 Workers 到現有区域數据库的查询。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive は、ワーカーから既存の地域データベースへのデータベース クエリを高速化します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive beschleunigt Datenbankabfragen von Workern an bestehende regionale Datenbanken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive accélère les requêtes de base de données des Workers vers les bases de données régionales existantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive acelera las consultas de bases de datos de los trabajadores a bases de datos regionales existentes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive는 작업자에서 기존 지역 데이터베이스로의 데이터베이스 쿼리를 가속화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hyperdrive acelera consultas de banco de dados de Workers para bancos de dados regionais existentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive accelera le query del database dai Worker ai database regionali esistenti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyperdrive ускоряет запросы к базам данных от Workers к существующим региональным базам данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Hyperdrive على تسريع استعلامات قاعدة البيانات من العمال إلى قواعد البيانات الإقليمية الموجودة."
          }
        }
      }
    },
