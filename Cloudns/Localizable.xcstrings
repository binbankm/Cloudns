    "Allows browsers to access HTTP URIs over an encrypted TLS channel.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للمتصفحات بالوصول إلى عناوين URL لـ HTTP عبر قناة TLS مشفرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Browsern den Zugriff auf HTTP-URIs über einen verschlüsselten TLS-Kanal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows browsers to access HTTP URIs over an encrypted TLS channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los navegadores acceder a URI HTTP a través de un canal TLS cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux navigateurs d'accéder aux URI HTTP via un canal TLS crypté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente ai browser di accedere agli URI HTTP su un canale TLS crittografato."
          }
