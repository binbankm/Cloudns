    "Instantly toggle Under Attack Mode, orchestrate WAF firewall rules, and fend off DDoS threats.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتبديل على الفور ضمن وضع الهجوم، وقم بتنسيق قواعد جدار الحماية WAF، ودرء تهديدات DDoS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
