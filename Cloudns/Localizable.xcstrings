    "Configure CDN edge acceleration and asset optimizations for faster page loads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 CDN 边缘加速与静态资源优化，提升页面加载速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 CDN 边缘加速与静態资源优化，提升頁面加載速度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CDN エッジ アクセラレーションとアセットの最適化を構成して、ページの読み込みを高速化します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie CDN-Edge-Beschleunigung und Asset-Optimierungen für schnellere Seitenladevorgänge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez l'accélération CDN Edge et les optimisations des actifs pour des chargements de pages plus rapides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure la aceleración perimetral de CDN y las optimizaciones de activos para cargas de páginas más rápidas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 페이지 로드를 위해 CDN 에지 가속화 및 자산 최적화를 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure a aceleração de borda do CDN e as otimizações de ativos para carregamentos de página mais rápidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura l'accelerazione edge della CDN e le ottimizzazioni delle risorse per caricamenti delle pagine più rapidi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте периферийное ускорение CDN и оптимизацию ресурсов для более быстрой загрузки страниц."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين تسريع حافة CDN وتحسينات الأصول لتحميل الصفحات بشكل أسرع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure CDN edge acceleration and asset optimizations for faster page loads."
          }
        }
      }
    },
    "Configure TLS versions and opportunistic encryption features for legacy or specialized clients.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure TLS versions and opportunistic encryption features for legacy or specialized clients."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为旧版或专用客户端配置 TLS 版本和机会性加密功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為旧版或专用客户端設定 TLS 版本和机會性加密功能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "従来のクライアントまたは特殊なクライアント向けに TLS バージョンと日和見暗号化機能を構成します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie TLS-Versionen und opportunistische Verschlüsselungsfunktionen für ältere oder spezialisierte Clients."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les versions TLS et les fonctionnalités de chiffrement opportunistes pour les clients existants ou spécialisés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure versiones de TLS y funciones de cifrado oportunistas para clientes heredados o especializados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레거시 또는 특수 클라이언트에 대한 TLS 버전 및 기회주의적 암호화 기능을 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure versões TLS e recursos de criptografia oportunistas para clientes legados ou especializados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura versioni TLS e funzionalità di crittografia opportunistiche per client legacy o specializzati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте версии TLS и гибкие функции шифрования для устаревших или специализированных клиентов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين إصدارات TLS وميزات التشفير الانتهازية للعملاء القدامى أو المتخصصين."
          }
        }
      }
    },
    "Configure URL forwarding and dynamic 301/302 redirects at the Cloudflare edge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure URL forwarding and dynamic 301/302 redirects at the Cloudflare edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cloudflare 边缘节点配置 URL 转发与动态 301/302 重定向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cloudflare 边缘节點設定 URL 轉發与動態 301/302 重定向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudflareエッジでURL転送と動的301/302リダイレクトを構成します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie URL-Weiterleitung und dynamische 301/302-Weiterleitungen am Cloudflare-Edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le transfert d'URL et les redirections dynamiques 301/302 à la périphérie de Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure el reenvío de URL y los redireccionamientos dinámicos 301/302 en el borde de Cloudflare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 에지에서 URL 전달 및 동적 301/302 리디렉션을 구성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o encaminhamento de URL e os redirecionamentos 301/302 dinâmicos na borda da Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura l'inoltro URL e i reindirizzamenti dinamici 301/302 sul perimetro Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте переадресацию URL-адресов и динамические перенаправления 301/302 на границе Cloudflare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين إعادة توجيه عنوان URL وعمليات إعادة التوجيه الديناميكية 301/302 على حافة Cloudflare."
          }
        }
      }
    },
    "Configure URL redirection rules to permanently (301) or temporarily (302) redirect incoming visitors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure URL redirection rules to permanently (301) or temporarily (302) redirect incoming visitors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 URL 重定向规则，对访客进行永久 (301) 或临时 (302) 页面重定向跳转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 URL 重定向規則，对访客进行永久 (301) 或临時 (302) 頁面重定向跳轉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL リダイレクト ルールを構成して、受信訪問者を永続的 (301) または一時的 (302) リダイレクトします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie URL-Umleitungsregeln, um eingehende Besucher dauerhaft (301) oder vorübergehend (302) umzuleiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les règles de redirection d'URL pour rediriger définitivement (301) ou temporairement (302) les visiteurs entrants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure reglas de redireccionamiento de URL para redirigir permanentemente (301) o temporalmente (302) a los visitantes entrantes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어오는 방문자를 영구적으로(301) 또는 일시적으로(302) 리디렉션하도록 URL 리디렉션 규칙을 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure regras de redirecionamento de URL para redirecionar permanentemente (301) ou temporariamente (302) os visitantes recebidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura le regole di reindirizzamento URL per reindirizzare in modo permanente (301) o temporaneo (302) i visitatori in entrata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте правила перенаправления URL-адресов для постоянного (301) или временного (302) перенаправления входящих посетителей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين قواعد إعادة توجيه عنوان URL لإعادة توجيه الزوار القادمين بشكل دائم (301) أو مؤقتًا (302)."
          }
        }
      }
    },
    "Configure URL rewrites and request/response header transformations at the edge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure URL rewrites and request/response header transformations at the edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边缘配置 URL 重写以及请求/响应标头转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在边缘設定 URL 重写以及請求/响應標頭轉换。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 書き換えとリクエスト/レスポンス ヘッダー変換をエッジで構成します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie URL-Umschreibungen und Anforderungs-/Antwort-Header-Transformationen am Edge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les réécritures d'URL et les transformations d'en-tête de demande/réponse à la périphérie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure reescrituras de URL y transformaciones de encabezados de solicitud/respuesta en el borde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에지에서 URL 재작성 및 요청/응답 헤더 변환을 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure reescritas de URL e transformações de cabeçalho de solicitação/resposta na borda."
          }
        },
