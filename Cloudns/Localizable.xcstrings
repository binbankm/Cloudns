    "Quickly configure enterprise email, web hosting, and security policies without typing record values.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速配置企业邮箱、网站托管和安全策略，无需手动输入复杂的记录值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速設定企业邮箱、網站托管和安全性策略，無需手動輸入復杂的记录值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコード値を入力することなく、エンタープライズ電子メール、Web ホスティング、セキュリティ ポリシーをすばやく構成できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie schnell Unternehmens-E-Mail-, Webhosting- und Sicherheitsrichtlinien, ohne Datensatzwerte einzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez rapidement les politiques de messagerie, d'hébergement Web et de sécurité de l'entreprise sans saisir de valeurs d'enregistrement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure rápidamente las políticas de seguridad, alojamiento web y correo electrónico empresarial sin escribir valores de registro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드 값을 입력하지 않고도 기업 이메일, 웹 호스팅, 보안 정책을 빠르게 구성할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure rapidamente e-mail corporativo, hospedagem na Web e políticas de segurança sem digitar valores de registro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura rapidamente la posta elettronica aziendale, l'hosting web e le policy di sicurezza senza digitare valori di record."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро настраивайте корпоративную электронную почту, веб-хостинг и политики безопасности, не вводя значения записей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين البريد الإلكتروني للمؤسسة واستضافة الويب وسياسات الأمان بسرعة دون كتابة قيم السجلات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly configure enterprise email, web hosting, and security policies without typing record values."
          }
        }
      }
    },
    "Quickly enable Under Attack Mode, manage WAF, and tweak security levels when you need it most.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly enable Under Attack Mode, manage WAF, and tweak security levels when you need it most."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速开启 Under Attack 模式，管理 WAF，在最需要时调整安全级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速開啟 Under Attack 模式，管理 WAF，在最需要時調整安全性級別。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も必要なときに、攻撃中モードをすばやく有効にし、WAF を管理し、セキュリティ レベルを調整します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie schnell den Under Attack-Modus, verwalten Sie die WAF und passen Sie die Sicherheitsstufen an, wenn Sie es am meisten brauchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez rapidement le mode Under Attack, gérez le WAF et ajustez les niveaux de sécurité lorsque vous en avez le plus besoin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite rápidamente el modo bajo ataque, administre WAF y modifique los niveles de seguridad cuando más lo necesite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack 모드를 빠르게 활성화하고, WAF를 관리하고, 가장 필요할 때 보안 수준을 조정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative rapidamente o modo sob ataque, gerencie o WAF e ajuste os níveis de segurança quando você mais precisar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita rapidamente la modalità Sotto attacco, gestisci WAF e modifica i livelli di sicurezza quando ne hai più bisogno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро включите режим атаки, управляйте WAF и настраивайте уровни безопасности, когда вам это нужно больше всего."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمكين وضع الهجوم بسرعة، وإدارة WAF، وتعديل مستويات الأمان عندما تكون في أمس الحاجة إليها."
          }
        }
      }
    },
