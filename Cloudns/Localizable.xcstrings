    "Paste the contents of your certificate file (.pem or .crt), including the BEGIN CERTIFICATE and END CERTIFICATE tags.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the contents of your certificate file (.pem or .crt), including the BEGIN CERTIFICATE and END CERTIFICATE tags."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴证书文件 (.pem 或 .crt) 的内容，包括 BEGIN CERTIFICATE 和 END CERTIFICATE 标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴證书文件 (.pem 或 .crt) 的内容，包括 BEGIN CERTIFICATE 和 END CERTIFICATE 標签。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN CERTIFICATE タグと END CERTIFICATE タグを含む、証明書ファイル (.pem または .crt) の内容を貼り付けます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Inhalt Ihrer Zertifikatsdatei (.pem oder .crt) ein, einschließlich der Tags BEGIN CERTIFICATE und END CERTIFICATE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le contenu de votre fichier de certificat (.pem ou .crt), y compris les balises BEGIN CERTIFICATE et END CERTIFICATE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue el contenido de su archivo de certificado (.pem o .crt), incluidas las etiquetas BEGIN CERTIFICATE y END CERTIFICATE."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN CERTIFICATE 및 END CERTIFICATE 태그를 포함하여 인증서 파일(.pem 또는 .crt)의 내용을 붙여넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o conteúdo do seu arquivo de certificado (.pem ou .crt), incluindo as tags BEGIN CERTIFICATE e END CERTIFICATE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il contenuto del file del certificato (.pem o .crt), inclusi i tag BEGIN CERTIFICATE e END CERTIFICATE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте содержимое файла сертификата (.pem или .crt), включая теги BEGIN CERTIFICATE и END CERTIFICATE."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق محتويات ملف الشهادة (.pem أو .crt)، بما في ذلك علامتي BEGIN CERTIFICATE وEND CERTIFICATE."
          }
        }
      }
    },
    "Paste the contents of your private key file (.key), including the BEGIN PRIVATE KEY and END PRIVATE KEY tags.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the contents of your private key file (.key), including the BEGIN PRIVATE KEY and END PRIVATE KEY tags."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴私钥文件 (.key) 的内容，包括 BEGIN PRIVATE KEY 和 END PRIVATE KEY 标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴私钥文件 (.key) 的内容，包括 BEGIN PRIVATE KEY 和 END PRIVATE KEY 標签。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN PRIVATE KEY タグと END PRIVATE KEY タグを含む、秘密キー ファイル (.key) の内容を貼り付けます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Inhalt Ihrer privaten Schlüsseldatei (.key) ein, einschließlich der Tags BEGIN PRIVATE KEY und END PRIVATE KEY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le contenu de votre fichier de clé privée (.key), y compris les balises BEGIN PRIVATE KEY et END PRIVATE KEY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue el contenido de su archivo de clave privada (.key), incluidas las etiquetas BEGIN PRIVATE KEY y END PRIVATE KEY."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN PRIVATE KEY 및 END PRIVATE KEY 태그를 포함하여 개인 키 파일(.key)의 내용을 붙여넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o conteúdo do seu arquivo de chave privada (.key), incluindo as tags BEGIN PRIVATE KEY e END PRIVATE KEY."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il contenuto del file della chiave privata (.key), inclusi i tag BEGIN PRIVATE KEY e END PRIVATE KEY."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте содержимое файла закрытого ключа (.key), включая теги BEGIN PRIVATE KEY и END PRIVATE KEY."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق محتويات ملف المفتاح الخاص (.key)، بما في ذلك علامتي BEGIN PRIVATE KEY وEND PRIVATE KEY."
          }
        }
      }
    },
