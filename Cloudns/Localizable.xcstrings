    "Cloudflare will send a verification email with an activation link to this address. You must verify it before forwarding emails to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يرسل Cloudflare رسالة تحقق عبر البريد الإلكتروني تحتوي على رابط التنشيط إلى هذا العنوان. يجب عليك التحقق منه قبل إعادة توجيه رسائل البريد الإلكتروني إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare sendet eine Bestätigungs-E-Mail mit einem Aktivierungslink an diese Adresse. Sie müssen es überprüfen, bevor Sie E-Mails an es weiterleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare will send a verification email with an activation link to this address. You must verify it before forwarding emails to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare enviará un correo electrónico de verificación con un enlace de activación a esta dirección. Debe verificarlo antes de reenviarle correos electrónicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare enverra un e-mail de vérification avec un lien d'activation à cette adresse. Vous devez le vérifier avant de lui transmettre des e-mails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare invierà un'e-mail di verifica con un collegamento di attivazione a questo indirizzo. È necessario verificarlo prima di inoltrargli e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、アクティベーションリンクを含む確認メールをこのアドレスに送信します。電子メールを転送する前に、それを確認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 활성화 링크가 포함된 확인 이메일을 이 주소로 보냅니다. 이메일을 전달하기 전에 확인해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare enviará um e-mail de verificação com um link de ativação para este endereço. Você deve verificá-lo antes de encaminhar e-mails para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare отправит на этот адрес электронное письмо с подтверждением и ссылкой для активации. Вы должны подтвердить его, прежде чем пересылать на него электронные письма."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 将向该邮箱发送一封包含激活链接的验证邮件，在转发邮件前必须先完成验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 将向该邮箱發送一封包含激活链接的驗證邮件，在轉發邮件前必须先完成驗證。"
          }
        }
      }
    },
    "Cloudflare wirefilter expression defining matching incoming traffic.": {
