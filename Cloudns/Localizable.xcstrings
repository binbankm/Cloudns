        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャレンジが正常に完了した後、訪問者がアクセスを許可される期間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문자가 챌린지를 성공적으로 완료한 후 액세스가 허용되는 기간입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
