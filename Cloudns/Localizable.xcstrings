    "Speed up HTTPS page load times by applying modern Brotli compression." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسريع أوقات تحميل صفحات HTTPS باستخدام ضغط Brotli الحديث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschleunigt Ladezeiten von HTTPS-Seiten durch moderne Brotli-Komprimierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed up HTTPS page load times by applying modern Brotli compression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelera los tiempos de carga de páginas HTTPS aplicando la moderna compresión Brotli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélérez le chargement des pages HTTPS grâce à la compression moderne Brotli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocizza i tempi di caricamento HTTPS applicando la moderna compressione Brotli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のBrotli圧縮を適用して、HTTPSページの読み込み時間を短縮します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 Brotli 압축을 적용하여 HTTPS 페이지 로딩 시간을 단축합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelere os tempos de carregamento de páginas HTTPS aplicando a compactação Brotli moderna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускорьте загрузку HTTPS-страниц с помощью современного сжатия Brotli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用现代高效的 Brotli 压缩算法，显著加快 HTTPS 页面传输与加载速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用現代高效的 Brotli 壓縮演算法，顯著加快 HTTPS 頁面傳輸與載入速度。"
          }
        }
      }
    },
    "Speed up page load times for your visitor's HTTPS traffic by applying Brotli compression." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتسريع أوقات تحميل الصفحة لحركة مرور HTTPS الخاصة بزائرك من خلال تطبيق ضغط Brotli."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschleunigen Sie die Seitenladezeiten für den HTTPS-Verkehr Ihrer Besucher, indem Sie die Brotli-Komprimierung anwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed up page load times for your visitor's HTTPS traffic by applying Brotli compression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelere los tiempos de carga de la página para el tráfico HTTPS de sus visitantes aplicando la compresión Brotli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélérez les temps de chargement des pages pour le trafic HTTPS de vos visiteurs en appliquant la compression Brotli."
          }
        },
        "it" : {
          "stringUnit" : {
