    "Quickly enable Under Attack Mode, manage WAF, and tweak security levels when you need it most." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتمكين وضع الهجوم بسرعة، وإدارة WAF، وتعديل مستويات الأمان عندما تكون في أمس الحاجة إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie schnell den Under Attack-Modus, verwalten Sie die WAF und passen Sie die Sicherheitsstufen an, wenn Sie es am meisten brauchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quickly enable Under Attack Mode, manage WAF, and tweak security levels when you need it most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite rápidamente el modo bajo ataque, administre WAF y modifique los niveles de seguridad cuando más lo necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez rapidement le mode Under Attack, gérez le WAF et ajustez les niveaux de sécurité lorsque vous en avez le plus besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita rapidamente la modalità Sotto attacco, gestisci WAF e modifica i livelli di sicurezza quando ne hai più bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も必要なときに、攻撃中モードをすばやく有効にし、WAF を管理し、セキュリティ レベルを調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under Attack 모드를 빠르게 활성화하고, WAF를 관리하고, 가장 필요할 때 보안 수준을 조정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative rapidamente o modo sob ataque, gerencie o WAF e ajuste os níveis de segurança quando você mais precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстро включите режим атаки, управляйте WAF и настраивайте уровни безопасности, когда вам это нужно больше всего."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
