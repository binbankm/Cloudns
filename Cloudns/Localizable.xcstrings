    "Are you sure you want to delete '%@'? Traffic to %@ will no longer be protected by Zero Trust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete '%1$@'? Traffic to %2$@ will no longer be protected by Zero Trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除 '%1$@' 吗？指向 %2$@ 的流量将不再受 Zero Trust 保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認要刪除 '%1$@' 吗？指向 %2$@ 的流量将不再受 Zero Trust 保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' を削除してもよろしいですか? %2$@ へのトラフィックはゼロ トラストによって保護されなくなります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie „%1$@“ löschen möchten? Der Datenverkehr zu %2$@ wird nicht mehr durch Zero Trust geschützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer « %1$@ » ? Le trafic vers %2$@ ne sera plus protégé par Zero Trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar '%1$@'? El tráfico a %2$@ ya no estará protegido por Zero Trust."
          }
        },
        "ko": {
