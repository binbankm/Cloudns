          "stringUnit": {
            "state": "translated",
            "value": "Controla los encabezados geográficos y las versiones de protocolo edge a origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez les en-têtes géographiques et les versions de protocole edge-vers-origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le intestazioni geografiche e le versioni di protocollo edge-to-origin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地理情報ヘッダーとエッジ・オリジン間のプロトコルバージョンを制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지리적 위치 헤더 및 엣지와 원본 서버 간의 프로토콜 버전을 제어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle cabeçalhos geográficos e versões de protocolo do edge para a origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление географическими заголовками и версиями протоколов между узлом и источником."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制地理位置请求头与边缘到源站的通信协议版本。"
