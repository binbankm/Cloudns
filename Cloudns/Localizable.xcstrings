      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests matching this wirefilter expression will execute the selected snippet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
