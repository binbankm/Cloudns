    "Namespaces are globally distributed Key-Value stores." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحات الأسماء هي مخازن ذات قيمة رئيسية موزعة عالميًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespaces sind global verteilte Schlüsselwertspeicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespaces are globally distributed Key-Value stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los espacios de nombres son almacenes de valores clave distribuidos globalmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les espaces de noms sont des magasins de valeurs-clés distribués à l’échelle mondiale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli spazi dei nomi sono archivi di valori-chiave distribuiti a livello globale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前空間は、グローバルに分散された Key-Value ストアです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네임스페이스는 전역적으로 분산된 키-값 저장소입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namespaces são armazenamentos de valores-chave distribuídos globalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пространства имен — это глобально распределенные хранилища ключей и значений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命名空间是全球分布的键值存储。"
