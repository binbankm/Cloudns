    "Comma or newline separated list of hostnames (e.g. example.com, app.example.com).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة بأسماء المضيفين مفصولة بفواصل أو أسطر جديدة (مثل example.com, app.example.com)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Kommas oder Zeilenumbrüche getrennte Liste von Hostnamen (z. B. example.com, app.example.com)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma or newline separated list of hostnames (e.g. example.com, app.example.com)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de nombres de host separados por comas o saltos de línea (ej. example.com, app.example.com)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste de noms d'hôtes séparés par des virgules ou des retours à la ligne (ex. example.com, app.example.com)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenco di nomi host separati da virgole o a capo (es. example.com, app.example.com)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマまたは改行で区切られたホスト名のリスト (例: example.com, app.example.com)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표 또는 줄바꿈으로 구분된 호스트 이름 목록(예: example.com, app.example.com)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de nomes de host separados por vírgula ou quebra de linha (ex.: example.com, app.example.com)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список имен хостов, разделенных запятыми или переносами строк (например, example.com, app.example.com)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
