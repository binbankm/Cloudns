          }
        }
      }
    },
    "Tap any deployment to inspect the full build pipeline, stage durations, and console logs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي عملية نشر لفحص مسار البناء الكامل ومدة المراحل وسجلات وحدة التحكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Bereitstellung, um die gesamte Build-Pipeline, Phasendauern und Konsolenprotokolle anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
