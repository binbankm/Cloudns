    "Under Attack Mode executes JS challenges for every visitor to stop active DDoS attacks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينفذ وضع Under Attack Mode تحديات JS لكل زائر لإيقاف هجمات DDoS النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der „Under Attack“-Modus führt JS-Challenges für jeden Besucher aus, um aktive DDoS-Angriffe zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack Mode executes JS challenges for every visitor to stop active DDoS attacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Under Attack ejecuta desafíos JS para cada visitante para detener ataques DDoS activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Under Attack exécute des défis JS pour chaque visiteur afin d'arrêter les attaques DDoS actives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Under Attack esegue verifiche JS per ogni visitatore per bloccare gli attacchi DDoS attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack モードは、すべてのアクティブな訪問者に対して JS チャレンジを実行し、アクティブな DDoS 攻撃を阻止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack 모드는 모든 방문자에 대해 JS 챌린지를 실행하여 활성 DDoS 공격을 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Under Attack executa desafios JS para cada visitante para impedir ataques DDoS ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Под атакой» выполняет JS-проверки для каждого посетителя, чтобы остановить активные DDoS-атаки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack 模式为每位访问者执行 JS 质询，以抵御正在进行的 DDoS 攻击。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Attack 模式為每位訪客執行 JS 驗證，以抵禦正在進行的 DDoS 攻擊。"
          }
        }
      }
    },
