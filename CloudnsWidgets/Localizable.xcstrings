    "Detects and challenges automated scrapers and malicious crawlers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف ويتحدى برامج التجريد الآلية وبرامج الزحف الخبيثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt und fordert automatisierte Scraper und bösartige Crawler heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects and challenges automated scrapers and malicious crawlers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y desafía a scrapers automatizados y rastreadores maliciosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte et défie les scrapers automatisés et les robots d'indexation malveillants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva e lancia verifiche contro scraper automatizzati e crawler dannosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動スクレイパーや悪意のあるクローラーを検出してチャレンジします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화된 스크레이퍼 및 악성 크롤러를 감지하고 챌린지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta e desafia scrapers automatizados e rastreadores maliciosos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаруживает и проверяет автоматических скраперов и вредоносных ботов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测并质询自动化抓取工具和恶意爬虫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測並驗證自動化抓取工具和惡意網路爬蟲。"
          }
        }
      }
    },
    "Detects and challenges known bots and crawlers. Recommended for most sites.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتشف ويتحدى الروبوتات والزواحف المعروفة. يوصى به لمعظم المواقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt und fordert bekannte Bots und Crawler heraus. Empfohlen für die meisten Websites."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detects and challenges known bots and crawlers. Recommended for most sites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y desafía robots y rastreadores conocidos. Recomendado para la mayoría de los sitios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte et défie les robots et robots d'exploration connus. Recommandé pour la plupart des sites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva e sfida bot e crawler conosciuti. Consigliato per la maggior parte dei siti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既知のボットやクローラーを検出し、挑戦します。ほとんどのサイトで推奨されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 봇과 크롤러를 탐지하고 문제를 제기합니다. 대부분의 사이트에 권장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta e desafia bots e rastreadores conhecidos. Recomendado para a maioria dos sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаруживает и бросает вызов известным ботам и сканерам. Рекомендуется для большинства сайтов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测并质询已知的机器人和爬虫。推荐大多数网站使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢測并質詢已知的机器人和爬虫。推荐大多數網站使用。"
          }
        }
      }
    },
    "Determine how much of your website's static content you want Cloudflare to cache at the edge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مقدار المحتوى الثابت لموقعك الذي تريد من Cloudflare تخزينه مؤقتًا على الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmen Sie, wie viel vom statischen Inhalt Ihrer Website Cloudflare am Edge zwischenspeichern soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine how much of your website's static content you want Cloudflare to cache at the edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina qué cantidad del contenido estático de tu sitio web deseas que Cloudflare almacene en caché en el perímetro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déterminez la quantité de contenu statique de votre site Web que vous souhaitez que Cloudflare mette en cache en périphérie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina quanto contenuto statico del tuo sito web desideri che Cloudflare memorizzi nella cache perimetrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare がエッジでキャッシュする Web サイトの静的コンテンツの量を決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare가 에지에서 캐시할 웹사이트의 정적 콘텐츠 양을 결정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine quanto do conteúdo estático do seu site você deseja que a Cloudflare armazene em cache na borda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите, какую часть статического контента вашего веб-сайта Cloudflare должен кэшировать на Edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定您希望 Cloudflare 在边缘缓存多少网站静态内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定您希望 Cloudflare 在邊緣快取多少網站靜態內容。"
          }
        }
      }
    },
    "Determine how much of your website's static content you want Cloudflare to cache.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مقدار المحتوى الثابت لموقع الويب الخاص بك الذي تريد من Cloudflare تخزينه مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmen Sie, wie viel statischen Inhalt Ihrer Website Cloudflare zwischenspeichern soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine how much of your website's static content you want Cloudflare to cache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine qué parte del contenido estático de su sitio web desea que Cloudflare almacene en caché."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déterminez la quantité de contenu statique de votre site Web que vous souhaitez que Cloudflare mette en cache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
