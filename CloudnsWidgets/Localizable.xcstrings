          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à la version #%2$lld pour « %1$@ » ? Le trafic sera immédiatement redirigé vers cette version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguire il rollback di «%1$@» alla versione #%2$lld? Il traffico verrà immediatamente instradato a questa versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」をバージョン #%2$lld にロールバックしてもよいですか？トラフィックはすぐにこのデプロイバージョンにルーティングされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@'을(를) 버전 #%2$lld로 롤백하시겠습니까? 트래픽이 즉시 이 배포 버전으로 라우팅됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverter «%1$@» para a versão #%2$lld? O tráfego será imediatamente roteado para esta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откатить «%1$@» до версии #%2$lld? Трафик будет немедленно перенаправлен на эту версию развёртывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要将“%1$@”回滚至版本 #%2$lld 吗？流量将立即路由至该部署版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要將「%1$@」回滾至版本 #%2$lld 嗎？流量將立即路由至此部署版本。"
          }
        }
      }
    },
    "Are you sure you want to unbind %@ resource '%@' from %@?": {
