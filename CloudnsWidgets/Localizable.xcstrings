          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 프로덕션 Pages 트래픽이 이 기록 배포 빌드로 즉시 전환됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso mudará imediatamente o tráfego de suas páginas de produção para esta construção de implantação histórica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это немедленно переключит трафик ваших рабочих страниц на эту историческую сборку развертывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即将您的 Pages 生产环境流量切换到此历史部署版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即将您的 Pages 生产环境流量切换到此历史部署版本。"
          }
        }
      }
    },
