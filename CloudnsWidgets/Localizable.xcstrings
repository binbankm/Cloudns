        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を削除してもよいですか？%2$@ へのトラフィックは Zero Trust による保護がなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@'을(를) 삭제하시겠습니까? %2$@에 대한 트래픽이 Zero Trust 보호를 받지 않게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
