    "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم Cloudflare بتوقيع وإصدار شهادات حافة SSL/TLS مجانية لنطاقك ونطاقاتك الفرعية تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signiert und stellt automatisch kostenlose SSL/TLS-Edge-Zertifikate für Ihre Domain und Subdomains aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signs and issues free SSL/TLS edge certificates for your domain and subdomains automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma y emite certificados perimetrales SSL/TLS gratuitos para su dominio y subdominios automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare signe et émet automatiquement des certificats Edge SSL/TLS gratuits pour votre domaine et vos sous-domaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare firma ed emette automaticamente certificati edge SSL/TLS gratuiti per il tuo dominio e sottodomini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareは、ドメインとサブドメインの無料のSSL/TLSエッジ証明書に自動的に署名し、発行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare는 도메인과 하위 도메인에 대한 무료 SSL/TLS 에지 인증서를 자동으로 서명하고 발급합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cloudflare assina e emite certificados de borda SSL/TLS gratuitos para seu domínio e subdomínios automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare автоматически подписывает и выдает бесплатные пограничные сертификаты SSL/TLS для вашего домена и поддоменов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自动为您的域名及子域名签署并颁发免费的 SSL/TLS 边缘证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 自動為您的網域稱及子網域稱签署并颁發免费的 SSL/TLS 邊緣憑證。"
          }
        }
      }
    },
    "Cloudflare Snippets allow executing lightweight JavaScript logic on HTTP requests without full Workers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح Cloudflare Snippets بتنفيذ منطق JavaScript خفيف الوزن على طلبات HTTP بدون عمال كاملين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Snippets ermöglichen die Ausführung einfacher JavaScript-Logik auf HTTP-Anfragen ohne vollständige Worker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets allow executing lightweight JavaScript logic on HTTP requests without full Workers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos de Cloudflare permiten ejecutar lógica JavaScript liviana en solicitudes HTTP sin Workers completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits Cloudflare permettent d'exécuter une logique JavaScript légère sur les requêtes HTTP sans Workers complets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli snippet di Cloudflare consentono di eseguire una logica JavaScript leggera su richieste HTTP senza worker completi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare スニペットを使用すると、完全なWorkerを使用せずに HTTP リクエストで軽量の JavaScript ロジックを実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 코드 조각을 사용하면 전체 Worker 없이 HTTP 요청에서 경량 JavaScript 논리를 실행할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os snippets da Cloudflare permitem executar lógica JavaScript leve em solicitações HTTP sem trabalhadores completos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сниппеты Cloudflare позволяют выполнять упрощенную логику JavaScript по HTTP-запросам без полных рабочих процессов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets 允许在边缘 HTTP 请求处理链中执行亚毫秒级的极速微 JavaScript 逻辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Snippets 允許在邊緣 HTTP 請求處理链中执行亚毫秒級的極速微 JavaScript 逻辑。"
          }
        }
      }
    },
