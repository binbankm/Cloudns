    "Verifies if an IP address belongs to Cloudflare's official proxy edge CIDR network blocks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق مما إذا كان عنوان IP ينتمي إلى كتل شبكة CIDR الخاصة بوكيل حافة Cloudflare الرسمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüft, ob eine IP-Adresse zu den offiziellen Proxy-Edge-CIDR-Netzwerkblöcken von Cloudflare gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifies if an IP address belongs to Cloudflare's official proxy edge CIDR network blocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica si una dirección IP pertenece a los bloques de red CIDR perimetrales del proxy oficial de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie si une adresse IP appartient aux blocs réseau CIDR périphériques du proxy officiel de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se un indirizzo IP appartiene ai blocchi di rete CIDR perimetrali del proxy ufficiale di Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IP アドレスが Cloudflare の公式プロキシ エッジ CIDR ネットワーク ブロックに属しているかどうかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 주소가 Cloudflare의 공식 프록시 에지 CIDR 네트워크 블록에 속하는지 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se um endereço IP pertence aos blocos de rede CIDR de borda de proxy oficiais da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, принадлежит ли IP-адрес официальным сетевым блокам CIDR Edge Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证 IP 地址是否属于 Cloudflare 官方代理边缘 CIDR 网段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證 IP 位址是否屬於 Cloudflare 官方代理邊緣 CIDR 網段。"
          }
        }
      }
    },
    "Verify your identity to disable App Lock.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من هويتك لتعطيل قفل التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie Ihre Identität, um die App-Sperre zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to disable App Lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique su identidad para desactivar el bloqueo de aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité pour désactiver App Lock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la tua identità per disattivare Blocco app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリロックを無効にするには、本人確認を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 잠금을 비활성화하려면 신원을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade para desativar o App Lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите свою личность, чтобы отключить блокировку приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份以关闭应用锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身份以關闭應用鎖。"
          }
        }
      }
    },
