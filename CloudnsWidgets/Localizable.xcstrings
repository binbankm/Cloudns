    "Preload linked critical assets while server compiles response.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحميل الأصول الحيوية المرتبطة مسبقًا أثناء تجميع الخادم للاستجابة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfte kritische Assets vorab laden, während der Server die Antwort kompiliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preload linked critical assets while server compiles response."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precarga recursos críticos vinculados mientras el servidor compila la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préchargez les ressources critiques liées pendant que le serveur compile la réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precarica le risorse critiche collegate mentre il server compila la risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答をコンパイルしている間に、リンクされたクリティカル アセットを事前読み込みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답을 컴파일하는 동안 연결된 중요한 자산을 미리 로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-carregue ativos críticos vinculados enquanto o servidor compila a resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительно загружайте связанные критические ресурсы, пока сервер компилирует ответ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器编译响应时预加载链接的关键资产。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在伺服器編譯回應時預先載入連結的關鍵資產。"
          }
        }
      }
    },
