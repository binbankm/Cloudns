    "Durable Objects namespaces are created via Wrangler migrations inside your Worker code.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاء مساحات أسماء الكائنات المعمرة عبر عمليات ترحيل Wrangler داخل كود العامل الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langlebige Objekt-Namespaces werden über Wrangler-Migrationen innerhalb Ihres Worker-Codes erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable Objects namespaces are created via Wrangler migrations inside your Worker code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de nombres de Durable Objects se crean mediante migraciones de Wrangler dentro de su código de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de noms Durable Objects sont créés via des migrations Wrangler dans votre code Worker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli spazi dei nomi degli oggetti durevoli vengono creati tramite migrazioni Wrangler all'interno del codice di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable Objects 名前空間は、Worker コード内の Wrangler 移行によって作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지속성 개체 네임스페이스는 Worker 코드 내에서 Wrangler 마이그레이션을 통해 생성됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os namespaces de objetos duráveis ​​são criados por meio de migrações do Wrangler dentro do seu código Worker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пространства имен Durable Objects создаются посредством миграции Wrangler внутри вашего кода Worker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable Objects 命名空间需在 Worker 代码中通过 Wrangler 迁移创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Durable Objects 命名空間需在 Worker 程式碼中通過 Wrangler 迁移建立。"
          }
        }
      }
    },
