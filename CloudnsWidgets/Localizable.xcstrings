    "Authentication failed. Please verify your Cloudflare API Token or Global Key in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المصادقة. يرجى التحقق من رمز Cloudflare API أو المفتاح العام في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung fehlgeschlagen. Bitte überprüfen Sie Ihr Cloudflare-API-Token oder den globalen Schlüssel in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Please verify your Cloudflare API Token or Global Key in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación. Verifique su token de API de Cloudflare o clave global en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'authentification. Veuillez vérifier votre jeton d'API Cloudflare ou votre clé globale dans les paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita. Verifica il token API Cloudflare o la chiave globale nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました。設定で Cloudflare API トークンまたはグローバルキーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 실패했습니다. 설정에서 Cloudflare API 토큰 또는 글로벌 키를 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação. Verifique seu token de API ou chave global do Cloudflare nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка аутентификации. Проверьте токен API Cloudflare или глобальный ключ в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证失败。请在“设置”中验证您的 Cloudflare API 令牌或全局密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分驗證失敗。請在「設定」中驗證您的 Cloudflare API 權杖或全域金鑰。"
          }
        }
      }
