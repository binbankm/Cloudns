    "HTTP/2 and HTTP/3 (QUIC) drastically reduce page load latency and handshake round trips.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل HTTP/2 وHTTP/3 (QUIC) على تقليل وقت استجابة تحميل الصفحة وجولات المصافحة بشكل كبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 und HTTP/3 (QUIC) reduzieren die Latenz beim Laden von Seiten und Handshake-Roundtrips drastisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 and HTTP/3 (QUIC) drastically reduce page load latency and handshake round trips."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 y HTTP/3 (QUIC) reducen drásticamente la latencia de carga de la página y los viajes de ida y vuelta del protocolo de enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 et HTTP/3 (QUIC) réduisent considérablement la latence de chargement des pages et les allers-retours de négociation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 e HTTP/3 (QUIC) riducono drasticamente la latenza di caricamento della pagina e i round trip di handshake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 と HTTP/3 (QUIC) は、ページの読み込みレイテンシとハンドシェイクのラウンドトリップを大幅に短縮します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 및 HTTP/3(QUIC)은 페이지 로드 지연 시간과 핸드셰이크 왕복 횟수를 대폭 줄여줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 e HTTP/3 (QUIC) reduzem drasticamente a latência de carregamento da página e as viagens de ida e volta do handshake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 и HTTP/3 (QUIC) значительно сокращают задержку загрузки страниц и циклы рукопожатия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 和 HTTP/3 (QUIC) 可大幅减少页面加载延迟和握手往返次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP/2 和 HTTP/3 (QUIC) 可大幅減少頁面載入延遲和交握往返次數。"
          }
        }
      }
    },
