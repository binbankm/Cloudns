          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 수신 트래픽을 정의하는 Cloudflare wirefilter 표현식입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expressão wirefilter da Cloudflare que define o tráfego de entrada correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выражение проводного фильтра Cloudflare, определяющее соответствующий входящий трафик."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定义匹配入站流量的 Cloudflare 过滤表达式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定义匹配入站流量的 Cloudflare 過滤表达式。"
          }
        }
      }
    },
    "Cloudflare wirefilter expression defining which incoming requests trigger redirection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد تعبير Cloudflare wirefilter الطلبات الواردة التي تؤدي إلى إعادة التوجيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare-Wirefilter-Ausdruck, der definiert, welche eingehenden Anfragen eine Umleitung auslösen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare wirefilter expression defining which incoming requests trigger redirection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expresión de filtro de cable de Cloudflare que define qué solicitudes entrantes activan la redirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expression de wirefilter Cloudflare définissant quelles requêtes entrantes déclenchent la redirection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espressione wirefilter di Cloudflare che definisce quali richieste in entrata attivano il reindirizzamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの受信リクエストがリダイレクトをトリガーするかを定義する Cloudflare ワイヤーフィルター式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 수신 요청이 리디렉션을 트리거하는지 정의하는 Cloudflare wirefilter 표현입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expressão wirefilter da Cloudflare que define quais solicitações recebidas acionam o redirecionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выражение проводного фильтра Cloudflare, определяющее, какие входящие запросы вызывают перенаправление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于指定触发重定向跳转的请求匹配规则表达式（例如 URI 路径匹配）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用于指定触發重定向跳轉的請求匹配規則表达式（例如 URI 路径匹配）。"
          }
        }
      }
    },
