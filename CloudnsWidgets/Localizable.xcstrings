    "How long a visitor can access site after passing challenge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي يمكن للزائر خلالها الوصول إلى الموقع بعد اجتياز التحدي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ein Besucher nach bestandener Challenge auf die Website zugreifen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a visitor can access site after passing challenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo puede acceder un visitante al sitio después de superar el desafío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée pendant laquelle un visiteur peut accéder au site après avoir réussi le défi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto tempo un visitatore può accedere al sito dopo aver superato la verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャレンジに合格した後、訪問者がサイトにアクセスできる期間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "챌린지를 통과한 후 방문자가 사이트에 액세스할 수 있는 기간입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo um visitante pode acessar o site após passar no desafio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго посетитель может получать доступ к сайту после прохождения проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问者通过质询后可以访问网站的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訪客通過驗證後可以存取網站的時長。"
          }
        }
      }
    },
    "How long a visitor is allowed access after successfully completing a challenge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة المسموح بها للزائر بالوصول بعد إكمال التحدي بنجاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange ein Besucher nach erfolgreichem Abschluss einer Herausforderung Zutritt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long a visitor is allowed access after successfully completing a challenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo se le permite el acceso a un visitante después de completar con éxito un desafío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
