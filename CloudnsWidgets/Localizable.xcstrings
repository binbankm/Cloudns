    "Destination addresses must be verified via confirmation email before rules can forward to them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب التحقق من عناوين الوجهة عبر البريد الإلكتروني للتأكيد قبل أن تتمكن القواعد من إعادة التوجيه إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieladressen müssen per Bestätigungs-E-Mail verifiziert werden, bevor Regeln an sie weiterleiten können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination addresses must be verified via confirmation email before rules can forward to them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de destino deben verificarse mediante un correo electrónico de confirmación antes de que las reglas puedan reenviar a ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses de destination doivent être vérifiées par e-mail de confirmation avant que les règles puissent leur transférer des e-mails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi di destinazione devono essere verificati tramite email di conferma prima che le regole possano inoltrare a essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが転送できるようになる前に、宛先アドレスを確認メールで確認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙을 통해 전달하기 전에 확인 이메일로 대상 주소를 확인해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços de destino devem ser verificados por e-mail de confirmação antes que as regras possam encaminhar para eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса назначения должны быть проверены с помощью письма с подтверждением, прежде чем правила смогут пересылать на них сообщения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标地址必须通过确认邮件验证，规则才能转发给它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標地址必須透過確認郵件進行驗證，規則才能轉寄至這些地址。"
          }
        }
      }
    },
