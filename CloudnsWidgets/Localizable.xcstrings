    "Are you sure you want to delete '%@'? Traffic to %@ will no longer be protected by Zero Trust.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف “%1$@”؟ لن تتم حماية حركة المرور إلى %2$@ بواسطة Zero Trust بعد الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ löschen? Datenverkehr zu %2$@ wird nicht mehr durch Zero Trust geschützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete '%1$@'? Traffic to %2$@ will no longer be protected by Zero Trust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%1$@»? El tráfico a %2$@ dejará de estar protegido por Zero Trust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %1$@ » ? Le trafic vers %2$@ ne sera plus protégé par Zero Trust."
