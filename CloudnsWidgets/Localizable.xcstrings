    "Custom domains map directly to this Worker without requiring DNS or SSL certificate configuration.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تعيين المجالات المخصصة مباشرة لهذا العامل دون الحاجة إلى تكوين شهادة DNS أو SSL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Domänen werden diesem Worker direkt zugeordnet, ohne dass eine DNS- oder SSL-Zertifikatkonfiguration erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom domains map directly to this Worker without requiring DNS or SSL certificate configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dominios personalizados se asignan directamente a este Worker sin necesidad de configurar un certificado DNS o SSL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les domaines personnalisés sont directement mappés à ce Worker sans nécessiter de configuration de certificat DNS ou SSL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I domini personalizzati vengono mappati direttamente a questo lavoratore senza richiedere la configurazione del certificato DNS o SSL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム ドメインは、DNS または SSL 証明書の構成を必要とせずに、このWorkerに直接マッピングされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 정의 도메인은 DNS 또는 SSL 인증서 구성이 필요 없이 이 Worker에 직접 매핑됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os domínios personalizados são mapeados diretamente para este Worker sem exigir configuração de certificado DNS ou SSL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские домены сопоставляются непосредственно с этим исполнителем без необходимости настройки сертификата DNS или SSL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义域名直接指向该 Worker 脚本，无需繁琐的 DNS 记录与 SSL 证书配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
