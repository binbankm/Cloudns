    "Configure build commands and directories executed during automated deployment.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتكوين أوامر البناء والدلائل التي يتم تنفيذها أثناء النشر الآلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie Build-Befehle und Verzeichnisse, die während der automatisierten Bereitstellung ausgeführt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure build commands and directories executed during automated deployment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure los directorios y comandos de compilación ejecutados durante la implementación automatizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les commandes de build et les répertoires exécutés lors du déploiement automatisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura i comandi di build e le directory eseguite durante la distribuzione automatizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動展開中に実行されるビルド コマンドとディレクトリを構成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화된 배포 중에 실행되는 빌드 명령 및 디렉터리를 구성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure comandos de build e diretórios executados durante a implantação automatizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте команды сборки и каталоги, выполняемые во время автоматического развертывания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置在自动部署期间执行的构建命令与输出目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定在自動部署期間执行的构建命令与輸出目录。"
          }
        }
      }
    },
    "Configure minimum TLS cipher versions and privacy routing features.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكوين الحد الأدنى لإصدارات تشفير TLS وميزات توجيه الخصوصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie minimale TLS-Verschlüsselungsversionen und Datenschutz-Routing-Funktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure minimum TLS cipher versions and privacy routing features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura las versiones mínimas de cifrado TLS y las funciones de enrutamiento de privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les versions minimales de chiffrement TLS et les fonctionnalités de routage de confidentialité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura le versioni minime di crittografia TLS e le funzionalità di routing della privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
