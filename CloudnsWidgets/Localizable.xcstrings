    "Removing this site will immediately delete all its configuration and data from Cloudflare. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستؤدي إزالة هذا الموقع إلى حذف جميع التكوينات والبيانات الخاصة به على الفور من Cloudflare. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Entfernen dieser Site werden sofort alle ihre Konfigurationen und Daten aus Cloudflare gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing this site will immediately delete all its configuration and data from Cloudflare. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar este sitio, se eliminarán inmediatamente toda su configuración y datos de Cloudflare. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de ce site supprimera immédiatement toute sa configuration et ses données de Cloudflare. Cette action ne peut pas être annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rimozione di questo sito eliminerà immediatamente tutta la sua configurazione e i dati da Cloudflare. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトを削除すると、その設定とデータがすべて Cloudflare から直ちに削除されます。この操作は元に戻すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사이트를 제거하면 Cloudflare의 모든 구성과 데이터가 즉시 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A remoção deste site excluirá imediatamente todas as suas configurações e dados da Cloudflare. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление этого сайта приведет к немедленному удалению всей его конфигурации и данных из Cloudflare. Это действие невозможно отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此站点将立即从 Cloudflare 删除其所有配置和数据，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此站點将立即從 Cloudflare 刪除其所有設定和數据，此操作無法撤销。"
          }
        }
      }
    },
    "Removing this zone will permanently delete all its DNS records, firewall rules, and certificates from Cloudflare.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستؤدي إزالة هذه المنطقة إلى حذف جميع سجلات DNS وقواعد جدار الحماية والشهادات نهائيًا من Cloudflare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Entfernen dieser Zone werden alle zugehörigen DNS-Einträge, Firewall-Regeln und Zertifikate dauerhaft von Cloudflare gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing this zone will permanently delete all its DNS records, firewall rules, and certificates from Cloudflare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar esta zona, se eliminarán permanentemente todos sus registros DNS, reglas de firewall y certificados de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de cette zone supprimera définitivement tous ses enregistrements DNS, règles de pare-feu et certificats de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rimozione di questa zona eliminerà definitivamente tutti i record DNS, le regole del firewall e i certificati da Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゾーンを削除すると、そのすべての DNS レコード、ファイアウォール ルール、証明書が Cloudflare から完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역을 제거하면 해당 DNS 레코드, 방화벽 규칙 및 인증서가 Cloudflare에서 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A remoção desta zona excluirá permanentemente todos os seus registros DNS, regras de firewall e certificados da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление этой зоны приведет к безвозвратному удалению всех ее записей DNS, правил брандмауэра и сертификатов из Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此区域将从 Cloudflare 中永久删除其所有 DNS 记录、防火墙规则和证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此區域將從 Cloudflare 中永久刪除其所有 DNS 記錄、防火牆規則和憑證。"
          }
        }
      }
    },
