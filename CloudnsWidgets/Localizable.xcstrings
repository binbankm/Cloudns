          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%1$@»? Трафик к %2$@ больше не будет защищён Zero Trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除“%1$@”吗？前往 %2$@ 的流量将不再受到 Zero Trust 保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
