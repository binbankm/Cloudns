    "Traces Cloudflare's Anycast edge server, data center PoP airport code, IP & security capabilities via /cdn-cgi/trace.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع خادم حافة Anycast لـ Cloudflare ورمز مطار مركز البيانات PoP وعنوان IP وقدرات الأمان عبر /cdn-cgi/trace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt den Anycast-Edge-Server von Cloudflare, den Flughafen-Code des Rechenzentrums-PoP, IP und Sicherheitsfunktionen über /cdn-cgi/trace."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traces Cloudflare's Anycast edge server, data center PoP airport code, IP & security capabilities via /cdn-cgi/trace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrea el servidor perimetral Anycast de Cloudflare, el código de aeropuerto del PoP del centro de datos, la IP y las capacidades de seguridad a través de /cdn-cgi/trace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace le serveur de périphérie Anycast de Cloudflare, le code aéroportuaire du PoP du centre de données, l'adresse IP et les fonctionnalités de sécurité via /cdn-cgi/trace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia il server perimetrale Anycast di Cloudflare, il codice aeroportuale del PoP del data center, l'IP e le funzionalità di sicurezza tramite /cdn-cgi/trace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/cdn-cgi/trace を介して Cloudflare の Anycast エッジ サーバー、データセンター PoP 空港コード、IP、セキュリティ機能をトレースします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/cdn-cgi/trace를 통해 Cloudflare의 Anycast 에지 서버, 데이터 센터 PoP 공항 코드, IP 및 보안 기능을 추적합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreia o servidor de borda Anycast da Cloudflare, o código do aeroporto do PoP do data center, o IP e os recursos de segurança via /cdn-cgi/trace."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает Anycast-сервер Edge Cloudflare, код аэропорта дата-центра PoP, IP и возможности безопасности через /cdn-cgi/trace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 /cdn-cgi/trace 追踪 Cloudflare 的 Anycast 边缘服务器、数据中心 PoP 机场代码、IP 和安全能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 /cdn-cgi/trace 追蹤 Cloudflare 的 Anycast 邊緣伺服器、資料中心 PoP 機場程式碼、IP 和安全功能。"
          }
        }
      }
    },
