    "Prevents external websites from embedding your images.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع المواقع الخارجية من تضمين صورك (مكافحة الربط المباشر)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass externe Websites Ihre Bilder einbetten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents external websites from embedding your images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que sitios web externos inserten tus imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche les sites Web externes d'intégrer vos images."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce ai siti web esterni di incorporare le tue immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部 Web サイトが画像を埋め込むのを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 웹사이트가 이미지를 포함하는 것을 방지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que sites externos incorporem suas imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрещает внешним веб-сайтам встраивать ваши изображения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止外部网站盗链并嵌入您的图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止外部網站盜鏈並嵌入您的影像。"
          }
        }
      }
    },
    "Prevents other sites from embedding your images, saving your bandwidth.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع المواقع الأخرى من تضمين صورك، مما يوفر النطاق الترددي الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass andere Websites Ihre Bilder einbetten, und spart so Bandbreite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents other sites from embedding your images, saving your bandwidth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que otros sitios incrusten sus imágenes, ahorrando ancho de banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche d'autres sites d'intégrer vos images, économisant ainsi votre bande passante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce ad altri siti di incorporare le tue immagini, risparmiando larghezza di banda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のサイトが画像を埋め込むのを防ぎ、帯域幅を節約します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사이트에 이미지를 삽입하는 것을 방지하여 대역폭을 절약합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que outros sites incorporem suas imagens, economizando largura de banda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает встраивание ваших изображений другими сайтами, экономя вашу пропускную способность."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止其他站点嵌入您的图像，节省您的带宽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止其他站點嵌入您的圖像，节省您的頻寬。"
          }
        }
      }
    },
