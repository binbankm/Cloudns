          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle HTTP-Anfragen automatisch auf HTTPS umleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect all HTTP requests to HTTPS automatically."
          }
        },
        "es": {
          "stringUnit": {
