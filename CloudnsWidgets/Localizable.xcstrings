    "Distribute incoming traffic across server pools for high availability.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوزيع حركة المرور الواردة عبر مجموعات الخوادم لتحقيق التوفر العالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilen Sie eingehenden Datenverkehr auf Serverpools, um eine hohe Verfügbarkeit zu gewährleisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribute incoming traffic across server pools for high availability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuya el tráfico entrante entre grupos de servidores para lograr alta disponibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuez le trafic entrant entre les pools de serveurs pour une haute disponibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuisci il traffico in entrata tra pool di server per un'elevata disponibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高可用性を実現するために、受信トラフィックをサーバー プール全体に分散します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고가용성을 위해 들어오는 트래픽을 서버 풀 전체에 분산합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribua o tráfego de entrada entre pools de servidores para alta disponibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределяйте входящий трафик по пулам серверов для обеспечения высокой доступности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨服务器池分发传入流量以实现高可用性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨服务器池分發傳入流量以實現高可用性。"
          }
        }
      }
    },
