    "Brotli offers higher compression over standard Gzip. Rocket Loader defers JavaScript execution.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوفر Brotli ضغطًا أفضل مقارنة بـ Gzip القياسي. يقوم Rocket Loader بتأجيل تنفيذ JavaScript."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli bietet eine bessere Komprimierung als Standard-Gzip. Rocket Loader verzögert die JavaScript-Ausführung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli offers higher compression over standard Gzip. Rocket Loader defers JavaScript execution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli ofrece una mejor compresión que el Gzip estándar. Rocket Loader pospone la ejecución de JavaScript."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli offre une meilleure compression que le Gzip standard. Rocket Loader diffère l'exécution de JavaScript."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli offre una compressione migliore rispetto al normale Gzip. Rocket Loader posticipa l'esecuzione di JavaScript."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli は標準の Gzip よりも優れた圧縮を提供します。Rocket Loader は JavaScript の読み込みを遅延させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli는 표준 Gzip보다 더 높은 압축률을 제공합니다. Rocket Loader는 JavaScript 로딩을 지연시킵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli oferece melhor compactação do que o Gzip padrão. O Rocket Loader adia a execução do JavaScript."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli обеспечивает лучшее сжатие по сравнению со стандартным Gzip. Rocket Loader откладывает выполнение JavaScript."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli 提供比标准 Gzip 更高的压缩率。Rocket Loader 异步延迟加载 JavaScript。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Brotli 提供比標準 Gzip 更高的壓縮率。Rocket Loader 異步延遲載入 JavaScript。"
          }
        }
      }
    },
