    "Simultaneously probes DNS answers across 8 Anycast edge resolvers across North America, Europe, Asia, Australia & South America.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستكشف إجابات DNS في وقت واحد عبر 8 محللات حافة Anycast عبر أمريكا الشمالية وأوروبا وآسيا وأستراليا وأمريكا الجنوبية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet gleichzeitig DNS-Antworten über 8 Anycast-Edge-Resolver in Nordamerika, Europa, Asien, Australien und Südamerika."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simultaneously probes DNS answers across 8 Anycast edge resolvers across North America, Europe, Asia, Australia & South America."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondea simultáneamente respuestas DNS en 8 resolutores perimetrales Anycast en América del Norte, Europa, Asia, Australia y América del Sur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonde simultanément les réponses DNS sur 8 résolveurs de périphérie Anycast en Amérique du Nord, Europe, Asie, Australie et Amérique du Sud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonda contemporaneamente le risposte DNS su 8 resolver perimetrali Anycast in Nord America, Europa, Asia, Australia e Sud America."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "北米、ヨーロッパ、アジア、オーストラリア、南米の 8 つの Anycast エッジ リゾルバー全体で DNS 回答を同時にプローブします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북미, 유럽, 아시아, 호주 및 남미 전역의 8개 Anycast 에지 DNS 리졸버에서 DNS 응답을 동시에 프로빙합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonda simultaneamente respostas DNS em 8 resolvedores de borda Anycast na América do Norte, Europa, Ásia, Austrália e América do Sul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно зондирует ответы DNS на 8 Anycast-резолверах Edge в Северной Америке, Европе, Азии, Австралии и Южной Америке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时探测北美、欧洲、亚洲、澳大利亚和南美洲 8 个 Anycast 边缘解析器的 DNS 应答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時探測北美、歐洲、亞洲、澳洲和南美洲 8 個 Anycast 邊緣解析器的 DNS 應答。"
          }
        }
      }
    },
