    "Development mode temporarily bypasses all caching to see origin changes instantly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز وضع التطوير مؤقتًا جميع عمليات التخزين المؤقت لرؤية تغييرات الأصل على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwicklungsmodus umgeht vorübergehend das gesamte Caching, um Änderungen am Ursprung sofort zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development mode temporarily bypasses all caching to see origin changes instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de desarrollo omite temporalmente todo el almacenamiento en caché para ver los cambios de origen al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode de développement contourne temporairement toute mise en cache pour afficher instantanément les modifications apportées à l'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità di sviluppo bypassa temporaneamente tutta la cache per visualizzare istantaneamente le modifiche all'origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発モードはすべてのキャッシュを一時的にバイパスし、オリジンの変更を即座に確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 모드는 모든 캐싱을 일시적으로 우회하여 원본 변경 사항을 즉시 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de desenvolvimento ignora temporariamente todo o cache para ver as alterações de origem instantaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим разработки временно обходит все кэширование, чтобы мгновенно видеть изменения на источнике."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发模式会暂时绕过所有缓存，以便立即查看源站的更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發模式會暫時略過所有快取，以便即時檢視源伺服器的變更。"
          }
        }
      }
    },
