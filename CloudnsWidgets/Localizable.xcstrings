    "Directly route traffic to your origin server, bypassing Cloudflare's security and caching proxy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجيه حركة المرور مباشرة إلى الخادم الأصلي، مع تجاوز وكيل الأمان والتخزين المؤقت لـ Cloudflare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkehr direkt an Ihren Ursprungsserver weiterleiten, wobei der Sicherheits- und Caching-Proxy von Cloudflare umgangen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directly route traffic to your origin server, bypassing Cloudflare's security and caching proxy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enruta directamente el tráfico a tu servidor de origen, omitiendo el proxy de seguridad y almacenamiento en caché de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheminez directement le trafic vers votre serveur d'origine, en contournant le proxy de sécurité et de mise en cache de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrada direttamente il traffico al server di origine, bypassando il proxy di sicurezza e memorizzazione nella cache di Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare のセキュリティとキャッシング プロキシをバイパスして、オリジン サーバーに直接トラフィックをルーティングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare의 보안 및 캐싱 프록시를 우회하여 트래픽을 원본 서버로 직접 라우팅합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roteie o tráfego diretamente para o servidor de origem, ignorando o proxy de segurança e cache da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая маршрутизация трафика на ваш исходный сервер в обход прокси-сервера безопасности и кэширования Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接将流量路由到您的源服务器，绕过 Cloudflare 的安全和缓存代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接將流量路由至您的源伺服器，略過 Cloudflare 的安全與快取代理。"
          }
        }
      }
    },
