    "When enabled, Cloudflare generates DS records to be registered at your domain registrar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التمكين، تقوم Cloudflare بإنشاء سجلات DS لتسجيلها لدى مسجل النطاق الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, generiert Cloudflare DS-Einträge, die bei Ihrem Domain-Registrar registriert werden müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Cloudflare generates DS records to be registered at your domain registrar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, Cloudflare genera registros DS para registrarse en tu registrador de dominios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est activé, Cloudflare génère des enregistrements DS à enregistrer auprès de votre bureau d'enregistrement de domaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando abilitato, Cloudflare genera record DS da registrare presso il registrar di domini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Cloudflare はドメイン レジストラで登録する DS レコードを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 Cloudflare는 도메인 등록 기관에 등록할 DS 레코드를 생성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, a Cloudflare gera registros DS para serem registrados no seu registrador de domínio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении Cloudflare создает записи DS для регистрации у вашего регистратора домена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Cloudflare 将生成要在您的域名注册商处注册的 DS 记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，Cloudflare 將產生要在您的網域稱註冊商處註冊的 DS 記錄。"
          }
        }
      }
    },
    "When enabled, Cloudflare receives incoming emails for your domain and forwards them according to your routing rules.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التمكين، يتلقى Cloudflare رسائل البريد الإلكتروني الواردة لنطاقك ويعيد توجيهها وفقًا لقواعد التوجيه الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option aktiviert ist, empfängt Cloudflare eingehende E-Mails für Ihre Domain und leitet sie gemäß Ihren Routing-Regeln weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Cloudflare receives incoming emails for your domain and forwards them according to your routing rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está habilitado, Cloudflare recibe correos electrónicos entrantes para su dominio y los reenvía de acuerdo con sus reglas de enrutamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est activé, Cloudflare reçoit les e-mails entrants pour votre domaine et les transmet selon vos règles de routage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando abilitato, Cloudflare riceve le email in arrivo per il tuo dominio e le inoltra in base alle tue regole di routing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Cloudflareはドメインへの受信メールを受信し、ルーティングルールに従って転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 Cloudflare는 도메인으로 들어오는 이메일을 수신하고 라우팅 규칙에 따라 전달합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Cloudflare recebe e-mails do seu domínio e os encaminha de acordo com suas regras de roteamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если эта функция включена, Cloudflare получает входящие электронные письма для вашего домена и пересылает их в соответствии с вашими правилами маршрутизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Cloudflare 将接管该域名的入站邮件并按规则执行路由转发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Cloudflare 将接管该網域稱的入站邮件并按規則执行路由轉發。"
          }
        }
      }
    },
