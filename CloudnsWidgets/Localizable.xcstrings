    "Modifies HTTP request headers sent to the origin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدل رؤوس طلب HTTP المرسلة إلى الأصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert HTTP-Anforderungsheader, die an den Ursprung gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifies HTTP request headers sent to the origin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica los encabezados de solicitud HTTP enviados al origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie les en-têtes de requête HTTP envoyées à l'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le intestazioni delle richieste HTTP inviate all'origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジンに送信される HTTP リクエスト ヘッダーを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본으로 전송된 HTTP 요청 헤더를 수정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica os cabeçalhos de solicitação HTTP enviados à origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет заголовки HTTP-запросов, отправленные в источник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改发送到源站的 HTTP 请求标头。"
          }
