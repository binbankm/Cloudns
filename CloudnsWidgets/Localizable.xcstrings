    "Projects created via API receive a direct-upload *.pages.dev deployment endpoint.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلقى المشاريع التي تم إنشاؤها عبر واجهة برمجة التطبيقات (API) نقطة نهاية نشر للتحميل المباشر *.pages.dev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über die API erstellte Projekte erhalten einen Direkt-Upload-Bereitstellungsendpunkt *.pages.dev."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects created via API receive a direct-upload *.pages.dev deployment endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos creados a través de API reciben un punto final de implementación de carga directa *.pages.dev."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets créés via l'API reçoivent un point de terminaison de déploiement *.pages.dev à téléchargement direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti creati tramite API ricevono un endpoint di distribuzione *.pages.dev a caricamento diretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API 経由で作成されたプロジェクトは、直接アップロード *.pages.dev デプロイメント エンドポイントを受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API를 통해 생성된 프로젝트는 직접 업로드 *.pages.dev 배포 엔드포인트를 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos criados por meio da API recebem um endpoint de implantação *.pages.dev de upload direto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты, созданные через API, получают конечную точку развертывания *.pages.dev с прямой загрузкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 API 创建的项目会获得直传 *.pages.dev 部署端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過 API 建立的專案會获得直傳 *.pages.dev 部署端點。"
          }
        }
      }
    },
