    "Queries global RDAP (Registration Data Access Protocol) and authoritative WHOIS directories for registrar lifecycle dates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعلم من بروتوكول RDAP العالمي وأدلة WHOIS الرسمية لمعرفة تواريخ دورة حياة المسجل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt globale RDAP- (Registration Data Access Protocol) und autoritative WHOIS-Verzeichnisse nach Registrar-Lebenszyklusdaten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries global RDAP (Registration Data Access Protocol) and authoritative WHOIS directories for registrar lifecycle dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el protocolo global RDAP (Protocolo de acceso a datos de registro) y los directorios autoritativos WHOIS para fechas del ciclo de vida del registrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge le protocole mondial RDAP (Registration Data Access Protocol) et les répertoires WHOIS faisant autorité pour connaître les dates du cycle de vie du bureau d'enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroga i protocolli globali RDAP e le directory autorevoli WHOIS per le date del ciclo di vita del registrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバル RDAP (登録データ アクセス プロトコル) および信頼できる WHOIS ディレクトリをクエリして、レジストラ ライフサイクルの日付を取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글로벌 RDAP(등록 데이터 액세스 프로토콜) 및 신뢰할 수 있는 WHOIS 디렉터리를 쿼리하여 등록 기관 수명 주기 날짜를 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta RDAP global (Protocolo de Acesso a Dados de Registro) e diretórios WHOIS autoritativos para datas de ciclo de vida do registrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает глобальный RDAP (протокол доступа к регистрационным данным) и авторитетные каталоги WHOIS для получения дат жизненного цикла регистратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询全球 RDAP（注册数据访问协议）和权威 WHOIS 目录以获取注册商生命周期日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢全球 RDAP（註冊資料存取通訊協定）和權威 WHOIS 目錄以獲取註冊商生命週期日期。"
          }
        }
      }
    },
