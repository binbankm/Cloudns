    "Calculates usable IP host addresses, network broadcast bounds, netmasks & binary bitmasks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب عناوين مضيفي IP القابلة للاستخدام، وحدود بث الشبكة، وأقنعة الشبكة، وأقنعة البتات الثنائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet nutzbare IP-Hostadressen, Netzwerk-Broadcast-Grenzen, Netzmasken und binäre Bitmasken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculates usable IP host addresses, network broadcast bounds, netmasks & binary bitmasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula direcciones de host IP utilizables, límites de difusión de red, máscaras de red y máscaras de bits binarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule les adresses d'hôtes IP utilisables, les limites de diffusion réseau, les masques de sous-réseau et les masques de bits binaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola gli indirizzi host IP utilizzabili, i limiti di broadcast di rete, le subnet mask e le maschere di bit binarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可能な IP ホスト アドレス、ネットワーク ブロードキャスト境界、ネットマスク、バイナリ ビットマスクを計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 IP 호스트 주소, 네트워크 브로드캐스트 범위, 넷마스크 및 이진 비트마스크를 계산합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula endereços de host IP utilizáveis, limites de broadcast de rede, máscaras de rede e máscaras de bits binárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вычисляет доступные IP-адреса хостов, границы широковещания сети, маски сети и двоичные битовые маски."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算可用的 IP 主机地址、网络广播边界、网络掩码和二进制位掩码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算可用的 IP 主機位址、網路廣播邊界、網路遮罩和二進位位元遮罩。"
          }
        }
      }
    },
