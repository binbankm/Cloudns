    "All API keys and tokens are securely stored in the iOS Keychain with hardware-level Secure Enclave encryption.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين جميع مفاتيح ورموز API بشكل آمن في iOS Keychain مع تشفير Secure Enclave على مستوى الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle API-Schlüssel und Token werden sicher im iOS-Schlüsselbund mit hardwarebasierter Secure Enclave-Verschlüsselung gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All API keys and tokens are securely stored in the iOS Keychain with hardware-level Secure Enclave encryption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las claves y tokens de API se almacenan de forma segura en el llavero de iOS con cifrado Secure Enclave a nivel de hardware."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les clés et jetons API sont stockés en toute sécurité dans le trousseau iOS avec un chiffrement matériel Secure Enclave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le chiavi e i token API sono archiviati in modo sicuro nel portachiavi iOS con crittografia Secure Enclave a livello hardware."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての API キーとトークンは、ハードウェア レベルの Secure Enclave 暗号化を使用して iOS キーチェーンに安全に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 API 키와 토큰은 하드웨어 수준의 Secure Enclave 암호화를 통해 iOS 키체인에 안전하게 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as chaves e tokens de API são armazenados com segurança no iOS Keychain com criptografia Secure Enclave em nível de hardware."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ключи и токены API надежно хранятся в iOS Keychain с аппаратным шифрованием Secure Enclave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 API 密钥和令牌均通过硬件级 Secure Enclave 加密安全存储在 iOS 钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 API 金鑰和權杖均透過硬體級 Secure Enclave 加密安全儲存在 iOS 鑰匙圈中。"
          }
        }
      }
    },
    "All cached resources were purged successfully.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
