          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ с Zero Trust защищает локальные и SaaS-приложения с помощью политик на основе удостоверений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
