    "Queries 1.1.1.1 Anycast edge resolver with optional DNSSEC verification or benchmarks worldwide public resolvers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعلم من محلل الحافة Anycast 1.1.1.1 مع التحقق الاختياري من DNSSEC أو يقيس أداء المحللات العامة في جميع أنحاء العالم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt den 1.1.1.1 Anycast-Edge-Resolver mit optionaler DNSSEC-Verifizierung ab oder vergleicht weltweite öffentliche Resolver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries 1.1.1.1 Anycast edge resolver with optional DNSSEC verification or benchmarks worldwide public resolvers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el resolutor perimetral Anycast 1.1.1.1 con verificación DNSSEC opcional o compara resolutores públicos de todo el mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge le résolveur de périphérie Anycast 1.1.1.1 avec vérification DNSSEC facultative ou évalue les résolveurs publics mondiaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroga il resolver perimetrale Anycast 1.1.1.1 con verifica DNSSEC facoltativa o confronta i resolver pubblici mondiali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプションの DNSSEC 検証付きで 1.1.1.1 Anycast エッジ リゾルバーをクエリするか、世界中のパブリック リゾルバーをベンチマークします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 DNSSEC 검증을 통해 1.1.1.1 Anycast 에지 DNS 리졸버를 쿼리하거나 전 세계 공용 DNS 리졸버를 벤치마킹합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta o resolvedor de borda Anycast 1.1.1.1 com verificação opcional de DNSSEC ou compara resolvedores públicos mundiais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает Anycast-резолвер Edge 1.1.1.1 с дополнительной проверкой DNSSEC или тестирует общедоступные резолверы по всему миру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询 1.1.1.1 Anycast 边缘解析器（带有可选的 DNSSEC 验证）或基准测试全球公共解析器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢 1.1.1.1 Anycast 邊緣解析器（帶有選填的 DNSSEC 驗證）或基準測試全球公共解析器。"
          }
        }
      }
    },
    "Queries BGP routing registries, Autonomous System Numbers (ASN), ISP names & physical geolocation coordinates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعلم من سجلات توجيه BGP وأرقام الأنظمة المستقلة (ASN) وأسماء مزودي خدمة الإنترنت وإحداثيات الموقع الجغرافي الفعلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt BGP-Routing-Register, Autonome Systemnummern (ASN), ISP-Namen und physische Geolokalisierungskoordinaten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queries BGP routing registries, Autonomous System Numbers (ASN), ISP names & physical geolocation coordinates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta registros de enrutamiento BGP, números de sistema autónomo (ASN), nombres de ISP y coordenadas de geolocalización física."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge les registres de routage BGP, les numéros de système autonome (ASN), les noms de FAI et les coordonnées géographiques physiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroga i registri di routing BGP, i numeri di sistema autonomo (ASN), i nomi degli ISP e le coordinate di geolocalizzazione fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BGP ルーティング レジストリ、自律システム番号 (ASN)、ISP 名、物理的な地理位置座標をクエリします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BGP 라우팅 레지스트리, 자율 시스템 번호(ASN), ISP 이름 및 실제 지리적 위치 좌표를 쿼리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta registros de roteamento BGP, números de sistema autônomo (ASN), nomes de ISP e coordenadas de geolocalização física."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает реестры маршрутизации BGP, номера автономных систем (ASN), имена провайдеров и физические координаты геолокации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询 BGP 路由注册表、自治系统编号 (ASN)、ISP 名称和实际地理位置坐标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢 BGP 路由註冊表、自治系統編號 (ASN)、ISP 名稱和實際地理位置座標。"
          }
        }
      }
    },
    "Queries global IANA RDAP directory over encrypted HTTPS (no account needed).": {
