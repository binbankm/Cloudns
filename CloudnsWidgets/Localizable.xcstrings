            "value": "ライブ実行メトリクスとレイテンシ トレースを使用して、Worker、ページ ビルド、KV/D1 データベースを監視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 실행 지표 및 대기 시간 추적을 통해 Worker, 페이지 빌드 및 KV/D1 데이터베이스를 모니터링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore Workers, compilações de páginas e bancos de dados KV/D1 com métricas de execução em tempo real e rastreamento de latência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте рабочие процессы, сборки страниц и базы данных KV/D1 с помощью показателей выполнения в реальном времени и отслеживания задержек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
