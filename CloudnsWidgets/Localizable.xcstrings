    "Clear cached files by their exact URLs. This allows you to selectively refresh specific resources.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الملفات المخزنة مؤقتًا حسب عناوين URL الخاصة بها. يتيح لك ذلك تحديث موارد محددة بشكل انتقائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie zwischengespeicherte Dateien anhand ihrer genauen URLs. Dadurch können Sie gezielt bestimmte Ressourcen aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear cached files by their exact URLs. This allows you to selectively refresh specific resources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borre los archivos almacenados en caché por sus URL exactas. Esto le permite actualizar selectivamente recursos específicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez les fichiers mis en cache par leurs URL exactes. Cela vous permet d'actualiser de manière sélective des ressources spécifiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i file memorizzati nella cache in base ai loro URL esatti. Ciò consente di aggiornare selettivamente risorse specifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたファイルを正確な URL でクリアします。これにより、特定のリソースを選択的にリフレッシュできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 URL로 캐시된 파일을 지웁니다. 이를 통해 특정 리소스를 선택적으로 새로 고칠 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe os arquivos em cache por seus URLs exatos. Isso permite atualizar seletivamente recursos específicos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистите кэшированные файлы по их точным URL-адресам. Это позволяет выборочно обновлять определенные ресурсы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过确切的 URL 清除缓存文件。这允许您有选择地刷新特定资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過確切的 URL 清除快取文件。这允許您有選择地重新整理特定资源。"
          }
        }
      }
    },
