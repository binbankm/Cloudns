    "The API token or key provided was rejected or has expired.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض رمز واجهة برمجة التطبيقات أو المفتاح المقدم أو انتهت صلاحيته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das angegebene API-Token oder der Schlüssel wurde abgelehnt oder ist abgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API token or key provided was rejected or has expired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token o la clave de API proporcionados fueron rechazados o han caducado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton ou la clé d'API fourni(e) a été rejeté(e) ou a expiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il token API o la chiave forniti sono stati rifiutati o sono scaduti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供された API トークンまたはキーが拒否されたか、期限切れです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공된 API 토큰 또는 키가 거부되었거나 만료되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token de API ou chave fornecida foi rejeitada ou expirou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставленный токен API или ключ был отклонен или истек срок его действия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
