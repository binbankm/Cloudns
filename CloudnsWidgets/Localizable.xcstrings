      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة توجيه عناوين النطاق المخصصة إلى صناديق البريد الإلكتروني التي تم التحقق منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiten Sie benutzerdefinierte Domänenadressen an Ihre verifizierten E-Mail-Posteingänge weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward custom domain addresses to your verified email inboxes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenvíe direcciones de dominio personalizadas a sus bandejas de entrada de correo electrónico verificadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférez les adresses de domaine personnalisées vers vos boîtes de réception vérifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltra indirizzi di dominio personalizzati alle tue caselle di posta elettronica verificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム ドメイン アドレスを確認済みの電子メールの受信トレイに転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 정의 도메인 주소를 확인된 이메일 받은 편지함으로 전달하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhe endereços de domínio personalizados para suas caixas de entrada de e-mail verificadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересылайте адреса собственных доменов в проверенные почтовые ящики."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将自定义域名邮箱收到的邮件转发至已验证的目标收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将自定义網域稱邮箱收到的邮件轉發至已驗證的目標收件箱。"
          }
        }
      }
    },
