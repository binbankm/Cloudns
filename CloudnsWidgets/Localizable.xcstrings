    "Require Face ID or Touch ID to unlock the app when returning from the background.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب Face ID أو Touch ID لفتح التطبيق عند العودة من الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID oder Touch ID erfordern, um die App zu entsperren, wenn Sie aus dem Hintergrund zurückkehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require Face ID or Touch ID to unlock the app when returning from the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Face ID o Touch ID para desbloquear la aplicación cuando regresas del fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Face ID ou Touch ID pour déverrouiller l'application lorsque vous revenez de l'arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi Face ID o Touch ID per sbloccare l'app quando torni dallo sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドから戻るときにアプリのロックを解除するには、Face ID または Touch ID が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 돌아올 때 앱을 잠금 해제하려면 Face ID 또는 Touch ID가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exija Face ID ou Touch ID para desbloquear o aplicativo ao retornar do plano de fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать Face ID или Touch ID, чтобы разблокировать приложение при выходе из фонового режима."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从后台返回时需要通过面容 ID 或触控 ID 解锁应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從後台返回時需要通過面容 ID 或触控 ID 解鎖應用。"
          }
        }
      }
    },
