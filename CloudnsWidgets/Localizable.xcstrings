          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier despliegue para inspeccionar la canalización de compilación completa, las duraciones de las etapas y los registros de la consola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
