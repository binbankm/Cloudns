    "Standard 5-segment cron format: minute hour day-of-month month day-of-week (UTC).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق cron القياسي المكون من 5 أجزاء: الدقيقة الساعة يوم-من-الشهر الشهر يوم-من-الأسبوع (UTC)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-5-Segment-Cron-Format: Minute Stunde Tag-des-Monats Monat Wochentag (UTC)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard 5-segment cron format: minute hour day-of-month month day-of-week (UTC)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato cron estándar de 5 segmentos: minuto hora día-del-mes mes día-de-la-semana (UTC)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format cron standard à 5 segments : minute heure jour-du-mois mois jour-de-la-semaine (UTC)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato cron standard a 5 segmenti: minuto ora giorno-del-mese mese giorno-della-settimana (UTC)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準の 5 セグメント Cron 形式: 分 時 日 月 曜日 (UTC)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 5개 세그먼트 cron 형식: 분 시 일 월 요일(UTC)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato cron padrão de 5 segmentos: minuto hora dia-do-mês mês dia-da-semana (UTC)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартный 5-сегментный формат cron: минута час день-месяца месяц день-недели (UTC)."
          }
