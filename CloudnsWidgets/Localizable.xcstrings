    "Roll back to any previous deployment version to instantly restore your Worker code, routes, and environment configuration.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التراجع إلى أي إصدار نشر سابق لاستعادة كود Worker والمسارات وتكوين البيئة على الفور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie ein Rollback auf eine frühere Bereitstellungsversion durch, um Ihren Worker-Code, Routen und Umgebungskonfiguration sofort wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roll back to any previous deployment version to instantly restore your Worker code, routes, and environment configuration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revierte a cualquier versión de despliegue anterior para restaurar instantáneamente el código, rutas y configuración de entorno de tu Worker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez n'importe quelle version de déploiement antérieure pour rétablir instantanément le code de votre Worker, ses routes et sa configuration d'environnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il rollback a qualsiasi versione di distribuzione precedente per ripristinare istantaneamente il codice Worker, le route e la configurazione dell'ambiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のデプロイ バージョンにロールバックして、Worker コード、ルート、環境構成を即座に復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 배포 버전으로 롤백하여 Worker 코드, 라우트 및 환경 구성을 즉시 복원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverta para qualquer versão de implantação anterior para restaurar instantaneamente o código do Worker, rotas e configuração do ambiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откатитесь к любой предыдущей версии развертывания, чтобы мгновенно восстановить код Worker, маршруты и конфигурацию среды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回滚到任何先前的部署版本，以立即恢复您的 Worker 代码、路由和环境配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原至任何先前的部署版本，以即時還原您的 Worker 程式碼、路由和環境設定。"
          }
        }
      }
    },
