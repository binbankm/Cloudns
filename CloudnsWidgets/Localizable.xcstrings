    "Update the nameservers at your domain registrar to the ones assigned above.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث خوادم الأسماء لدى مسجل النطاق الخاص بك إلى تلك المخصصة أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie die Nameserver bei Ihrem Domain-Registrar auf die oben zugewiesenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the nameservers at your domain registrar to the ones assigned above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice los servidores de nombres en su registrador de dominio a los asignados anteriormente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour les serveurs de noms de votre registraire de domaine avec ceux attribués ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i nameserver del tuo registrar di domini con quelli assegnati sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン レジストラのネームサーバーを上記で割り当てられたネームサーバーに更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도메인 등록 기관의 이름 서버를 위에 할당된 이름 서버로 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize os servidores de nomes no seu registrador de domínio para os atribuídos acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите серверы имен у вашего регистратора доменов до назначенных выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在您的域名注册商处将名称服务器更新为上方分配的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在您的網域稱注册商處将名称服务器更新為上方分配的地址。"
          }
        }
      }
    },
    "Update your nameservers at your domain registrar to activate Cloudflare protection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديث خوادم الأسماء الخاصة بك لدى مسجل النطاق الخاص بك لتنشيط حماية Cloudflare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie Ihre Nameserver bei Ihrem Domain-Registrar, um den Cloudflare-Schutz zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your nameservers at your domain registrar to activate Cloudflare protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice sus servidores de nombres en el registrador de su dominio para activar la protección de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour vos serveurs de noms auprès de votre registraire de domaine pour activer la protection Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i tuoi server dei nomi presso il registrar del tuo dominio per attivare la protezione Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインレジストラのネームサーバーを更新して、Cloudflare 保護を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare 보호를 활성화하려면 도메인 등록 기관의 이름 서버를 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize seus servidores de nomes em seu registrador de domínio para ativar a proteção Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите серверы имен у регистратора домена, чтобы активировать защиту Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的域名注册商处更新域名服务器，以激活 Cloudflare 防护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的網域稱注册商處更新名稱伺服器 (Nameservers)，以激活 Cloudflare 防護。"
          }
        }
      }
    },
