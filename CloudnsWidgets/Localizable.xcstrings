    "Plaintext variables can be read, viewed, and modified at any time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن قراءة متغيرات النص العادي وعرضها وتعديلها في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klartextvariablen können jederzeit gelesen, angezeigt und geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaintext variables can be read, viewed, and modified at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de texto sin formato se pueden leer, ver y modificar en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables en texte brut peuvent être lues, visualisées et modifiées à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili di testo in chiaro possono essere lette, visualizzate e modificate in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキスト変数はいつでも読み取り、表示、変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 텍스트 변수는 언제든지 읽고, 보고, 수정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variáveis ​​de texto simples podem ser lidas, visualizadas e modificadas a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные открытого текста можно читать, просматривать и изменять в любое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明文变量可随时读取、查看和修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明文變量可随時讀取、查看和修改。"
          }
        }
      }
    },
    "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن عرض متغيرات النص العادي مباشرة. يتم تشفير المتغيرات السرية وإخفائها للأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klartextvariablen können direkt angezeigt werden. Geheime Variablen werden aus Sicherheitsgründen verschlüsselt und maskiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaintext variables can be viewed directly. Secret variables are encrypted and masked for security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de texto sin formato se pueden ver directamente. Las variables secretas están cifradas y enmascaradas por seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables en texte brut peuvent être visualisées directement. Les variables secrètes sont cryptées et masquées pour des raisons de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili di testo in chiaro possono essere visualizzate direttamente. Le variabili segrete sono crittografate e mascherate per motivi di sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキスト変数を直接表示できます。シークレット変数は、セキュリティのために暗号化され、マスクされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 텍스트 변수를 직접 볼 수 있습니다. 비밀 변수는 보안을 위해 암호화되고 마스크됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variáveis ​​de texto simples podem ser visualizadas diretamente. Variáveis ​​secretas são criptografadas e mascaradas por segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные открытого текста можно просматривать напрямую. Секретные переменные зашифрованы и замаскированы в целях безопасности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明文变量可直接查看。Secret 变量已被加密并脱敏以确保安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明文變量可直接查看。机密變量已被加密并脱敏以確保安全性。"
          }
        }
      }
    },
