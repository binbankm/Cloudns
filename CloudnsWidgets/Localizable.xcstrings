    "Sends consecutive HTTP/HTTPS HEAD probes to measure edge latency, round-trip time jitter & packet consistency.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل مسبارات HEAD متتالية عبر HTTP/HTTPS لقياس زمن استجابة الحافة، وتقلب وقت الذهاب والإياب، وتناسق الحزم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet fortlaufende HTTP/HTTPS-HEAD-Tests zur Messung von Edge-Latenz, Roundtrip-Zeit-Jitter und Paketkonsistenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends consecutive HTTP/HTTPS HEAD probes to measure edge latency, round-trip time jitter & packet consistency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía sondeos HEAD de HTTP/HTTPS consecutivos para medir la latencia perimetral, la variación del tiempo de ida y vuelta y la consistencia de los paquetes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie des sondes HEAD HTTP/HTTPS consécutives pour mesurer la latence en périphérie, la gigue du temps d'aller-retour et la cohérence des paquets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia test HEAD HTTP/HTTPS consecutivi per misurare la latenza perimetrale, il jitter del tempo di round-trip e la coerenza dei pacchetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続した HTTP/HTTPS HEAD プローブを送信して、エッジのレイテンシ、RTT ジッター、パケットの一貫性を測定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속적인 HTTP/HTTPS HEAD 프로브를 전송하여 에지 지연 시간, 왕복 시간 지터 및 패킷 일관성을 측정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia testes HEAD HTTP/HTTPS consecutivos para medir a latência de borda, a variação do tempo de ida e volta e a consistência dos pacotes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет последовательные HEAD-зонды HTTP/HTTPS для измерения задержки Edge, джиттера времени приема-передачи и согласованности пакетов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送连续的 HTTP/HTTPS HEAD 探测以测量边缘延迟、往返时间抖动和数据包一致性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送連續的 HTTP/HTTPS HEAD 探測以測量邊緣延遲、往返時間抖動和封包一致性。"
          }
        }
      }
    },
