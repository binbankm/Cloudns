          "stringUnit": {
            "state": "translated",
            "value": "قم بتسمية قائمة الانتظار باستخدام أحرف وأرقام وشرطات (مثل auth-events-queue)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
