    "Enforcing HSTS tells browsers to never load your site over plain HTTP.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن فرض HSTS يخبر المتصفحات بعدم تحميل موقعك مطلقًا عبر HTTP العادي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erzwingen von HSTS weist Browser an, Ihre Website niemals über einfaches HTTP zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enforcing HSTS tells browsers to never load your site over plain HTTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imponer HSTS indica a los navegadores que nunca carguen tu sitio a través de HTTP simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application de HSTS indique aux navigateurs de ne jamais charger votre site via un simple HTTP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'applicazione di HSTS indica ai browser di non caricare mai il sito tramite semplice HTTP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HSTS を強制すると、ブラウザは通常の HTTP 経由でサイトを読み込まなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HSTS를 강제 적용하면 브라우저가 일반 HTTP를 통해 사이트를 로드하지 않도록 지시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor HSTS instrui os navegadores a nunca carregarem seu site por HTTP simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительное использование HSTS указывает браузерам никогда не загружать ваш сайт через обычный HTTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制执行 HSTS 可指示浏览器切勿通过纯 HTTP 加载您的网站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制執行 HSTS 可指示瀏覽器切勿透過純 HTTP 載入您的網站。"
          }
        }
      }
    },
