          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudflareがキャッシュするWebサイトの静的コンテンツの量を決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare가 캐시할 웹사이트의 정적 콘텐츠의 양을 결정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine quanto do conteúdo estático do seu site você deseja que a Cloudflare armazene em cache."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите, какую часть статического контента вашего веб-сайта вы хотите кэшировать Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定您希望 Cloudflare 缓存多少网站的静态内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認您希望 Cloudflare 快取多少網站的静態内容。"
          }
        }
      }
    },
    "Determine the length of time Cloudflare instructs a visitor's browser to cache files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد طول الفترة الزمنية التي يوجه فيها Cloudflare متصفح الزائر إلى ذاكرة التخزين المؤقت للملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmen Sie, wie lange Cloudflare den Browser eines Besuchers anweist, Dateien zwischenzuspeichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine the length of time Cloudflare instructs a visitor's browser to cache files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine el período de tiempo que Cloudflare le indica al navegador de un visitante que almacene en caché los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déterminez la durée pendant laquelle Cloudflare demande au navigateur d'un visiteur de mettre les fichiers en cache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina il periodo di tempo in cui Cloudflare richiede al browser di un visitatore di memorizzare nella cache i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflareが訪問者のブラウザにファイルをキャッシュするよう指示する時間を決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare가 방문자의 브라우저에 파일을 캐시하도록 지시하는 시간을 결정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Determine por quanto tempo a Cloudflare instrui o navegador do visitante a armazenar arquivos em cache."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите продолжительность времени, в течение которого Cloudflare дает браузеру посетителя указание кэшировать файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定 Cloudflare 指示访客浏览器缓存文件的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認 Cloudflare 指示访客浏覽器快取文件的時长。"
          }
        }
      }
    },
