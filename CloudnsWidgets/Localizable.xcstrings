            "value": "Los proyectos de Pages implementan sitios web frontend de Jamstack en el borde de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets Pages déploient des sites Web frontend Jamstack sur Cloudflare Edge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti Pages distribuiscono siti Web frontend Jamstack sul perimetro Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages プロジェクトは、Jamstack フロントエンド Web サイトを Cloudflare エッジにデプロイします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages 프로젝트는 Cloudflare 에지에 Jamstack 프런트엔드 웹사이트를 배포합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos do Pages implantam sites de front-end Jamstack na borda da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты Pages развертывают веб-сайты внешнего интерфейса Jamstack на границе Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Pages 用于在全球边缘网络上部署极速的前端 Jamstack 静态站点与应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Pages 用于在全球邊緣網路上部署極速的前端 Jamstack 静態站點与應用。"
          }
        }
      }
