    "Full or Full (Strict) is recommended if your origin server has an active SSL certificate.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوصى بـ Full أو Full (Strict) إذا كان خادمك الأصلي يحتوي على شهادة SSL نشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig oder Vollständig (Streng) wird empfohlen, wenn Ihr Ursprungsserver über ein aktives SSL-Zertifikat verfügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full or Full (Strict) is recommended if your origin server has an active SSL certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda Completo o Completo (estricto) si tu servidor de origen tiene un certificado SSL activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complet ou Complet (strict) est recommandé si votre serveur d'origine possède un certificat SSL actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completo o Completo (rigoroso) è consigliato se il server di origine ha un certificato SSL attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジン サーバーにアクティブな SSL 証明書がある場合は、フルまたはフル (厳密) をお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 서버에 활성 SSL 인증서가 있는 경우 전체 또는 전체(엄격)를 권장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Completo ou Completo (Estrito) é recomendado se seu servidor de origem tiver um certificado SSL ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется режим 'Полный' или 'Полный (строгий)', если ваш исходный сервер имеет активный SSL-сертификат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的源服务器具有有效的 SSL 证书，建议使用完全 (Full) 或完全严格 (Full Strict) 模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的來源伺服器具有有效的 SSL 憑證，建議使用完全 (Full) 或完全嚴格 (Full Strict) 模式。"
          }
        }
      }
    },
