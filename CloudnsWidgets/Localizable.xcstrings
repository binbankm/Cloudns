    "Rewrite URL paths, query strings, or modify HTTP headers dynamically at the edge.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة كتابة مسارات URL أو سلاسل الاستعلام أو تعديل ترويسات HTTP ديناميكيًا على الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-Pfade, Abfragezeichenfolgen umschreiben oder HTTP-Header dynamisch am Edge ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewrite URL paths, query strings, or modify HTTP headers dynamically at the edge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescribe rutas de URL, cadenas de consulta o modifica encabezados HTTP dinámicamente en el perímetro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réécrivez les chemins d'URL, les chaînes de requête ou modifiez les en-têtes HTTP de manière dynamique en périphérie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrivi i percorsi URL, le stringhe di query o modifica le intestazioni HTTP in modo dinamico sulla rete perimetrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジで URL パスやクエリ文字列を書き換えたり、HTTP ヘッダーを動的に変更したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에지에서 동적으로 URL 경로, 쿼리 문자열을 재작성하거나 HTTP 헤더를 수정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescreva caminhos de URL, strings de consulta ou modifique cabeçalhos HTTP dinamicamente na borda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезаписывайте пути URL, строки запросов или динамически изменяйте заголовки HTTP на Edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边缘动态重写 URL 路径、查询字符串或修改 HTTP 标头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在邊緣動態重寫 URL 路徑、查詢字串或修改 HTTP 標頭。"
          }
        }
      }
    },
