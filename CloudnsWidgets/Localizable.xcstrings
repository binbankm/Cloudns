    "Prioritize website content by deferring JavaScript loading.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعطاء الأولوية لمحتوى الموقع عن طريق تأجيل تحميل JavaScript."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisieren Sie Website-Inhalte, indem Sie das Laden von JavaScript verzögern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize website content by deferring JavaScript loading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza el contenido del sitio web aplazando la carga de JavaScript."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez la priorité au contenu du site Web en différant le chargement de JavaScript."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai la priorità al contenuto del sito web posticipando il caricamento di JavaScript."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript の読み込みを遅延させて、Web サイトのコンテンツを優先します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JavaScript 로드를 지연시켜 웹사이트 콘텐츠의 우선순위를 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorize o conteúdo do site adiando o carregamento do JavaScript."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритезируйте контент веб-сайта, откладывая загрузку JavaScript."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过延迟 JavaScript 加载来优先呈现网站主要内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過延遲 JavaScript 載入來優先呈現網站主要內容。"
          }
        }
      }
    },
