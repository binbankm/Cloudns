          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espressione wirefilter di Cloudflare che definisce il traffico in entrata corrispondente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
