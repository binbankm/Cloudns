          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade estos detalles del registro DS a la configuración de tu registrador de dominio para completar la verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ces détails d'enregistrement DS aux paramètres de votre bureau d'enregistrement de domaine pour terminer la vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi questi dettagli del record DS alle impostazioni del tuo registrar di domini per completare la verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証を完了するには、ドメイン レジストラの構成にこれらの DS レコードの詳細を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증을 완료하려면 도메인 등록 기관 설정에 이 DS 레코드 세부 정보를 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione estes detalhes do registro DS às configurações do seu registrador de domínio para concluir a verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте эти сведения о записи DS в настройки вашего регистратора домена для завершения проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些 DS 记录详细信息添加到您的域名注册商设置以完成验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些 DS 記錄詳細資訊新增至您的網域稱註冊商設定以完成驗證。"
          }
        }
      }
