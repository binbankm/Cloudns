    "Stream is paused. Tap Resume to start listening for live edge execution events.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البث متوقف مؤقتًا. اضغط على استئناف لبدء الاستماع إلى أحداث تنفيذ الحافة المباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream ist pausiert. Tippen Sie auf Fortsetzen, um Live-Edge-Ausführungsereignisse zu empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream is paused. Tap Resume to start listening for live edge execution events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión está en pausa. Toca Reanudar para comenzar a escuchar eventos de ejecución perimetral en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux est en pause. Appuyez sur Reprendre pour commencer à écouter les événements d'exécution en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stream è in pausa. Tocca Riprendi per iniziare ad ascoltare gli eventi di esecuzione live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームは一時停止中です。[再開] をタップして、ライブ エッジ実行イベントのリッスンを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림이 일시 중지되었습니다. 라이브 에지 실행 이벤트를 수신하려면 재개를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O stream está pausado. Toque em Retomar para começar a ouvir eventos de execução de borda ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поток приостановлен. Нажмите «Возобновить», чтобы начать прослушивание событий выполнения на Edge в реальном времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流已暂停。点击“继续”开始监听实时边缘执行事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流已暫停。點擊「繼續」開始監聽即時邊緣執行事件。"
          }
        }
      }
    },
