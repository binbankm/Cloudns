    "Adjust the sensitivity threshold for presenting challenge pages to suspicious visitors.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط حد الحساسية لتقديم صفحات التحدي للزوار المشبوهين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie den Empfindlichkeitsschwellenwert für die Anzeige von Challenge-Pages für verdächtige Besucher an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the sensitivity threshold for presenting challenge pages to suspicious visitors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el umbral de sensibilidad para mostrar páginas de desafío a visitantes sospechosos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le seuil de sensibilité pour présenter des pages de défi aux visiteurs suspects."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la soglia di sensibilità per presentare pagine di verifica ai visitatori sospetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "疑わしい訪問者にチャレンジ ページを表示する感度しきい値を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의심스러운 방문자에게 챌린지 페이지를 표시하는 민감도 임계값을 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o limite de sensibilidade para apresentar páginas de desafio a visitantes suspeitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте порог чувствительности для показа страниц проверки подозрительным посетителям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整向可疑访问者显示质询页面的敏感度阈值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整向可疑訪客顯示驗證頁面的敏感度閾值。"
          }
        }
      }
    },
    "Adjust your website's security level to determine who will receive a challenge page.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مستوى أمان موقع الويب الخاص بك لتحديد من سيتلقى صفحة التحدي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Sicherheitsstufe Ihrer Website an, um zu bestimmen, wer eine Challenge-Seite erhält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your website's security level to determine who will receive a challenge page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste el nivel de seguridad de su sitio web para determinar quién recibirá una página de desafío."
