    "Supercharge %@ with CDN caching and web optimization technologies.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شحن فائق %@ مع التخزين المؤقت لـ CDN وتقنيات تحسين الويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie %@ mit CDN-Caching- und Weboptimierungstechnologien auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supercharge %@ with CDN caching and web optimization technologies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Potencia %@ con tecnologías de optimización web y almacenamiento en caché de CDN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boostez %@ avec les technologies de mise en cache CDN et d'optimisation Web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenzia %@ con le tecnologie di caching CDN e ottimizzazione web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CDN キャッシュと Web 最適化テクノロジで %@ を強化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CDN 캐싱 및 웹 최적화 기술로 %@을(를) 강화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbine %@ com cache CDN e tecnologias de otimização da web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличьте %@ с помощью технологий кэширования CDN и веб-оптимизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 CDN 缓存和网络优化技术为 %@ 提速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過 CDN 快取和網路优化技术為 %@ 提速。"
          }
        }
      }
    },
    "Supercharge site performance, CDN caching, and edge asset delivery.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعزيز أداء الموقع، والتخزين المؤقت لـ CDN، وتسليم أصول الحافة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimieren Sie Website-Performance, CDN-Caching und Edge-Asset-Bereitstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supercharge site performance, CDN caching, and edge asset delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora el rendimiento del sitio, el almacenamiento en caché de CDN y la entrega de recursos perimetrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boostez les performances du site, la mise en cache CDN et la diffusion des ressources en périphérie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimizza le prestazioni del sito, la memorizzazione nella cache della CDN e la distribuzione delle risorse perimetrali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトのパフォーマンス、CDN キャッシュ、エッジ アセット配信を大幅に強化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트 성능, CDN 캐싱 및 에지 자산 전송을 대폭 향상합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbine o desempenho do site, cache da CDN e entrega de ativos de borda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорьте производительность сайта, кэширование CDN и доставку ресурсов на Edge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大幅提升网站性能、CDN 缓存和边缘资源交付速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大幅提升網站效能、CDN 快取和邊緣資產交付速度。"
          }
        }
      }
    },
