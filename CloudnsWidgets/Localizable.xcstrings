    "Paste the contents of your certificate file (.pem or .crt), including the BEGIN CERTIFICATE and END CERTIFICATE tags.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق محتويات ملف الشهادة (.pem أو .crt)، بما في ذلك علامتي BEGIN CERTIFICATE وEND CERTIFICATE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Inhalt Ihrer Zertifikatsdatei (.pem oder .crt) ein, einschließlich der Tags BEGIN CERTIFICATE und END CERTIFICATE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the contents of your certificate file (.pem or .crt), including the BEGIN CERTIFICATE and END CERTIFICATE tags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue el contenido de su archivo de certificado (.pem o .crt), incluidas las etiquetas BEGIN CERTIFICATE y END CERTIFICATE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le contenu de votre fichier de certificat (.pem ou .crt), y compris les balises BEGIN CERTIFICATE et END CERTIFICATE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il contenuto del file del certificato (.pem o .crt), inclusi i tag BEGIN CERTIFICATE e END CERTIFICATE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN CERTIFICATE タグと END CERTIFICATE タグを含む、証明書ファイル (.pem または .crt) の内容を貼り付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BEGIN CERTIFICATE 및 END CERTIFICATE 태그를 포함하여 인증서 파일(.pem 또는 .crt)의 내용을 붙여넣습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o conteúdo do seu arquivo de certificado (.pem ou .crt), incluindo as tags BEGIN CERTIFICATE e END CERTIFICATE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте содержимое файла сертификата (.pem или .crt), включая теги BEGIN CERTIFICATE и END CERTIFICATE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴证书文件 (.pem 或 .crt) 的内容，包括 BEGIN CERTIFICATE 和 END CERTIFICATE 标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴憑證文件 (.pem 或 .crt) 的内容，包括 BEGIN CERTIFICATE 和 END CERTIFICATE 標签。"
          }
        }
      }
    },
