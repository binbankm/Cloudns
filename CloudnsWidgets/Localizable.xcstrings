    "Rotating the secret key will generate a new secret key for backend token verification. Existing backend deployments using the old secret key might be affected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي تدوير المفتاح السري إلى إنشاء مفتاح سري جديد للتحقق من الرمز المميز للواجهة الخلفية. قد تتأثر عمليات النشر الخلفية الحالية باستخدام المفتاح السري القديم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Drehen des geheimen Schlüssels wird ein neuer geheimer Schlüssel für die Backend-Token-Verifizierung generiert. Vorhandene Backend-Bereitstellungen, die den alten geheimen Schlüssel verwenden, könnten betroffen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotating the secret key will generate a new secret key for backend token verification. Existing backend deployments using the old secret key might be affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al rotar la clave secreta se generará una nueva clave secreta para la verificación del token de backend. Las implementaciones de backend existentes que utilizan la clave secreta anterior podrían verse afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotation de la clé secrète générera une nouvelle clé secrète pour la vérification du jeton backend. Les déploiements back-end existants utilisant l'ancienne clé secrète peuvent être affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rotazione della chiave segreta genererà una nuova chiave segreta per la verifica del token backend. Le distribuzioni backend esistenti che utilizzano la vecchia chiave segreta potrebbero essere interessate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密キーをローテーションすると、バックエンド トークン検証用の新しい秘密キーが生成されます。古い秘密キーを使用している既存のバックエンド展開は影響を受ける可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 키를 순환하면 백엔드 토큰 확인을 위한 새로운 비밀 키가 생성됩니다. 이전 비밀 키를 사용하는 기존 백엔드 배포가 영향을 받을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rotação da chave secreta gerará uma nova chave secreta para verificação do token de back-end. As implantações de back-end existentes que usam a chave secreta antiga podem ser afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При ротации секретного ключа будет создан новый секретный ключ для проверки внутреннего токена. Это может повлиять на существующие серверные развертывания, использующие старый секретный ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换密钥将生成用于后端令牌校验的新密钥。使用旧密钥的现有后端部署可能会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轮换密钥将生成用于後端令牌校驗的新密钥。使用旧密钥的現有後端部署可能會受到影响。"
          }
        }
      }
    },
