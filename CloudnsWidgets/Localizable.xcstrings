    "Enter a domain or subdomain owned by your account (e.g. api.example.com).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل نطاقًا أو نطاقًا فرعيًا مملوكًا لحسابك (على سبيل المثال، api.example.com)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Domain oder Subdomain ein, die Ihrem Konto gehört (z. B. api.example.com)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a domain or subdomain owned by your account (e.g. api.example.com)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese un dominio o subdominio propiedad de su cuenta (por ejemplo, api.example.com)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un domaine ou un sous-domaine appartenant à votre compte (par exemple, api.example.com)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un dominio o sottodominio di proprietà del tuo account (ad esempio api.example.com)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが所有するドメインまたはサブドメインを入力します (例: api.example.com)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 계정이 소유한 도메인 또는 하위 도메인을 입력하세요(예: api.example.com)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
