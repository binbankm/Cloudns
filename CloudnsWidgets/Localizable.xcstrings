    "AI Gateway provides observability, caching, rate limiting, and fallback for OpenAI, Anthropic, Workers AI, and more.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر بوابة الذكاء الاصطناعي إمكانية المراقبة والتخزين المؤقت وتحديد المعدل والرجوع لـ OpenAI وAnthropic وWorkers AI والمزيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway bietet Beobachtbarkeit, Caching, Ratenbegrenzung und Fallback für OpenAI, Anthropic, Workers AI und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway provides observability, caching, rate limiting, and fallback for OpenAI, Anthropic, Workers AI, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway proporciona observabilidad, almacenamiento en caché, limitación de velocidad y respaldo para OpenAI, Anthropic, Workers AI y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway offre l'observabilité, la mise en cache, la limitation du débit et le repli pour OpenAI, Anthropic, Workers AI, et bien plus encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway fornisce osservabilità, memorizzazione nella cache, limitazione della velocità e fallback per OpenAI, Anthropic, Workers AI e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway は、OpenAI、Anthropic、Workers AI などの可観測性、キャッシュ、レート制限、フォールバックを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway는 OpenAI, Anthropic, Workers AI 등에 대한 관찰 가능성, 캐싱, 속도 제한 및 대체 기능을 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AI Gateway fornece observabilidade, armazenamento em cache, limitação de taxa e substituto para OpenAI, Anthropic, Workers AI e muito mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway обеспечивает наблюдение, кэширование, ограничение скорости и резервный вариант для OpenAI, Anthropic, Workers AI и т. д."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway 为 OpenAI、Anthropic、Workers AI 等大模型 API 提供全球链路观测、响应缓存与限流保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Gateway 為 OpenAI、Anthropic、Workers AI 等大模型 API 提供全球链路观測、响應快取与限流保護。"
          }
        }
      }
    },
