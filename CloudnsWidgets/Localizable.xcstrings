    "Temporarily bypass cache to test origin changes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز التخزين المؤقت مؤقتًا لاختبار تغييرات الأصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache vorübergehend umgehen, um Ursprungsänderungen zu testen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily bypass cache to test origin changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite temporalmente la caché para probar cambios de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contournez temporairement le cache pour tester les modifications de l'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypassa temporaneamente la cache per testare le modifiche all'origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジンの変更をテストするためにキャッシュを一時的にバイパスします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 변경 사항을 테스트하기 위해 캐시를 일시적으로 우회합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore temporariamente o cache para testar as alterações de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно обойдите кэш для проверки изменений на источнике."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时绕过缓存以测试源站更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時略過快取以測試來源變更。"
          }
        }
      }
    },
    "Temporarily bypass our cache. Allows you to see changes to your origin server in realtime.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز ذاكرة التخزين المؤقت لدينا. يسمح لك برؤية التغييرات على خادمك الأصلي في الوقت الفعلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgehen Sie vorübergehend unseren Cache. Ermöglicht Ihnen, Änderungen an Ihrem Ursprungsserver in Echtzeit zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily bypass our cache. Allows you to see changes to your origin server in realtime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omita temporalmente nuestro caché. Le permite ver los cambios en su servidor de origen en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contourner temporairement notre cache. Vous permet de voir les modifications apportées à votre serveur d'origine en temps réel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignora temporaneamente la nostra cache. Ti consente di vedere le modifiche al tuo server di origine in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的にキャッシュをバイパスします。オリジンサーバーへの変更をリアルタイムで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 캐시를 우회합니다. 원본 서버의 변경 사항을 실시간으로 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore temporariamente nosso cache. Permite que você veja as alterações no seu servidor de origem em tempo real."
          }
        },
        "ru": {
