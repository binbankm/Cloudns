    "Redirect all incoming HTTP requests to HTTPS and prevent mixed content warnings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة توجيه جميع طلبات HTTP الواردة إلى HTTPS ومنع تحذيرات المحتوى المختلط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiten Sie alle eingehenden HTTP-Anfragen auf HTTPS um und verhindern Sie Warnungen vor gemischten Inhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect all incoming HTTP requests to HTTPS and prevent mixed content warnings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirige todas las solicitudes HTTP entrantes a HTTPS y evita advertencias de contenido mixto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirigez toutes les requêtes HTTP entrantes vers HTTPS et évitez les avertissements de contenu mixte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reindirizza tutte le richieste HTTP in arrivo a HTTPS e previeni gli avvisi di contenuto misto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての受信 HTTP リクエストを HTTPS にリダイレクトし、混合コンテンツの警告を防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어오는 모든 HTTP 요청을 HTTPS로 리디렉션하고 혼합 콘텐츠 경고를 방지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirecione todas as solicitações HTTP recebidas para HTTPS e evite avisos de conteúdo misto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенаправляйте все входящие запросы HTTP на HTTPS и предотвращайте предупреждения о смешанном контенте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有传入的 HTTP 请求重定向至 HTTPS 并防止混合内容警告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有傳入的 HTTP 請求重新導向至 HTTPS 並防止混合內容警告。"
          }
        }
      }
    },
    "Redirect all requests with scheme 'http' to 'https'. This applies to all http requests to the zone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة توجيه جميع الطلبات باستخدام المخطط \"http\" إلى \"https\". ينطبق هذا على جميع طلبات http للمنطقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiten Sie alle Anfragen mit dem Schema „http“ auf „https“ um. Dies gilt für alle HTTP-Anfragen an die Zone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect all requests with scheme 'http' to 'https'. This applies to all http requests to the zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirigir todas las solicitudes con el esquema 'http' a 'https'. Esto se aplica a todas las solicitudes http a la zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirigez toutes les requêtes avec le schéma « http » vers « https ». Ceci s'applique à toutes les requêtes http vers la zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reindirizzare tutte le richieste con lo schema 'http' a 'https'. Questo vale per tutte le richieste http alla zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキーム「http」を持つすべてのリクエストを「https」にリダイレクトします。これは、ゾーンへのすべての http リクエストに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'http' 체계를 사용하는 모든 요청을 'https'로 리디렉션합니다. 이는 영역에 대한 모든 http 요청에 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirecione todas as solicitações com esquema 'http' para 'https'. Isso se aplica a todas as solicitações http para a zona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенаправить все запросы со схемой «http» на «https». Это относится ко всем http-запросам к зоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有 'http' 请求重定向到 'https'。这适用于对该区域的所有 HTTP 请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有 'http' 請求重定向到 'https'。这适用于对该区域的所有 HTTP 請求。"
          }
        }
      }
    },
