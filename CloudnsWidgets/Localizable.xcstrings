    "Pause Cloudflare on Site. This will route traffic directly to your origin server, bypassing Cloudflare's security and caching.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإيقاف Cloudflare مؤقتًا على الموقع. سيؤدي هذا إلى توجيه حركة المرور مباشرة إلى الخادم الأصلي الخاص بك، متجاوزًا أمان Cloudflare والتخزين المؤقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare vor Ort pausieren. Dadurch wird der Datenverkehr direkt an Ihren Ursprungsserver weitergeleitet und die Sicherheit und das Caching von Cloudflare umgangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause Cloudflare on Site. This will route traffic directly to your origin server, bypassing Cloudflare's security and caching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar Cloudflare en el sitio. Esto enrutará el tráfico directamente a su servidor de origen, evitando la seguridad y el almacenamiento en caché de Cloudflare."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendez Cloudflare sur site. Cela acheminera le trafic directement vers votre serveur d'origine, en contournant la sécurité et la mise en cache de Cloudflare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa Cloudflare sul sito. Ciò indirizzerà il traffico direttamente al tuo server di origine, ignorando la sicurezza e la memorizzazione nella cache di Cloudflare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトでCloudflareを一時停止します。これにより、Cloudflareのセキュリティとキャッシュがバイパスされ、トラフィックがオリジンサーバーに直接ルーティングされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트에서 Cloudflare를 일시 중지하세요. 이렇게 하면 Cloudflare의 보안 및 캐싱을 우회하여 트래픽을 원본 서버로 직접 라우팅합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause o Cloudflare no site. Isso encaminhará o tráfego diretamente para o seu servidor de origem, ignorando a segurança e o cache da Cloudflare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановите Cloudflare на сайте. При этом трафик будет направляться непосредственно на ваш исходный сервер, минуя безопасность и кэширование Cloudflare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停站点上的 Cloudflare，流量将直接路由至源服务器，绕过 Cloudflare 的安全防护和缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停站點上的 Cloudflare，流量将直接路由至源服务器，绕過 Cloudflare 的安全性防護和快取。"
          }
        }
      }
    },
