    "Speed Brain uses predictive prefetching to load web pages before users click.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Speed Brain الجلب المسبق التنبؤي لتحميل صفحات الويب قبل أن ينقر المستخدمون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain nutzt vorausschauendes Prefetching, um Webseiten zu laden, bevor Nutzer klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain uses predictive prefetching to load web pages before users click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain utiliza la precarga predictiva para cargar páginas web antes de que los usuarios hagan clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain utilise le préchargement prédictif pour charger les pages Web avant que les utilisateurs ne cliquent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain utilizza il pre-fetching predittivo per caricare le pagine web prima che gli utenti facciano clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain は予測プリフェッチを使用して、ユーザーがクリックする前に Web ページを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain은 예측 프리페치를 사용하여 사용자가 클릭하기 전에 웹 페이지를 로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Speed Brain usa pré-busca preditiva para carregar páginas da web antes que os usuários cliquem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain использует предиктивную предварительную выборку для загрузки веб-страниц до того, как пользователи нажмут на них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain 使用预测性预取在用户点击之前预先加载网页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed Brain 使用預測性預先擷取在使用者點擊之前預先載入網頁。"
          }
        }
      }
    },
