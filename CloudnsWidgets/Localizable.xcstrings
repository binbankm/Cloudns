    "Environment variables are plaintext strings accessible via global env bindings in your script.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متغيرات البيئة عبارة عن سلاسل نصية عادية يمكن الوصول إليها عبر روابط البيئة العامة في البرنامج النصي الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungsvariablen sind Klartextzeichenfolgen, auf die über globale Env-Bindungen in Ihrem Skript zugegriffen werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment variables are plaintext strings accessible via global env bindings in your script."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de entorno son cadenas de texto sin formato a las que se puede acceder a través de enlaces env globales en su script."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables d'environnement sont des chaînes de texte en clair accessibles via les liaisons d'environnement globales dans votre script."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili di ambiente sono stringhe di testo in chiaro accessibili tramite collegamenti env globali nello script."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境変数は、スクリプト内のグローバル環境バインディングを介してアクセスできるプレーンテキスト文字列です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 변수는 스크립트의 전역 환경 바인딩을 통해 액세스할 수 있는 일반 텍스트 문자열입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variáveis ​​de ambiente são strings de texto simples acessíveis por meio de ligações ambientais globais em seu script."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные среды — это строки открытого текста, доступные через глобальные привязки env в вашем скрипте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境变量是明文字符串，可在脚本中通过全局 env 绑定直接访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "环境變量是明文字符串，可在脚本中通過全局 env 绑定直接访问。"
          }
        }
      }
    },
