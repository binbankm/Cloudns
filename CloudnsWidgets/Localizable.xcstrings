            "value": "Supervise Workers, compilaciones de páginas y bases de datos KV/D1 con métricas de ejecución en vivo y seguimiento de latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez les Workers, les builds Pages et les bases de données KV/D1 avec des mesures d'exécution en direct et un suivi de latence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
