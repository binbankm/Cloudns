    "Rules determine which HTTP requests execute specific snippets based on expression filters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد القواعد طلبات HTTP التي تنفذ مقتطفات محددة بناءً على عوامل تصفية التعبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln bestimmen anhand von Ausdrucksfiltern, welche HTTP-Anfragen bestimmte Snippets ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules determine which HTTP requests execute specific snippets based on expression filters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas determinan qué solicitudes HTTP ejecutan fragmentos específicos según los filtros de expresión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles déterminent quelles requêtes HTTP exécutent des extraits spécifiques en fonction de filtres d'expression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole determinano quali richieste HTTP eseguono snippet specifici in base ai filtri di espressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは、式フィルターに基づいて特定のスニペットを実行する HTTP リクエストを決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 표현식 필터를 기반으로 특정 조각을 실행하는 HTTP 요청을 결정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras determinam quais solicitações HTTP executam trechos específicos com base em filtros de expressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила определяют, какие HTTP-запросы выполняют определенные фрагменты на основе фильтров выражений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则根据表达式过滤器决定哪些 HTTP 请求执行特定 Snippet。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則根据表达式過滤器决定哪些 HTTP 請求执行特定 Snippet。"
          }
        }
      }
    },
