    "Cloudflare Bot Fight Mode matches IP reputation and behavioral analysis to block automated attack bots.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطابق وضع Cloudflare Bot Fight Mode سمعة IP والتحليل السلوكي لحظر روبوتات الهجوم التلقائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode gleicht IP-Reputation und Verhaltensanalysen ab, um automatisierte Angriffs-Bots zu blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode matches IP reputation and behavioral analysis to block automated attack bots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode combina la reputación de IP y el análisis de comportamiento para bloquear bots de ataque automatizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Bot Fight de Cloudflare associe la réputation IP et l'analyse comportementale pour bloquer les robots d'attaque automatisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode combina la reputazione IP e l'analisi del comportamento per bloccare i bot di attacco automatizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode は、IP レピュテーションと行動分析を組み合わせて自動攻撃ボットをブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode는 IP 평판 및 행동 분석을 결합하여 자동화된 공격 봇을 차단합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cloudflare Bot Fight Mode combina reputação de IP e análise comportamental para bloquear bots de ataque automatizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим борьбы с ботами Cloudflare сопоставляет репутацию IP и поведенческий анализ для блокировки автоматических ботов-атакующих."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode 结合 IP 信誉和行为分析来拦截自动化攻击机器人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Bot Fight Mode 結合 IP 信譽和行為分析來攔截自動化攻擊機器人。"
          }
        }
      }
    },
