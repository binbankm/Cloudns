    "Name can contain lowercase letters, numbers, and dashes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يحتوي الاسم على أحرف صغيرة وأرقام وشرطات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name kann Kleinbuchstaben, Zahlen und Bindestriche enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name can contain lowercase letters, numbers, and dashes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre puede contener letras minúsculas, números y guiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom peut contenir des lettres minuscules, des chiffres et des tirets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome può contenere lettere minuscole, numeri e trattini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前には、小文字、数字、ダッシュを含めることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에는 소문자, 숫자, 대시가 포함될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome pode conter letras minúsculas, números e travessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя может содержать строчные буквы, цифры и тире."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称仅允许包含小写英文字母、数字和连字符（-）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名称仅允許包含小写英文字母、數字和连字符（-）。"
          }
        }
      }
    },
