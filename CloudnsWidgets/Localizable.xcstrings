    "Purging everything forces Cloudflare to re-fetch all assets from origin, which may increase server load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن مسح كل شيء يجبر Cloudflare على إعادة جلب جميع الأصول من الأصل، مما قد يزيد من حمل الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen aller Inhalte zwingt Cloudflare dazu, alle Assets vom Ursprung neu abzurufen, was die Serverlast erhöhen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purging everything forces Cloudflare to re-fetch all assets from origin, which may increase server load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgar todo obliga a Cloudflare a volver a obtener todos los recursos del origen, lo que puede aumentar la carga del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout purger oblige Cloudflare à récupérer à nouveau toutes les ressources depuis l'origine, ce qui peut augmenter la charge du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo svuotamento totale costringe Cloudflare a recuperare nuovamente tutte le risorse dall'origine, aumentando il carico del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてをパージすると、Cloudflare はオリジンからすべてのアセットを再取得する必要があるため、サーバーの負荷が増加する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 삭제하면 Cloudflare가 원본에서 모든 자산을 다시 가져와야 하므로 서버 부하가 증가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar tudo força a Cloudflare a buscar novamente todos os ativos da origem, o que pode aumentar a carga do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная очистка заставляет Cloudflare повторно запрашивать все ресурсы с источника, что может увеличить нагрузку на сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除全部缓存将强制 Cloudflare 重新从源站获取所有资源，这可能会增加服务器负载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除全部快取將強制 Cloudflare 重新從來源獲取所有資源，這可能會增加伺服器負載。"
          }
        }
      }
    },
