          "stringUnit": {
            "state": "translated",
            "value": "يرجى التحقق من تحديثات التطبيق لدعم أحدث مخطط Cloudflare API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte suchen Sie nach App-Updates, um das neueste Cloudflare-API-Schema zu unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check for app updates to support the latest Cloudflare API schema."
          }
        },
